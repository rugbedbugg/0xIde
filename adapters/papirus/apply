#!/usr/bin/env bash
# Caelestia maps the scheme's primary colour to a Papirus folder colour from its
# GTK step, which the gtk adapter turns off, so the call is made from here. It
# needs root and fails silently without it. The colour is not re-derived: this
# reuses Caelestia's own mapping.
set -euo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../../orchestration/lib/common.sh"

ox_have papirus-folders || exit 0
[ -r "$OX_SCHEME" ] || exit 0

primary="$(jq -r '.colours.primary // empty' "$OX_SCHEME")"
[ -n "$primary" ] || exit 0

"$(ox_python)" - "$primary" <<'PY'
import sys
from caelestia.utils.theme import sync_papirus_colors

sync_papirus_colors(sys.argv[1])
PY
