#!/usr/bin/env bash
# Whether Papirus folder colours follow the scheme, and if not, why: from what
# is installed, and from what the last theme change actually did.
set -uo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../../orchestration/lib/common.sh"

# Overridable only for the tests: the sudo rule names the fixed path alone.
HELPER="${OX_PAPIRUS_HELPER:-/usr/local/libexec/0xide-papirus-folders}"
RESULT="$OX_STATE/papirus.result"

if ! grep -qx papirus "$OX_CONFIG/adapters.enabled" 2>/dev/null; then
    echo "papirus: not enabled"
    exit 0
fi
ox_have papirus-folders || { echo "papirus: enabled, but papirus-folders is not installed"; exit 1; }
[ -d /usr/share/icons/Papirus ] || { echo "papirus: enabled, but the Papirus icon theme is not installed"; exit 1; }
if ox_has_sudo_rule 'papirus-folders -C'; then
    echo "papirus: warning: an older, wider sudo rule for papirus-folders itself is still installed"
    echo "         ./install --enable sudoers replaces it with the fixed helper"
fi
# The helper is opt-in (it needs root), so without it the adapter is inactive,
# not broken: said plainly, but not counted as a fault. An older, wider rule
# still in place is a fault, and so is a theme change that failed.
old_rule=0
ox_has_sudo_rule 'papirus-folders -C' && old_rule=1
if [ ! -x "$HELPER" ] || ! ox_has_sudo_rule "$HELPER"; then
    echo "papirus: inactive: folder colours do NOT track the scheme until the 0xIde"
    echo "         papirus helper is installed, with: ./install --enable sudoers"
    exit "$old_rule"
fi
if [ ! -s "$RESULT" ]; then
    echo "papirus: ready; folders are recoloured on the next theme change"
    exit 0
fi
IFS=$'\t' read -r state words < "$RESULT"
case "$state" in
    applied) echo "papirus: ok, $words" ;;
    *)       echo "papirus: last theme change: $words"; exit 1 ;;
esac
