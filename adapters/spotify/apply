#!/usr/bin/env bash
# Caelestia regenerates the spicetify colour file on every theme change but
# never re-applies it, so Spotify keeps rendering the previous palette until
# something runs `spicetify apply`. That is all this does.
set -euo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../../orchestration/lib/common.sh"

cm_have spicetify || exit 0
grep -qE '^current_theme[[:space:]]*=[[:space:]]*caelestia' \
    "$XDG_CONFIG_HOME/spicetify/config-xpui.ini" 2>/dev/null || exit 0

# `spicetify apply` restarts Spotify, which starts it if it was closed. This
# adapter exists to re-theme a Spotify you are already using, not to open one
# behind your back on every wallpaper change, so it does nothing unless one is
# running. Without pgrep there is no way to tell, and not applying is the
# safer half of that guess.
cm_have pgrep || exit 0

# Check for live (non-zombie) Spotify processes.
# pgrep matches zombies; filter via ps state.
spotify_running() {
    local pids
    # Collect PIDs from both detectors independently; combine and deduplicate.
    local pids1 pids2
    pids1=$(pgrep -x spotify 2>/dev/null)
    pids2=$(pgrep -f 'com\.spotify\.Client' 2>/dev/null)
    # Combine and deduplicate PIDs
    local pids
    pids=$(printf '%s\n%s\n' "$pids1" "$pids2" | sort -u | sed '/^$/d')
    [ -n "$pids" ] || return 1
    # Check each PID individually; any non-Z state means a live process exists.
    local pid
    for pid in $pids; do
        local stat
        stat=$(ps -o stat= -p "$pid" 2>/dev/null) || continue
        case "$stat" in
            Z*) continue ;;  # zombie
            *) return 0 ;;    # live process found
        esac
    done
    return 1
}

spotify_running || exit 0

# A full apply takes ~25s, so it must not block the theme change. flock keeps
# rapid scheme switches from running two applies over the same files.
setsid flock -n "$CM_STATE/spicetify.lock" spicetify apply >/dev/null 2>&1 &
