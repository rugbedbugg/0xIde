#!/usr/bin/env bash
# Caelestia regenerates the spicetify colour file on every theme change but
# never re-applies it, so Spotify keeps rendering the previous palette until
# something runs `spicetify apply`. That is all this does.
set -euo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../../orchestration/lib/common.sh"

cm_have spicetify || exit 0
grep -qE '^current_theme[[:space:]]*=[[:space:]]*caelestia' \
    "$XDG_CONFIG_HOME/spicetify/config-xpui.ini" 2>/dev/null || exit 0

# A full apply takes ~25s, so it must not block the theme change. flock keeps
# rapid scheme switches from running two applies over the same files.
setsid flock -n "$CM_STATE/spicetify.lock" spicetify apply >/dev/null 2>&1 &
