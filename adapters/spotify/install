#!/usr/bin/env bash
# One-time setup: place the Caelestia spicetify theme's layout rules.
# Colours are not installed here; caelestia-cli owns color.ini and rewrites it
# on every theme change.
set -euo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../../orchestration/lib/common.sh"

cm_have spicetify || { cm_log "spicetify is not installed; nothing to do"; exit 0; }
dest="$XDG_CONFIG_HOME/spicetify/Themes/caelestia"
mkdir -p "$dest"
cm_install_file "$dest/user.css" 644 < "$(dirname -- "${BASH_SOURCE[0]}")/user.css" &&
    cm_log "installed user.css" || cm_log "user.css already current"
cm_own "$dest/user.css"
