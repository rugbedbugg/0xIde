#!/usr/bin/env bash
# These themes name ANSI slots, never hex. Any hex colour here would mean the
# theme had stopped tracking Caelestia, so that is what this checks.
set -uo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../../orchestration/lib/common.sh"

ox_have yazi || { echo "yazi: not installed"; exit 1; }
hex=$(grep -rnoE '#[0-9a-fA-F]{6}' "$XDG_CONFIG_HOME/yazi" 2>/dev/null | wc -l)
if [ "$hex" -gt 0 ]; then
    echo "yazi: $hex hardcoded colour(s) found; the theme has stopped following Caelestia"
    exit 1
fi
echo "yazi: ok, palette inherited from the terminal"
