#!/usr/bin/env bash
set -euo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../../orchestration/lib/common.sh"

src="$(dirname -- "${BASH_SOURCE[0]}")/config"
(cd "$src" && find . -type f -print0) | while IFS= read -r -d '' rel; do
    case "$rel" in
        ./y.fish) dest="$XDG_CONFIG_HOME/fish/functions/y.fish" ;;
        *)        dest="$XDG_CONFIG_HOME/yazi/${rel#./}" ;;
    esac
    if cm_install_file "$dest" 644 < "$src/$rel"; then cm_log "installed ${dest#$HOME/}"; fi
    cm_own "$dest"
done
