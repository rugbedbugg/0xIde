#!/usr/bin/python3
"""
Privileged helper for the caelestia SDDM theme.

Installed at: /usr/local/libexec/caelestia-sddm-sync
Owner: root:root
Mode: 0755

Run by system/sddm/sync as `sudo -n` with no arguments. Derives the caller
from sudo's metadata, reads fixed file names from the caller's fixed state
directory, and writes to fixed places inside the theme:

    theme.conf.user                      re-written from what it parses
    backgrounds/caelestia_wallpaper.png  or .jpg, named by its bytes
    faces/<caller>                       the caller's profile picture

The theme.conf.user it installs is never the caller's file: the caller's is
parsed strictly, every key must be one the theme reads and every value must
have that key's shape, and the helper writes its own canonical copy from the
result. So nothing the greeter might read differently can pass through.
"""

import os
import pwd
import re
import stat
import sys
import tempfile
from pathlib import Path

THEME_DIR = Path("/usr/share/sddm/themes/caelestia")
BACKGROUNDS_DIR = THEME_DIR / "backgrounds"
FACES_DIR = THEME_DIR / "faces"
THEME_CONF_USER_DEST = THEME_DIR / "theme.conf.user"

# Fixed input basenames, in the caller's state directory
WALLPAPER_BASENAMES = ("wallpaper.png", "wallpaper.jpg")
AVATAR_BASENAMES = ("avatar.png", "avatar.jpg")
THEME_CONF_USER_BASENAME = "theme.conf.user"

MAX_WALLPAPER_SIZE = 50 * 1024 * 1024
MAX_AVATAR_SIZE = 5 * 1024 * 1024
MAX_THEME_CONF_SIZE = 64 * 1024

# The palette roles the theme reads (theme/components/Colours.qml).
PALETTE_ROLES = frozenset((
    "primary", "onPrimary", "primaryContainer", "onPrimaryContainer",
    "secondary", "onSecondary", "secondaryContainer", "onSecondaryContainer",
    "tertiary", "onTertiary", "tertiaryContainer", "onTertiaryContainer",
    "error", "onError", "errorContainer", "onErrorContainer",
    "surface", "onSurface", "surfaceVariant", "onSurfaceVariant",
    "surfaceContainerLowest", "surfaceContainerLow", "surfaceContainer",
    "surfaceContainerHigh", "surfaceContainerHighest",
    "outline", "outlineVariant", "shadow", "scrim",
    "inverseSurface", "inverseOnSurface", "inversePrimary",
    "term0", "term1", "term2", "term3", "term4", "term5", "term6", "term7",
))

COLOUR = re.compile(r"#[0-9a-fA-F]{6}")
OS_NAME = re.compile(r"[^\"\\\x00-\x1f\x7f]{0,64}")
USER_NAME = re.compile(r"[a-z_][a-z0-9_-]{0,31}")

# Every other key, with the exact values it may take.
FIXED_KEYS = {
    "BgSource": lambda v: v in ("", "backgrounds/caelestia_wallpaper.png", "backgrounds/caelestia_wallpaper.jpg"),
    "mode": lambda v: v in ("dark", "light"),
    "useTwelveHourClock": lambda v: v in ("true", "false"),
    "osName": lambda v: OS_NAME.fullmatch(v) is not None,
}

USAGE = """Caelestia SDDM privileged sync helper
Usage: sudo /usr/local/libexec/caelestia-sddm-sync
Derives the caller from SUDO_USER/SUDO_UID
Reads fixed files from ~/.local/state/caelestia/sddm/
Writes: theme.conf.user, backgrounds/caelestia_wallpaper.{png,jpg}, faces/<caller>"""


def parse_args():
    if len(sys.argv) > 1:
        if sys.argv[1] in ("-h", "--help") and len(sys.argv) == 2:
            print(USAGE)
            sys.exit(0)
        print(f"ERROR: Unexpected argument: {sys.argv[1]}", file=sys.stderr)
        print("Usage: sudo /usr/local/libexec/caelestia-sddm-sync [--help]", file=sys.stderr)
        sys.exit(1)


def get_sudo_user():
    sudo_user = os.environ.get("SUDO_USER")
    sudo_uid_str = os.environ.get("SUDO_UID")
    if not sudo_user or not sudo_uid_str:
        sys.exit("ERROR: Not invoked via sudo (SUDO_USER/SUDO_UID missing)")
    try:
        sudo_uid = int(sudo_uid_str)
    except ValueError:
        sys.exit("ERROR: Invalid SUDO_UID")
    try:
        pw = pwd.getpwnam(sudo_user)
    except KeyError:
        sys.exit(f"ERROR: User {sudo_user} not found")
    if pw.pw_uid != sudo_uid:
        sys.exit("ERROR: SUDO_UID does not match SUDO_USER")
    return pw


def get_state_dir(pw):
    return Path(pw.pw_dir) / ".local/state/caelestia/sddm"


def open_state_dir(state_dir, expected_uid):
    """Open and validate the state directory by fd."""
    try:
        fd = os.open(state_dir, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except FileNotFoundError:
        sys.exit(f"ERROR: State directory {state_dir} does not exist")
    except OSError as e:
        sys.exit(f"ERROR: Cannot open state directory: {e}")
    try:
        st = os.fstat(fd)
    except OSError as e:
        os.close(fd)
        sys.exit(f"ERROR: Cannot fstat state directory: {e}")
    if not stat.S_ISDIR(st.st_mode):
        os.close(fd)
        sys.exit("ERROR: State path is not a directory")
    if st.st_uid != expected_uid:
        os.close(fd)
        sys.exit(f"ERROR: State directory owned by {st.st_uid}, expected {expected_uid}")
    if st.st_mode & 0o022:
        os.close(fd)
        sys.exit("ERROR: State directory is group/world-writable")
    return fd


def read_fixed_file(state_dir_fd, basename, max_size, expected_uid):
    """Open a fixed basename by dir fd, validate the same fd, read to EOF."""
    try:
        fd = os.open(basename, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=state_dir_fd)
    except FileNotFoundError:
        return None
    except OSError as e:
        sys.exit(f"ERROR: Failed to open {basename}: {e}")
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            sys.exit(f"ERROR: {basename} is not a regular file")
        if st.st_uid != expected_uid:
            sys.exit(f"ERROR: {basename} owned by {st.st_uid}, expected {expected_uid}")
        if st.st_size > max_size:
            sys.exit(f"ERROR: {basename} exceeds size limit ({st.st_size} > {max_size})")
        content = bytearray()
        while len(content) <= max_size:
            chunk = os.read(fd, max_size + 1 - len(content))
            if not chunk:
                break
            content.extend(chunk)
    except OSError as e:
        sys.exit(f"ERROR: Failed to read {basename}: {e}")
    finally:
        os.close(fd)
    if len(content) > max_size:
        sys.exit(f"ERROR: {basename} exceeds size limit ({len(content)} > {max_size})")
    return bytes(content)


def image_type(content):
    """'.png' or '.jpg' from the bytes, or None."""
    if len(content) < 8:
        return None
    if content[:3] == b"\xff\xd8\xff":
        return ".jpg"
    if content[:8] == b"\x89PNG\r\n\x1a\n":
        return ".png"
    return None


def parse_theme_conf_user(content):
    """The caller's settings, strictly: [General] then key=value lines.

    Returns a dict of accepted keys, or None when anything is out of shape.
    No continuation lines, no other sections, no repeated or unknown keys, no
    backslashes, and every value must match its key.
    """
    try:
        text = content.decode("utf-8")
    except UnicodeDecodeError:
        return None
    if "\\" in text:
        return None
    settings = {}
    in_general = False
    for line in text.splitlines():
        if not line or line.startswith((";", "#")):
            continue
        if line != line.strip():
            return None
        if line.startswith("["):
            if line != "[General]" or in_general:
                return None
            in_general = True
            continue
        if not in_general or "=" not in line:
            return None
        key, value = line.split("=", 1)
        if len(value) >= 2 and value[0] == value[-1] == '"':
            value = value[1:-1]
        if '"' in value or key in settings:
            return None
        if key in PALETTE_ROLES:
            if not COLOUR.fullmatch(value):
                return None
        elif key not in FIXED_KEYS or not FIXED_KEYS[key](value):
            return None
        settings[key] = value
    if not in_general or "BgSource" not in settings:
        return None
    return settings


def render_theme_conf_user(settings):
    lines = ["[General]"]
    for key in sorted(settings):
        value = settings[key]
        lines.append(f'{key}="{value}"' if value else f"{key}=")
    return ("\n".join(lines) + "\n").encode("utf-8")


def is_root_dir(path):
    """A real directory, owned by root, writable by no one else."""
    try:
        st = os.lstat(path)
    except OSError:
        return False
    return stat.S_ISDIR(st.st_mode) and st.st_uid == 0 and not st.st_mode & 0o022


def validate_destination(dest):
    """Absent, or a regular root-owned file. Anything else is refused."""
    try:
        st = os.lstat(dest)
    except FileNotFoundError:
        return True
    except OSError:
        return False
    return stat.S_ISREG(st.st_mode) and st.st_uid == 0


def install_file_atomic(dest, content):
    """Atomically install content at dest as root:root 0644."""
    if not is_root_dir(dest.parent):
        print(f"ERROR: {dest.parent} is not a root-owned directory", file=sys.stderr)
        return False
    if not validate_destination(dest):
        print(f"ERROR: Destination {dest} validation failed", file=sys.stderr)
        return False
    tmp_path = None
    try:
        fd, tmp_path = tempfile.mkstemp(dir=dest.parent, prefix=f".{dest.name}.tmp.")
        try:
            view = memoryview(content)
            while view:
                view = view[os.write(fd, view):]
            os.fsync(fd)
        finally:
            os.close(fd)
        os.chmod(tmp_path, 0o644)
        os.chown(tmp_path, 0, 0)
        os.rename(tmp_path, dest)
        return True
    except Exception as e:
        print(f"ERROR: Failed to install {dest}: {e}", file=sys.stderr)
        if tmp_path:
            try:
                os.unlink(tmp_path)
            except OSError:
                pass
        return False


def remove_if_ours(dest):
    """Removes a regular root-owned file; leaves anything else alone."""
    if is_root_dir(dest.parent) and validate_destination(dest):
        try:
            os.unlink(dest)
        except FileNotFoundError:
            pass


def install_image(state_dir_fd, basenames, max_size, uid, dest_for, what):
    """Installs the first basename present. Returns (installed dest or None, ok)."""
    for basename in basenames:
        content = read_fixed_file(state_dir_fd, basename, max_size, uid)
        if content is None:
            continue
        ext = image_type(content)
        if ext is None:
            print(f"ERROR: {basename} is not a valid PNG/JPEG", file=sys.stderr)
            return None, False
        dest = dest_for(ext)
        if not install_file_atomic(dest, content):
            return None, False
        print(f"Installed {what}: {dest}")
        return dest, True
    return None, True


def main():
    parse_args()

    pw = get_sudo_user()
    uid = pw.pw_uid
    state_dir_fd = open_state_dir(get_state_dir(pw), uid)

    try:
        success = True

        # The wallpaper, as caelestia_wallpaper.<type>; the other type goes.
        wallpaper, ok = install_image(
            state_dir_fd, WALLPAPER_BASENAMES, MAX_WALLPAPER_SIZE, uid,
            lambda ext: BACKGROUNDS_DIR / f"caelestia_wallpaper{ext}", "wallpaper")
        success &= ok
        if wallpaper:
            for ext in (".png", ".jpg"):
                other = BACKGROUNDS_DIR / f"caelestia_wallpaper{ext}"
                if other != wallpaper:
                    remove_if_ours(other)

        # The profile picture, as faces/<caller>, with no extension: the theme
        # asks for it by user name and Qt reads the type from the bytes.
        if USER_NAME.fullmatch(pw.pw_name):
            face = FACES_DIR / pw.pw_name
            installed, ok = install_image(
                state_dir_fd, AVATAR_BASENAMES, MAX_AVATAR_SIZE, uid,
                lambda ext: face, "profile picture")
            success &= ok
            if ok and installed is None:
                remove_if_ours(face)

        # theme.conf.user, re-written from what parses.
        content = read_fixed_file(state_dir_fd, THEME_CONF_USER_BASENAME, MAX_THEME_CONF_SIZE, uid)
        if content is not None:
            settings = parse_theme_conf_user(content)
            if settings is None:
                print("ERROR: theme.conf.user validation failed", file=sys.stderr)
                success = False
            elif install_file_atomic(THEME_CONF_USER_DEST, render_theme_conf_user(settings)):
                print(f"Installed theme.conf.user: {THEME_CONF_USER_DEST}")
            else:
                success = False

        if not success:
            sys.exit(1)
    finally:
        os.close(state_dir_fd)


if __name__ == "__main__":
    main()
