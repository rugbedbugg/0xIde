#!/usr/bin/env bash
# Reverses system/sddm/install: the theme, the helper, its sudoers rule and
# the SDDM drop-in. With the drop-in gone, SDDM uses whichever theme was set
# before. Prints what it will remove and asks first.
set -euo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../../orchestration/lib/common.sh"

THEME_DIR="/usr/share/sddm/themes/caelestia"
HELPER_DEST="/usr/local/libexec/caelestia-sddm-sync"
SUDOERS_FILE="/etc/sudoers.d/caelestia-sddm"
SDDM_DROPIN="/etc/sddm.conf.d/zz-caelestia.conf"
LEGACY_DIR="/usr/share/sddm/themes/corners"
LEGACY_FILES=("$LEGACY_DIR/theme.conf.user" "$LEGACY_DIR/backgrounds/caelestia_wallpaper.png" "$LEGACY_DIR/backgrounds/caelestia_wallpaper.jpg")
SDDM_HOME="$(getent passwd sddm | cut -d: -f6)"
GREETER_CACHE="${SDDM_HOME:+$SDDM_HOME/.cache/sddm-greeter-qt6}"
# system/sddm/sync's staging, the user's own.
STATE_DIR="$HOME/.local/state/caelestia/sddm"

targets=()
# The theme directory only when it is the one install made: a real directory
# owned by root, carrying this theme's metadata, and owned by no package.
if [ -d "$THEME_DIR" ] && [ ! -L "$THEME_DIR" ] && [ "$(stat -c %u "$THEME_DIR")" = 0 ] &&
   grep -qx 'Name=Caelestia' "$THEME_DIR/metadata.desktop" 2>/dev/null &&
   ! pacman -Qqo "$THEME_DIR" >/dev/null 2>&1; then
    targets+=("$THEME_DIR")
fi
for f in "$HELPER_DEST" "$SUDOERS_FILE" "$SDDM_DROPIN" "${LEGACY_FILES[@]}"; do
    [ -e "$f" ] && ! pacman -Qqo "$f" >/dev/null 2>&1 && targets+=("$f")
done

if [ ${#targets[@]} -eq 0 ]; then
    cm_log "nothing to remove"
else
    echo "This removes:"
    printf '  %s\n' "${targets[@]}"
    if [ "${CM_ASSUME_YES:-0}" != 1 ]; then
        printf 'Remove them? [y/N] '
        read -r reply
        case "$reply" in [yY]*) ;; *) cm_log "nothing was removed"; exit 0 ;; esac
    fi
    for t in "${targets[@]}"; do
        if [ "$t" = "$THEME_DIR" ]; then
            sudo rm -rf --one-file-system -- "$t"
        else
            sudo rm -f -- "$t"
        fi
        cm_log "removed $t"
    done
fi

# The greeter's compiled QML, as its own user; see install.
if [ -n "$GREETER_CACHE" ]; then
    sudo -u sddm rm -rf -- "$GREETER_CACHE"
    cm_log "cleared the greeter's QML cache"
fi

if [ -d "$STATE_DIR" ] && [ ! -L "$STATE_DIR" ]; then
    rm -rf --one-file-system -- "$STATE_DIR"
    cm_log "removed $STATE_DIR"
fi

if grep -qx sddm "$CM_CONFIG/adapters.enabled" 2>/dev/null; then
    sed -i '/^sddm$/d' "$CM_CONFIG/adapters.enabled"
    cm_log "disabled sddm sync"
fi
