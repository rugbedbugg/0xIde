#!/usr/bin/env python3
"""
Caelestia SDDM theme synchronization (unprivileged adapter).

Generates validated theme.conf.user and wallpaper in user state,
then invokes the fixed privileged helper to install them.
"""

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

# User state directory for generated files
STATE_DIR = Path.home() / ".local/state/caelestia/sddm"
STATE_DIR.mkdir(parents=True, exist_ok=True)
STATE_DIR.chmod(0o700)

# Privileged helper
HELPER = "/usr/local/libexec/caelestia-sddm-sync"

# Theme directory (for reading package files if needed)
CORNERS_DIR = Path("/usr/share/sddm/themes/corners")

def get_scheme_data():
    if env_colours := os.environ.get("SCHEME_COLOURS"):
        try:
            return json.loads(env_colours), os.environ.get("SCHEME_MODE", "dark")
        except Exception:
            pass
    scheme_file = Path.home() / ".local/state/caelestia/scheme.json"
    if scheme_file.exists():
        try:
            data = json.loads(scheme_file.read_text())
            return data.get("colours", {}), data.get("mode", "dark")
        except Exception:
            pass
    return {}, "dark"

def get_wallpaper():
    path_file = Path.home() / ".local/state/caelestia/wallpaper/path.txt"
    if path_file.exists():
        try:
            p = Path(path_file.read_text().strip())
            if p.is_file():
                return p
        except Exception:
            pass
    current_symlink = Path.home() / ".local/state/caelestia/wallpaper/current"
    if current_symlink.exists() and current_symlink.resolve().is_file():
        return current_symlink.resolve()
    return None

def main():
    if not CORNERS_DIR.exists():
        return

    colours, mode = get_scheme_data()
    if not colours:
        return

    # Material You / Caelestia color tokens
    surface = colours.get("surface", "1e1e2e")
    surface_container = colours.get("surfaceContainer", surface)
    surface_container_high = colours.get("surfaceContainerHigh", surface_container)
    on_surface = colours.get("onSurface", "ffffff" if mode == "dark" else "000000")
    on_surface_variant = colours.get("onSurfaceVariant", on_surface)
    primary = colours.get("primary", "b4befe")
    secondary = colours.get("secondary", primary)
    on_primary = colours.get("onPrimary", "1e1e2e")
    secondary_container = colours.get("secondaryContainer", surface_container_high)
    on_secondary_container = colours.get("onSecondaryContainer", on_surface)

    alpha = "E6"

    # --- Generate wallpaper in user state ---
    wall = get_wallpaper()
    dest_ext = ".png"
    if wall:
        try:
            dest_ext = wall.suffix if wall.suffix else ".png"
            state_wallpaper = STATE_DIR / f"wallpaper{dest_ext}"
            shutil.copy2(wall, state_wallpaper)
            state_wallpaper.chmod(0o644)
        except Exception as e:
            print(f"Warning: failed to prepare wallpaper: {e}", file=sys.stderr)
            dest_ext = ".png"

    # --- Generate theme.conf.user in user state ---
    if wall:
        bg_relative = f"backgrounds/caelestia_wallpaper{dest_ext}"
    else:
        bg_relative = "backgrounds/glacier.png"
    
    config_content = f"""## Autogenerated by Caelestia Complete SDDM Sync Engine
[General]
BgSource="{bg_relative}"
FontFamily="Google Sans Flex"
FontSize=10
Padding=45
Radius=16
Scale=1

UserPictureEnabled=false
UserBorderWidth=4
UserBorderColor="#{primary}"
UserColor="#{alpha}{surface_container_high}"

InputColor="#{alpha}{surface_container}"
InputTextColor="#{on_surface}"
InputBorderWidth=2
InputBorderColor="#{primary}"
UserPlaceholderText="User"
PassPlaceholderText="Password"
HidePassword=true

LoginButtonTextColor="#{on_primary}"
LoginButtonText="Login"
LoginButtonColor="#{primary}"

PopupColor="#{alpha}{surface_container}"
PopupActiveColor="#{primary}"
PopupActiveTextColor="#{on_primary}"

SessionButtonColor="#{alpha}{secondary_container}"
SessionIconColor="#{on_secondary_container}"
PowerButtonColor="#{alpha}{secondary_container}"
PowerIconColor="#{on_secondary_container}"

DateColor="#{on_surface_variant}"
DateSize=16
DateIsBold=true
DateOpacity=0.85
DateFormat="dddd • d MMM"

TimeColor="#{primary}"
TimeSecondaryColor="#{secondary}"
ClockChipColor="#{alpha}{surface_container_high}"
ClockChipTextColor="#{on_surface}"
ClockHourSize=84
ClockMinuteSize=46
ClockAmPmSize=18
TimeIsBold=true
TimeOpacity=1.0
TimeFormat="hh:mm AP"
"""

    state_theme_conf = STATE_DIR / "theme.conf.user"
    try:
        state_theme_conf.write_text(config_content)
        state_theme_conf.chmod(0o644)
    except Exception as e:
        print(f"Warning: failed to prepare theme.conf.user: {e}", file=sys.stderr)
        return

    # --- Invoke privileged helper ---
    try:
        result = subprocess.run(
            ["sudo", "-n", "/usr/local/libexec/caelestia-sddm-sync"],
            capture_output=True,
            text=True,
            timeout=30
        )
        if result.returncode != 0:
            print(f"ERROR: privileged helper failed: {result.stderr}", file=sys.stderr)
            sys.exit(1)
        if result.stdout:
            print(result.stdout)
    except subprocess.TimeoutExpired:
        print("ERROR: privileged helper timed out", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"ERROR: failed to invoke helper: {e}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
