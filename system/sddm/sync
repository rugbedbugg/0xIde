#!/usr/bin/env python3
import json
import os
import shutil
from pathlib import Path

# Honours the same override as system/sddm/install, so a distribution that
# puts the theme elsewhere needs no edit here.
CORNERS_DIR = Path(os.environ.get("CM_SDDM_THEME_DIR", "/usr/share/sddm/themes/corners"))
THEME_CONF = CORNERS_DIR / "theme.conf"
BG_DIR = CORNERS_DIR / "backgrounds"

def get_scheme_data():
    if env_colours := os.environ.get("SCHEME_COLOURS"):
        try:
            return json.loads(env_colours), os.environ.get("SCHEME_MODE", "dark")
        except Exception:
            pass
    scheme_file = Path.home() / ".local/state/caelestia/scheme.json"
    if scheme_file.exists():
        try:
            data = json.loads(scheme_file.read_text())
            return data.get("colours", {}), data.get("mode", "dark")
        except Exception:
            pass
    return {}, "dark"

def get_wallpaper():
    path_file = Path.home() / ".local/state/caelestia/wallpaper/path.txt"
    if path_file.exists():
        try:
            p = Path(path_file.read_text().strip())
            if p.is_file():
                return p
        except Exception:
            pass
    current_symlink = Path.home() / ".local/state/caelestia/wallpaper/current"
    if current_symlink.exists() and current_symlink.resolve().is_file():
        return current_symlink.resolve()
    return None

def main():
    if not CORNERS_DIR.exists():
        return

    colours, mode = get_scheme_data()
    if not colours:
        return

    # Material You / Caelestia color tokens
    surface = colours.get("surface", "1e1e2e")
    surface_container = colours.get("surfaceContainer", surface)
    surface_container_high = colours.get("surfaceContainerHigh", surface_container)
    on_surface = colours.get("onSurface", "ffffff" if mode == "dark" else "000000")
    on_surface_variant = colours.get("onSurfaceVariant", on_surface)
    primary = colours.get("primary", "b4befe")
    secondary = colours.get("secondary", primary)
    on_primary = colours.get("onPrimary", "1e1e2e")
    secondary_container = colours.get("secondaryContainer", surface_container_high)
    on_secondary_container = colours.get("onSecondaryContainer", on_surface)

    # Frosted glass card alpha (E6 = ~90% opacity, CC = 80%)
    alpha = "E6"

    # Sync wallpaper
    bg_relative = "backgrounds/glacier.png"
    wall = get_wallpaper()
    if wall and BG_DIR.exists():
        try:
            dest_ext = wall.suffix if wall.suffix else ".png"
            dest_file = BG_DIR / f"caelestia_wallpaper{dest_ext}"
            shutil.copy2(wall, dest_file)
            dest_file.chmod(0o644)
            bg_relative = f"backgrounds/{dest_file.name}"
        except Exception:
            pass

    config_content = f"""## Autogenerated by Caelestia Complete SDDM Sync Engine
[General]
BgSource="{bg_relative}"
FontFamily="Google Sans Flex"
FontSize=10
Padding=45
Radius=16
Scale=1

UserPictureEnabled=false
UserBorderWidth=4
UserBorderColor="#{primary}"
UserColor="#{alpha}{surface_container_high}"

InputColor="#{alpha}{surface_container}"
InputTextColor="#{on_surface}"
InputBorderWidth=2
InputBorderColor="#{primary}"
UserPlaceholderText="User"
PassPlaceholderText="Password"
HidePassword=true

LoginButtonTextColor="#{on_primary}"
LoginButtonText="Login"
LoginButtonColor="#{primary}"

PopupColor="#{alpha}{surface_container}"
PopupActiveColor="#{primary}"
PopupActiveTextColor="#{on_primary}"

SessionButtonColor="#{alpha}{secondary_container}"
SessionIconColor="#{on_secondary_container}"
PowerButtonColor="#{alpha}{secondary_container}"
PowerIconColor="#{on_secondary_container}"

DateColor="#{on_surface_variant}"
DateSize=16
DateIsBold=true
DateOpacity=0.85
DateFormat="dddd • d MMM"

TimeColor="#{primary}"
TimeSecondaryColor="#{secondary}"
ClockChipColor="#{alpha}{surface_container_high}"
ClockChipTextColor="#{on_surface}"
ClockHourSize=84
ClockMinuteSize=46
ClockAmPmSize=18
TimeIsBold=true
TimeOpacity=1.0
TimeFormat="hh:mm AP"
"""
    try:
        THEME_CONF.write_text(config_content)
        THEME_CONF.chmod(0o644)
    except OSError:
        import subprocess
        subprocess.run(
            ["sudo", "-n", "tee", str(THEME_CONF)],
            input=config_content,
            text=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )

if __name__ == "__main__":
    main()
