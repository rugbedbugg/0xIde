#!/usr/bin/env python3
"""
Caelestia SDDM theme synchronization (unprivileged adapter).

Writes the current Caelestia scheme, wallpaper and profile picture into user
state for the caelestia SDDM theme, then, once the theme is installed, invokes
the fixed privileged helper to install them. The state is written either way,
so system/sddm/preview shows the current desktop before anything is installed.
"""

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

# User state directory for generated files
STATE_DIR = Path.home() / ".local/state/caelestia/sddm"
STATE_DIR.mkdir(parents=True, exist_ok=True)
STATE_DIR.chmod(0o700)

# Privileged helper
HELPER = "/usr/local/libexec/caelestia-sddm-sync"

# The theme system/sddm/install places; there is nothing to hand over to
# before it exists.
THEME_DIR = Path("/usr/share/sddm/themes/caelestia")

# Every palette role the theme reads (theme/components/Colours.qml). The helper
# accepts exactly these keys, so the two lists change together.
PALETTE_ROLES = (
    "primary", "onPrimary", "primaryContainer", "onPrimaryContainer",
    "secondary", "onSecondary", "secondaryContainer", "onSecondaryContainer",
    "tertiary", "onTertiary", "tertiaryContainer", "onTertiaryContainer",
    "error", "onError", "errorContainer", "onErrorContainer",
    "surface", "onSurface", "surfaceVariant", "onSurfaceVariant",
    "surfaceContainerLowest", "surfaceContainerLow", "surfaceContainer",
    "surfaceContainerHigh", "surfaceContainerHighest",
    "outline", "outlineVariant", "shadow", "scrim",
    "inverseSurface", "inverseOnSurface", "inversePrimary",
    "term0", "term1", "term2", "term3", "term4", "term5", "term6", "term7",
)

def get_scheme_data():
    if env_colours := os.environ.get("SCHEME_COLOURS"):
        try:
            return json.loads(env_colours), os.environ.get("SCHEME_MODE", "dark")
        except Exception:
            pass
    scheme_file = Path.home() / ".local/state/caelestia/scheme.json"
    if scheme_file.exists():
        try:
            data = json.loads(scheme_file.read_text())
            return data.get("colours", {}), data.get("mode", "dark")
        except Exception:
            pass
    return {}, "dark"

def get_wallpaper():
    path_file = Path.home() / ".local/state/caelestia/wallpaper/path.txt"
    if path_file.exists():
        try:
            p = Path(path_file.read_text().strip())
            if p.is_file():
                return p
        except Exception:
            pass
    current_symlink = Path.home() / ".local/state/caelestia/wallpaper/current"
    if current_symlink.exists() and current_symlink.resolve().is_file():
        return current_symlink.resolve()
    return None

# The helper's limits; a larger file makes it refuse the whole sync.
MAX_WALLPAPER_SIZE = 50 * 1024 * 1024
MAX_AVATAR_SIZE = 5 * 1024 * 1024

def image_type(path):
    """The extension the helper will give this file, from its bytes, or None."""
    with open(path, "rb") as f:
        head = f.read(8)
    if head[:3] == b"\xff\xd8\xff":
        return ".jpg"
    if head == b"\x89PNG\r\n\x1a\n":
        return ".png"
    return None

def prepare_image(src, stem, limit, what):
    """Leaves exactly one <stem>.{png,jpg} in STATE_DIR, or none.

    The helper installs the first of <stem>.png and <stem>.jpg it finds and
    names the result by the file's bytes, not its name. So the state file is
    named by content, and any other <stem>.* is removed first: a copy left
    from an earlier image would otherwise be installed in place of this one,
    under a name the theme does not look for. Returns the extension, or None.
    """
    ext = None
    if src:
        try:
            ext = image_type(src)
            if ext is None:
                print(f"Warning: {src.name} is not PNG or JPEG; the login screen shows no {what}",
                      file=sys.stderr)
            elif src.stat().st_size > limit:
                print(f"Warning: {src.name} is over {limit // (1024 * 1024)} MiB; the login screen shows no {what}",
                      file=sys.stderr)
                ext = None
        except OSError as e:
            print(f"Warning: cannot read {what}: {e}", file=sys.stderr)
            ext = None

    target = STATE_DIR / f"{stem}{ext}" if ext else None
    for old in STATE_DIR.glob(f"{stem}.*"):
        if old != target:
            old.unlink(missing_ok=True)
    if target is None:
        return None

    tmp = STATE_DIR / f".{stem}{ext}.tmp"
    try:
        shutil.copyfile(src, tmp)
        tmp.chmod(0o644)
        os.replace(tmp, target)
    except OSError as e:
        print(f"Warning: failed to prepare {what}: {e}", file=sys.stderr)
        tmp.unlink(missing_ok=True)
        target.unlink(missing_ok=True)
        return None
    return ext

def prepare_wallpaper(wall):
    return prepare_image(wall, "wallpaper", MAX_WALLPAPER_SIZE, "wallpaper")

def get_avatar():
    face = Path.home() / ".face"
    return face if face.is_file() else None

def shell_config():
    """The user's shell.json, or {} when it is missing or unreadable."""
    config = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "caelestia/shell.json"
    try:
        data = json.loads(config.read_text())
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}

def twelve_hour_clock(config):
    """The shell's own setting, so the login clock matches the lockscreen's."""
    services = config.get("services")
    return isinstance(services, dict) and services.get("useTwelveHourClock") is True

def transparency(config):
    """appearance.transparency, with the plugin's defaults (appearanceconfig.hpp):
    off, base 0.85, layers 0.4. Numbers are clamped to 0-1, as the shell does."""
    appearance = config.get("appearance")
    t = appearance.get("transparency") if isinstance(appearance, dict) else None
    t = t if isinstance(t, dict) else {}

    def unit(key, default):
        v = t.get(key, default)
        if isinstance(v, bool) or not isinstance(v, (int, float)) or v != v:
            v = default
        return f"{max(0.0, min(1.0, float(v))):.3f}"

    return t.get("enabled") is True, unit("base", 0.85), unit("layers", 0.4)

def main():
    colours, mode = get_scheme_data()
    if not colours:
        return

    config = shell_config()
    tr_enabled, tr_base, tr_layers = transparency(config)
    wallpaper = prepare_wallpaper(get_wallpaper())
    prepare_image(get_avatar(), "avatar", MAX_AVATAR_SIZE, "profile picture")

    # Only the keys and value shapes the helper accepts. It re-writes the file
    # itself from what it parses, so nothing else would reach the theme.
    lines = [
        "[General]",
        f'BgSource="backgrounds/caelestia_wallpaper{wallpaper}"' if wallpaper else "BgSource=",
        f"mode={'light' if mode == 'light' else 'dark'}",
        f"useTwelveHourClock={'true' if twelve_hour_clock(config) else 'false'}",
        f"transparencyEnabled={'true' if tr_enabled else 'false'}",
        f"transparencyBase={tr_base}",
        f"transparencyLayers={tr_layers}",
    ]
    for role in PALETTE_ROLES:
        value = str(colours.get(role, "")).lstrip("#")
        if len(value) == 6 and all(c in "0123456789abcdefABCDEF" for c in value):
            lines.append(f'{role}="#{value}"')

    state_theme_conf = STATE_DIR / "theme.conf.user"
    try:
        state_theme_conf.write_text("\n".join(lines) + "\n")
        state_theme_conf.chmod(0o644)
    except Exception as e:
        print(f"Warning: failed to prepare theme.conf.user: {e}", file=sys.stderr)
        return

    if not THEME_DIR.exists():
        return

    # --- Invoke privileged helper ---
    try:
        result = subprocess.run(
            ["sudo", "-n", "/usr/local/libexec/caelestia-sddm-sync"],
            capture_output=True,
            text=True,
            timeout=30
        )
        if result.returncode != 0:
            print(f"ERROR: privileged helper failed: {result.stderr}", file=sys.stderr)
            sys.exit(1)
        if result.stdout:
            print(result.stdout)
    except subprocess.TimeoutExpired:
        print("ERROR: privileged helper timed out", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"ERROR: failed to invoke helper: {e}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
