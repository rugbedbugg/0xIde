# Installed by 0xide. Scoped to one command, writing one set of paths.
# @USER@ is substituted at install time; nothing here is committed with a
# username in it.
#
# papirus-folders  recolours the Papirus folder icons under /usr/share/icons.
#                  The papirus adapter calls it on every theme change, and it
#                  cannot work without root.
@USER@ ALL=(root) NOPASSWD: /usr/bin/papirus-folders -C *, /usr/bin/papirus-folders -C * -u
