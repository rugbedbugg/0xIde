# Installed by 0xide. One fixed helper, for one operation.
# @USER@ is substituted at install time; nothing here is committed with a
# username in it.
#
# 0xide-papirus-folders  recolours the folders of the system Papirus icon
#                        theme to one colour papirus-folders lists, and nothing
#                        else: no other theme, directory or option.
@USER@ ALL=(root) NOPASSWD: /usr/local/libexec/0xide-papirus-folders
