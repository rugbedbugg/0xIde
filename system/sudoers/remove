#!/usr/bin/env bash
set -euo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../../orchestration/lib/common.sh"
# /etc/sudoers.d cannot be read without root, so its files cannot be tested for
# first; removing one that is absent is harmless. caelestia-mod is the rule's
# name from before the rename.
dest=/etc/sudoers.d/0xide
old=/etc/sudoers.d/caelestia-mod
echo "Removing $dest (and $old, if present). The papirus adapter will stop working."
sudo rm -f -- "$dest" "$old"
ox_log "removed $dest"
