#!/usr/bin/env bash
# Installs the passwordless rules the papirus and edge adapters need.
# Prints the exact file first and refuses to run unattended.
set -euo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../../orchestration/lib/common.sh"

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
dest=/etc/sudoers.d/0xide
staged="$OX_STATE/0xide.sudoers"

mkdir -p "$OX_STATE"
sed "s|@USER@|$(id -un)|g" "$here/0xide.template" > "$staged"
chmod 0440 "$staged"

echo
echo "This grants passwordless root for these commands, and nothing else:"
echo
sed 's/^/    /' "$staged" | grep -v '^    #' | grep -v '^    $'
echo
echo "It will be installed as $dest"
echo

if ! visudo -c -f "$staged" >/dev/null; then
    ox_die "the generated rule is not valid sudoers syntax; nothing was installed"
fi
ox_log "syntax checked with visudo -c"

if [ "${OX_ASSUME_YES:-0}" != 1 ]; then
    printf 'Install it? [y/N] '
    read -r reply
    case "$reply" in [yY]*) ;; *) ox_log "nothing was installed"; exit 0 ;; esac
fi

sudo install -m 0440 -o root -g root "$staged" "$dest"
ox_own "$dest"
ox_log "installed $dest"

# Before the rename from caelestia-mod the rule and the Edge policy it writes
# were named after Caelestia. The old rule goes; the old policy is renamed so
# Edge keeps its colour until the next theme change rewrites it.
sudo rm -f -- /etc/sudoers.d/caelestia-mod
old_policy=/etc/opt/edge/policies/managed/caelestia.json
new_policy=/etc/opt/edge/policies/managed/0xide.json
if [ -f "$old_policy" ] && [ ! -L "$old_policy" ] && ! pacman -Qqo "$old_policy" >/dev/null 2>&1; then
    if [ -e "$new_policy" ]; then sudo rm -f -- "$old_policy"; else sudo mv -- "$old_policy" "$new_policy"; fi
    ox_log "moved the Edge policy to $new_policy"
fi
