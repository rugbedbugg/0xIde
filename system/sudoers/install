#!/usr/bin/env bash
# Installs the fixed helper the papirus adapter needs, and the passwordless
# rule for that helper alone. Prints exactly what it will do first, and refuses
# to run unattended.
set -euo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../../orchestration/lib/common.sh"

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
dest=/etc/sudoers.d/0xide
helper_src="$here/0xide-papirus-folders"
helper=/usr/local/libexec/0xide-papirus-folders

[ "$(id -u)" -ne 0 ] || ox_die "do not run this installer as root; run as your normal user"
[ -x "$helper_src" ] || ox_die "helper source $helper_src not found or not executable"
staged="$OX_STATE/0xide.sudoers"

mkdir -p "$OX_STATE"
# The previous run left its copy read-only (0440), which cannot be written over.
rm -f -- "$staged"
sed "s|@USER@|$(id -un)|g" "$here/0xide.template" > "$staged"
chmod 0440 "$staged"

echo
echo "This installs, as root:"
echo
echo "    $helper  (root:root 0755, from system/sudoers/0xide-papirus-folders)"
echo "    $dest  (root:root 0440), which grants passwordless root for this, and nothing else:"
echo
sed 's/^/        /' "$staged" | grep -v '^        #' | grep -v '^        $'
echo
echo "The helper takes one colour name and recolours the system Papirus theme's"
echo "folders with papirus-folders; it accepts no theme, directory or other option."
echo

if ! visudo -c -f "$staged" >/dev/null; then
    ox_die "the generated rule is not valid sudoers syntax; nothing was installed"
fi
ox_log "syntax checked with visudo -c"

if [ "${OX_ASSUME_YES:-0}" != 1 ]; then
    printf 'Install it? [y/N] '
    read -r reply
    case "$reply" in [yY]*) ;; *) ox_log "nothing was installed"; exit 0 ;; esac
fi

# The helper first, so the rule never names a file that is not there. The rule
# replaces any earlier one in the same file, which granted papirus-folders
# itself and so any of its options.
sudo install -D -m 0755 -o root -g root "$helper_src" "$helper"
ox_own "$helper"
ox_log "installed $helper"
sudo install -m 0440 -o root -g root "$staged" "$dest"
ox_own "$dest"
ox_log "installed $dest"

# The rule from before the rename from caelestia-mod goes. So do the policy
# files the removed Edge adapter wrote, under either name: Edge never
# implemented the theme policies in them, and the gtk adapter colours it now.
sudo rm -f -- /etc/sudoers.d/caelestia-mod
for policy in /etc/opt/edge/policies/managed/0xide.json /etc/opt/edge/policies/managed/caelestia.json; do
    if [ -f "$policy" ] && [ ! -L "$policy" ] && ! pacman -Qqo "$policy" >/dev/null 2>&1; then
        sudo rm -f -- "$policy"
        ox_log "removed the old Edge policy $policy"
    fi
done
