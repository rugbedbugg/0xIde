From 8ee0de2c900e397bc98f8a3844b110008e0f31f0 Mon Sep 17 00:00:00 2001
From: Oxide 1-6 <yes.par781@gmail.com>
Date: Thu, 17 Sep 2026 06:05:08 +0530
Subject: [PATCH 1/3] shell: resolve the Caelestia plugin through a build-time
 import path

The AI and OCR extensions need config and request types that the packaged
Caelestia plugin does not provide, so the shell must import the locally
built plugin instead. The path is substituted by shell/build.sh at install
time rather than hardcoded, so no personal path is committed.

Also pins settings.watchFiles off: the shell writes shell.json itself from
the Nexus settings pages, and the watcher re-entered on those writes.
---
 shell.qml | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/shell.qml b/shell.qml
index bc661e8d..4dd422bb 100644
--- a/shell.qml
+++ b/shell.qml
@@ -1,3 +1,4 @@
+//@ pragma Env QML_IMPORT_PATH=@CAELESTIA_MOD_QML_IMPORT_PATH@
 //@ pragma Env QS_CRASHREPORT_URL=https://github.com/caelestia-dots/shell/issues/new?template=crash.yml
 //@ pragma DefaultEnv QS_NO_RELOAD_POPUP=1
 //@ pragma DefaultEnv QS_DROP_EXPENSIVE_FONTS=1
@@ -16,7 +17,7 @@ import qs.services
 ShellRoot {
     id: root
 
-    settings.watchFiles: true
+    settings.watchFiles: false
 
     Binding {
         target: ShellState
