From a8cbb0dee4761b6f6eb7f7ad35397b789afe2fc8 Mon Sep 17 00:00:00 2001
From: Oxide 1-6 <yes.par781@gmail.com>
Date: Thu, 17 Sep 2026 19:28:57 +0530
Subject: [PATCH 2/3] areapicker: add OCR and region/circle search capture modes

Routes a completed selection to one of three consumers instead of only the
screenshot path: Ocr.extract for text extraction, region_search.sh for web
search, or the existing clipboard/file behaviour. Circle mode records the
pointer track and derives the bounding box from it.

Both OCR modes freeze the screen, so the selection is made against a still
image. Text extraction puts the result on the clipboard with no window;
askAi opens the result window instead, for the table and AI actions.

A zero-size selection closes without capturing, and a capture that fails
closes and says so rather than leaving the selector up.

The mode indicator follows the pointer rather than sitting at the top of the
screen, and covers OCR as well as the two search modes. Its component,
PickerGuide, is an extension file, so it is not part of this patch.

The two files are one change: Picker dispatches on loader.ocr/searchMode
and AreaPicker owns the loaders and the result popup those modes need.
---
 modules/areapicker/AreaPicker.qml | 172 ++++++++++++++++++++++++++++++
 modules/areapicker/Picker.qml     |  80 +++++++++++++-
 2 files changed, 251 insertions(+), 1 deletion(-)

diff --git a/modules/areapicker/AreaPicker.qml b/modules/areapicker/AreaPicker.qml
index 76cc1039..e76e88b0 100644
--- a/modules/areapicker/AreaPicker.qml
+++ b/modules/areapicker/AreaPicker.qml
@@ -1,5 +1,6 @@
 pragma ComponentBehavior: Bound
 
+import QtQuick
 import Quickshell
 import Quickshell.Io
 import Quickshell.Wayland
@@ -14,6 +15,11 @@ Scope {
         property bool freeze
         property bool closing
         property bool clipboardOnly
+        // ocr extracts the text in the selection. askAi hands it to the result
+        // window instead of putting it straight on the clipboard.
+        property bool ocr
+        property bool askAi
+        property string searchMode: ""
 
         Variants {
             model: Screens.screens
@@ -47,11 +53,90 @@ Scope {
         }
     }
 
+    Connections {
+        function onRecognized(): void {
+            result.screen = Ocr.resultScreen;
+            result.text = "";
+            result.structured = Ocr.result;
+            result.text = Ocr.result.text;
+            if (!result.text.trim())
+                Quickshell.execDetached(["notify-send", "-a", "caelestia", "No text found", "Nothing was recognised in the selected region"]);
+        }
+        function onErrorChanged(): void {
+            if (Ocr.error)
+                Quickshell.execDetached(["notify-send", "-a", "caelestia", "-u", "critical", "OCR failed", Ocr.error]);
+        }
+
+        target: Ocr
+    }
+
+    LazyLoader {
+        id: result
+
+        property string text
+        property var structured: ({})
+        property ShellScreen screen
+
+        active: text.length > 0
+
+        StyledWindow {
+            screen: result.screen ?? Screens.screens[0]
+            name: "ocr-result"
+            WlrLayershell.exclusionMode: ExclusionMode.Ignore
+            WlrLayershell.layer: WlrLayer.Overlay
+            WlrLayershell.keyboardFocus: WlrKeyboardFocus.OnDemand
+            mask: Region {
+                item: resultCard
+            }
+
+            anchors.top: true
+            anchors.bottom: true
+            anchors.left: true
+            anchors.right: true
+
+            OcrResult {
+                id: resultCard
+
+                text: result.text
+                structured: result.structured
+                onDismissed: result.text = ""
+            }
+        }
+    }
+
     IpcHandler {
+        id: pickerIpc
+
+        function showOcr(json: string): void {
+            try {
+                const data = JSON.parse(json);
+                if (typeof data.text !== "string" || !Array.isArray(data.rows) || !Array.isArray(data.words))
+                    return;
+                result.text = "";
+                result.screen = Screens.screens[0];
+                result.structured = data;
+                result.text = data.text;
+                if (!data.text.trim())
+                    Quickshell.execDetached(["notify-send", "-a", "caelestia", "No text found", "Nothing was recognised in the selected region"]);
+            } catch (error) {
+                Quickshell.execDetached(["notify-send", "-a", "caelestia", "-u", "critical", "OCR failed", "Invalid structured OCR result"]);
+            }
+        }
+
+        function showText(text: string): void {
+            result.screen = Screens.screens[0];
+            result.text = "";
+            result.structured = ({});
+            result.text = text;
+        }
+
         function open(): void {
             root.freeze = false;
             root.closing = false;
             root.clipboardOnly = false;
+            root.ocr = false;
+            root.askAi = false;
+            root.searchMode = "";
             root.activeAsync = true;
         }
 
@@ -59,6 +144,9 @@ Scope {
             root.freeze = true;
             root.closing = false;
             root.clipboardOnly = false;
+            root.ocr = false;
+            root.askAi = false;
+            root.searchMode = "";
             root.activeAsync = true;
         }
 
@@ -66,6 +154,9 @@ Scope {
             root.freeze = false;
             root.closing = false;
             root.clipboardOnly = true;
+            root.ocr = false;
+            root.askAi = false;
+            root.searchMode = "";
             root.activeAsync = true;
         }
 
@@ -73,6 +164,51 @@ Scope {
             root.freeze = true;
             root.closing = false;
             root.clipboardOnly = true;
+            root.ocr = false;
+            root.askAi = false;
+            root.searchMode = "";
+            root.activeAsync = true;
+        }
+
+        // Both OCR entry points freeze the screen: selecting text against a
+        // desktop that is still moving is what made the old flow unusable.
+        function openOcr(): void {
+            root.freeze = true;
+            root.closing = false;
+            root.clipboardOnly = false;
+            root.ocr = true;
+            root.askAi = false;
+            root.searchMode = "";
+            root.activeAsync = true;
+        }
+
+        function openAskAi(): void {
+            root.freeze = true;
+            root.closing = false;
+            root.clipboardOnly = false;
+            root.ocr = true;
+            root.askAi = true;
+            root.searchMode = "";
+            root.activeAsync = true;
+        }
+
+        function regionSearch(): void {
+            root.freeze = false;
+            root.closing = false;
+            root.clipboardOnly = false;
+            root.ocr = false;
+            root.askAi = false;
+            root.searchMode = "rectangle";
+            root.activeAsync = true;
+        }
+
+        function circleSearch(): void {
+            root.freeze = false;
+            root.closing = false;
+            root.clipboardOnly = false;
+            root.ocr = false;
+            root.askAi = false;
+            root.searchMode = "circle";
             root.activeAsync = true;
         }
 
@@ -88,6 +224,7 @@ Scope {
             root.freeze = false;
             root.closing = false;
             root.clipboardOnly = false;
+            root.ocr = false;
             root.activeAsync = true;
         }
     }
@@ -101,6 +238,7 @@ Scope {
             root.freeze = true;
             root.closing = false;
             root.clipboardOnly = false;
+            root.ocr = false;
             root.activeAsync = true;
         }
     }
@@ -114,6 +252,7 @@ Scope {
             root.freeze = false;
             root.closing = false;
             root.clipboardOnly = true;
+            root.ocr = false;
             root.activeAsync = true;
         }
     }
@@ -127,7 +266,40 @@ Scope {
             root.freeze = true;
             root.closing = false;
             root.clipboardOnly = true;
+            root.ocr = false;
             root.activeAsync = true;
         }
     }
+
+    // qmllint disable unresolved-type
+    CustomShortcut {
+        // qmllint enable unresolved-type
+        name: "screenshotOcr"
+        description: "Select a region and copy the text in it"
+        onPressed: pickerIpc.openOcr()
+    }
+
+    // qmllint disable unresolved-type
+    CustomShortcut {
+        // qmllint enable unresolved-type
+        name: "askAi"
+        description: "Select a region and open its text in the result window"
+        onPressed: pickerIpc.openAskAi()
+    }
+
+    // qmllint disable unresolved-type
+    CustomShortcut {
+        // qmllint enable unresolved-type
+        name: "regionSearch"
+        description: "Select a rectangle and search the web for what it contains"
+        onPressed: pickerIpc.regionSearch()
+    }
+
+    // qmllint disable unresolved-type
+    CustomShortcut {
+        // qmllint enable unresolved-type
+        name: "circleSearch"
+        description: "Circle an area and search the web for what it contains"
+        onPressed: pickerIpc.circleSearch()
+    }
 }
diff --git a/modules/areapicker/Picker.qml b/modules/areapicker/Picker.qml
index 5e847603..aedf1604 100644
--- a/modules/areapicker/Picker.qml
+++ b/modules/areapicker/Picker.qml
@@ -5,6 +5,7 @@ import Quickshell
 import Quickshell.Io
 import Quickshell.Wayland
 import Caelestia
+import Caelestia.Config
 import qs.components
 import qs.components.effects
 import qs.services
@@ -32,6 +33,7 @@ MouseArea {
     property real rsy: Math.min(sy, ey)
     property real sw: Math.abs(sx - ex)
     property real sh: Math.abs(sy - ey)
+    property var circlePoints: []
 
     property list<var> clients: {
         const mon = Hypr.monitorFor(screen);
@@ -74,13 +76,25 @@ MouseArea {
     function save(): void {
         const tmpfile = Qt.resolvedUrl(`/tmp/caelestia-picker-${Quickshell.processId}-${Date.now()}.png`);
         CUtils.saveItem(screencopy, tmpfile, Qt.rect(Math.ceil(rsx), Math.ceil(rsy), Math.floor(sw), Math.floor(sh)), path => {
-            if (root.loader.clipboardOnly) {
+            if (root.loader.ocr) {
+                if (root.loader.askAi)
+                    Ocr.scan(path, root.screen);
+                else
+                    Ocr.extract(path);
+            } else if (root.loader.searchMode) {
+                Quickshell.execDetached(["bash", Quickshell.shellPath("assets/search/region_search.sh"), path]);
+            } else if (root.loader.clipboardOnly) {
                 Quickshell.execDetached(["sh", "-c", "wl-copy --type image/png < " + path]);
                 Quickshell.execDetached(["notify-send", "-a", "caelestia-cli", "-i", path, "Screenshot taken", "Screenshot copied to clipboard"]);
             } else {
                 Quickshell.execDetached(["swappy", "-f", path]);
             }
             closeAnim.start();
+        }, () => {
+            // A capture that failed still has to close the selector, and has to
+            // say so rather than looking like an empty result.
+            Quickshell.execDetached(["notify-send", "-a", "caelestia", "-u", "critical", "Capture failed", "The selected region could not be captured"]);
+            closeAnim.start();
         });
     }
 
@@ -120,12 +134,29 @@ MouseArea {
     onPressed: event => {
         ssx = event.x;
         ssy = event.y;
+        if (root.loader.searchMode === "circle")
+            circlePoints = [{ x: event.x, y: event.y }];
+        circlePath.requestPaint();
     }
 
     onReleased: {
         if (closeAnim.running)
             return;
 
+        if (root.loader.searchMode === "circle" && circlePoints.length > 1) {
+            const xs = circlePoints.map(point => point.x);
+            const ys = circlePoints.map(point => point.y);
+            sx = Math.min(...xs);
+            sy = Math.min(...ys);
+            ex = Math.max(...xs);
+            ey = Math.max(...ys);
+        }
+
+        if (root.sw < 1 || root.sh < 1) {
+            closeAnim.start();
+            return;
+        }
+
         if (root.loader.freeze) {
             save();
         } else {
@@ -145,6 +176,9 @@ MouseArea {
             sy = ssy;
             ex = x;
             ey = y;
+            if (root.loader.searchMode === "circle")
+                circlePoints = circlePoints.concat([{ x, y }]);
+            circlePath.requestPaint();
         } else {
             checkClientRects(x, y);
         }
@@ -236,6 +270,22 @@ MouseArea {
         }
     }
 
+    PickerGuide {
+        z: 4
+        visible: root.loader.ocr || !!root.loader.searchMode
+        icon: root.loader.ocr ? "document_scanner" : "image_search"
+        label: {
+            if (root.loader.ocr)
+                return root.loader.askAi ? qsTr("Extract text for AI") : qsTr("Extract text");
+            return root.loader.searchMode === "circle" ? qsTr("Circle to search") : qsTr("Search this region");
+        }
+
+        // Below and right of the pointer while hovering, and of the selection
+        // while dragging, clamped so it never leaves the screen.
+        x: Math.max(0, Math.min(root.screen.width - width, (root.pressed ? root.rsx + root.sw : root.mouseX) + Tokens.spacing.small))
+        y: Math.max(0, Math.min(root.screen.height - height, (root.pressed ? root.rsy + root.sh : root.mouseY) + Tokens.spacing.small))
+    }
+
     Item {
         id: selectionWrapper
 
@@ -301,4 +351,32 @@ MouseArea {
 
         Anim {}
     }
+
+    Canvas {
+        id: circlePath
+
+        anchors.fill: parent
+        visible: root.loader.searchMode === "circle" && root.circlePoints.length > 1
+        z: 3
+
+        onPaint: {
+            const ctx = getContext("2d");
+            ctx.reset();
+            ctx.strokeStyle = Colours.palette.m3primary;
+            // Caelestia has no stroke-width token; this matches the selection
+            // border, which upstream sets to 2 plus a little to stay legible
+            // over a busy screen.
+            ctx.lineWidth = 3;
+            ctx.lineCap = "round";
+            ctx.lineJoin = "round";
+            ctx.beginPath();
+            root.circlePoints.forEach((point, index) => {
+                if (index === 0)
+                    ctx.moveTo(point.x, point.y);
+                else
+                    ctx.lineTo(point.x, point.y);
+            });
+            ctx.stroke();
+        }
+    }
 }
