+    Connections {
+        function onRecognized(): void {
+            if (root.ocrClipboard) {
+                const text = Ocr.result.text.trim();
+                if (text) {
+                    Quickshell.execDetached(["wl-copy", text]);
+                    Quickshell.execDetached(["notify-send", "Text copied", "OCR text copied to the clipboard"]);
+                } else {
+                    Quickshell.execDetached(["notify-send", "No text found", "OCR did not detect text in the selected region"]);
+                }
+                root.ocrClipboard = false;
+                return;
+            }
+            result.screen = Ocr.resultScreen;
+            result.text = "";
+            result.structured = Ocr.result;
+            result.text = Ocr.result.text;
+            if (!result.text.trim())
+                Quickshell.execDetached(["notify-send", "No text found", "OCR did not detect text in the selected region"]);
+        }
+        function onErrorChanged(): void {
+            if (Ocr.error)
+                Quickshell.execDetached(["notify-send", "-a", "caelestia", "-u", "critical", "OCR failed", Ocr.error]);
+        }
+
+        target: Ocr
+    }
+
+    LazyLoader {
+        id: result
+
+        property string text
+        property var structured: ({})
+        property ShellScreen screen
+
+        active: text.length > 0
+
+        StyledWindow {
+            screen: result.screen ?? Screens.screens[0]
+            name: "ocr-result"
+            WlrLayershell.exclusionMode: ExclusionMode.Ignore
+            WlrLayershell.layer: WlrLayer.Overlay
+            WlrLayershell.keyboardFocus: WlrKeyboardFocus.OnDemand
+            mask: Region {
