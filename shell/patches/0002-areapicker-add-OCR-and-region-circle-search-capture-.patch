+            }
+
+            anchors.top: true
+            anchors.bottom: true
+            anchors.left: true
+            anchors.right: true
+
+            OcrResult {
+                id: resultCard
+
+                text: result.text
+                structured: result.structured
+                onDismissed: result.text = ""
+            }
+        }
+    }
+
     IpcHandler {
+        id: pickerIpc
+
+        function showOcr(json: string): void {
+            try {
+                const data = JSON.parse(json);
+                if (typeof data.text !== "string" || !Array.isArray(data.rows) || !Array.isArray(data.words))
+                    return;
+                result.text = "";
+                result.screen = Screens.screens[0];
+                result.structured = data;
+                result.text = data.text;
+                if (!data.text.trim())
+                    Quickshell.execDetached(["notify-send", "No text found", "OCR did not detect text in the selected region"]);
+            } catch (error) {
+                Quickshell.execDetached(["notify-send", "OCR failed", "Invalid structured OCR result"]);
+            }
+        }
+
+        function showText(text: string): void {
+            result.screen = Screens.screens[0];
+            result.text = "";
+            result.structured = ({});
+            result.text = text;
+        }
+
