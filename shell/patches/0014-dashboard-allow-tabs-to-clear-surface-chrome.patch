Subject: [PATCH] dashboard: allow tabs to clear adjacent surface chrome

Keep the full-width divider while allowing a caller to inset the tab hit areas.
The default inset is zero, preserving the border dropdown layout.

diff --git a/modules/dashboard/Tabs.qml b/modules/dashboard/Tabs.qml
--- a/modules/dashboard/Tabs.qml
+++ b/modules/dashboard/Tabs.qml
@@ -16,6 +16,9 @@
     required property ScreenState screenState
     required property var tabs

+    // Reserve room for adjacent surface chrome without shortening the divider.
+    property real tabRightInset: 0
+
     readonly property alias count: bar.count

     implicitHeight: bar.implicitHeight + bar.anchors.topMargin + indicator.implicitHeight + indicator.anchors.topMargin + separator.implicitHeight
@@ -25,6 +28,7 @@

         anchors.left: parent.left
         anchors.right: parent.right
+        anchors.rightMargin: root.tabRightInset
         anchors.top: parent.top
         anchors.topMargin: Tokens.sizes.dashboard.tabIndicatorSpacing

@@ -65,14 +69,14 @@
             const tab = bar.currentItem;
             if (tab)
                 return tab.implicitWidth;
-            const width = (root.nonAnimWidth - bar.spacing * (bar.count - 1)) / bar.count;
+            const width = (root.nonAnimWidth - root.tabRightInset - bar.spacing * (bar.count - 1)) / bar.count;
             return width;
         }
         implicitHeight: 3

         x: {
             const tab = bar.currentItem;
-            const width = (root.nonAnimWidth - bar.spacing * (bar.count - 1)) / bar.count;
+            const width = (root.nonAnimWidth - root.tabRightInset - bar.spacing * (bar.count - 1)) / bar.count;
             const tabWidth = tab?.implicitWidth ?? width;
             return width * bar.currentIndex + (width - tabWidth) / 2;
         }
