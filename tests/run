    case "$res" in *'"noUv":true'*) ok "without uv, the language list says why it is empty" ;; *) no "without uv the language list gave no reason ($res)" ;; esac
    case "$res" in *'"recovers":true'*) ok "a list that loads again clears the reason" ;; *) no "the reason outlived a working list ($res)" ;; esac
    rm -rf "$lx"
