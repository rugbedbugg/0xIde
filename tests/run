    no "dictation did not turn off: $(tr '\n' '|' < "$td/notify.log")"
[ -n "$pid" ] && kill "$pid" 2>/dev/null
rm -rf "$td"

"$PY" - "$OX_ROOT/shell/extensions/ai/tree/assets/dictation/speech.py" <<'PY' && ok "speech is cut into phrases at pauses, and noise is not typed" || no "the phrase splitter or noise filter is wrong"
import array, importlib.util, json, math, pathlib, random, sys, tempfile
source = pathlib.Path(sys.argv[1])
with tempfile.TemporaryDirectory() as d:
    (pathlib.Path(d) / "speech.py").write_text(source.read_text())
    (pathlib.Path(d) / "speech.json").write_text(json.dumps({"model": {"file": "m.bin", "bytes": 1}}))
    spec = importlib.util.spec_from_file_location("speech", f"{d}/speech.py")
    sp = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(sp)
rate = sp.RATE
def noise(seconds, amp):
    return array.array("h", (random.randint(-amp, amp) for _ in range(int(rate * seconds)))).tobytes()
def tone(seconds):
    return array.array("h", (int(8000 * math.sin(2 * math.pi * 220 * i / rate)) for i in range(int(rate * seconds)))).tobytes()
def mix(a, b):
    x, y = array.array("h", a), array.array("h", b)
    return array.array("h", (max(-32768, min(32767, p + q)) for p, q in zip(x, y))).tobytes()
# A quiet room (about -60 dBFS) and a noisy microphone (about -27 dBFS), with the
# noise under the speech as well as between it.
for amp in (40, 2500):
    stream = noise(1, amp) + mix(tone(1.5), noise(1.5, amp)) + noise(1.2, amp) + mix(tone(2), noise(2, amp)) \
        + noise(1, amp) + mix(tone(0.1), noise(0.1, amp)) + noise(1, amp)
    seg, phrases = sp.Segmenter(), []
    for i in range(0, len(stream), sp.FRAME * 2):
        if (p := seg.push(stream[i:i + sp.FRAME * 2])) is not None:
            phrases.append(p)
    if (p := seg.flush()) is not None:
        phrases.append(p)
    lengths = [round(len(p) / 2 / rate, 1) for p in phrases]
    # Two phrases, each ending soon after its speech; the 100 ms click is dropped.
    assert len(phrases) == 2 and 1.5 <= lengths[0] <= 3 and 2 <= lengths[1] <= 3.5, (amp, lengths)
assert sp.clean(" you ") == "" and sp.clean("[BLANK_AUDIO]") == "" and sp.clean("(music)") == ""
assert sp.clean("  Hello   there. ") == "Hello there."
assert sp.clean("Ask what you can do. Ask what you can do.") == "Ask what you can do."
assert sp.clean("bright, bright, bright, bright, bright") == "bright, bright,"
PY
n=$(grep -c '^bind_to("kbDictation"' "$OX_ROOT/overrides/caelestia/hypr-user.lua")
[ "$n" = 1 ] && ok "hypr-user.lua binds the dictation key once" || no "kbDictation is bound $n times"

