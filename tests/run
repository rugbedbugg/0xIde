#!/usr/bin/env bash
# Repository validation with isolated fixtures and disposable test processes.
# Nothing installs; desktop clipboard checks run only when Wayland is available.
set -uo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../orchestration/lib/common.sh"

pass=0; fail=0; skip=0
ok()   { printf '  \033[32mok\033[0m    %s\n' "$*"; pass=$((pass+1)); }
no()   { printf '  \033[31mFAIL\033[0m  %s\n' "$*"; fail=$((fail+1)); }
skipt(){ printf '  skip  %s\n' "$*"; skip=$((skip+1)); }
check(){ if "$@" >/dev/null 2>&1; then return 0; else return 1; fi; }

PY="$(ox_python)"
# Compiling a checker must not leave __pycache__ in the working tree.
export PYTHONDONTWRITEBYTECODE=1

# The --exclude arguments of shell/build.sh's shell deploy, read from the
# script itself so the checks below run the real patterns, not a copy.
deploy_excludes() {
    awk '/^rsync -a --delete \\$/{f=1} f{print} f&&/OX_SHELLDIR\/"$/{exit}' "$OX_ROOT/shell/build.sh" |
        grep -oE -- "--exclude '[^']+'" | sed -E "s/^--exclude '(.*)'$/--exclude=\1/"
}

ox_step "Shell script syntax"
while IFS= read -r f; do
    head -1 "$f" | grep -q 'bin/\(env \)\?\(ba\)\?sh' || continue
    if bash -n "$f" 2>/dev/null; then ok "${f#$OX_ROOT/}"; else no "${f#$OX_ROOT/}"; fi
done < <(find "$OX_ROOT" -path "$OX_ROOT/.git" -prune -o -path "$OX_ROOT/build" -prune -o -path "$OX_ROOT/.work" -prune -o -type f -perm -u+x -print; echo "$OX_ROOT/orchestration/lib/common.sh")

ox_step "Python syntax"
while IFS= read -r f; do
    if "$PY" -m py_compile "$f" 2>/dev/null; then ok "${f#$OX_ROOT/}"; else no "${f#$OX_ROOT/}"; fi
done < <(find "$OX_ROOT" -path "$OX_ROOT/build" -prune -o -path "$OX_ROOT/.work" -prune -o -name '*.py' -print
         printf '%s\n' "$OX_ROOT/tests/unnova-live"
         find "$OX_ROOT/adapters" -name apply -exec grep -l '^#!/usr/bin/python3' {} +)

ox_step "JSON and TOML"
while IFS= read -r f; do
    if "$PY" -c 'import json,sys;json.load(open(sys.argv[1]))' "$f"; then ok "${f#$OX_ROOT/}"; else no "${f#$OX_ROOT/}"; fi
done < <(find "$OX_ROOT/overrides" "$OX_ROOT/adapters" -name '*.json' ! -name '*.template.json')
for f in "$OX_ROOT"/manifests/*.toml; do
    if "$PY" -c 'import tomllib,sys;tomllib.load(open(sys.argv[1],"rb"))' "$f"; then ok "${f#$OX_ROOT/}"; else no "${f#$OX_ROOT/}"; fi
done

ox_step "Lua"
if ox_have luac || ox_have lua; then
    for f in "$OX_ROOT"/overrides/caelestia/*.lua; do
        if check luac -p "$f" || check lua -e "assert(loadfile('$f'))"; then ok "${f#$OX_ROOT/}"; else no "${f#$OX_ROOT/}"; fi
    done
else skipt "no lua interpreter"; fi

ox_step "Patches apply to the pinned revision"
SRC="$OX_BUILD/shell-src"
if [ -d "$SRC/.git" ]; then
    rev="$(ox_pin "$OX_ROOT/shell/upstream.pin" rev)"
    tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
    git -C "$SRC" worktree add -q --detach "$tmp" "$rev" 2>/dev/null
    install -Dm644 "$OX_ROOT/shell/plugin/src/aiconfig.hpp"  "$tmp/plugin/src/Caelestia/Config/aiconfig.hpp"
    install -Dm644 "$OX_ROOT/shell/plugin/src/airequest.hpp" "$tmp/plugin/src/Caelestia/airequest.hpp"
    install -Dm644 "$OX_ROOT/shell/plugin/src/airequest.cpp" "$tmp/plugin/src/Caelestia/airequest.cpp"
    install -Dm644 "$OX_ROOT/shell/plugin/src/procfs.hpp" "$tmp/plugin/src/Caelestia/Services/procfs.hpp"
    install -Dm644 "$OX_ROOT/shell/plugin/src/procfs.cpp" "$tmp/plugin/src/Caelestia/Services/procfs.cpp"
    install -Dm644 "$OX_ROOT/shell/plugin/src/processes.hpp" "$tmp/plugin/src/Caelestia/Services/processes.hpp"
    install -Dm644 "$OX_ROOT/shell/plugin/src/processes.cpp" "$tmp/plugin/src/Caelestia/Services/processes.cpp"
    for p in "$OX_ROOT"/shell/plugin/patches/*.patch "$OX_ROOT"/shell/patches/*.patch; do
        if git -C "$tmp" apply --check "$p" 2>/dev/null && git -C "$tmp" apply "$p" 2>/dev/null
        then ok "$(basename "$p")"; else no "$(basename "$p") does not apply to ${rev:0:9}"; fi
    done

    # Checked on the patched file rather than the diff: a diff also contains
    # the lines the patch removes.
    AP="$tmp/modules/areapicker/AreaPicker.qml"
    if [ -f "$AP" ]; then
        # Every shortcut must open the picker through an IpcHandler function,
        # because those are the one place the mode flags are reset. Upstream's
        # screenshot shortcuts each carried their own copy of that reset, and
        # the copy did not know about searchMode, so SUPER+SHIFT+S ran a web
        # search after one.
        n=$(grep -c 'onPressed: pickerIpc\.' "$AP")
        m=$(grep -c 'onPressed: {' "$AP")
        if [ "$m" = 0 ] && [ "$n" -ge 7 ]
        then ok "all $n picker shortcuts reset state through one place"
        else no "$m picker shortcut(s) still set state inline"; fi

        # And that one place has to clear every flag, for every entry point.
        if "$PY" - "$AP" <<'CHK'
import re, sys
src = open(sys.argv[1]).read()
funcs = re.findall(r"function (open\w*|regionSearch|circleSearch)\(\): void \{(.*?)\n        \}", src, re.S)
need = {"freeze", "closing", "clipboardOnly", "ocr", "askAi", "searchMode", "activeAsync"}
missing = {n: sorted(need - set(re.findall(r"root\.(\w+) =", b))) for n, b in funcs}
missing = {n: v for n, v in missing.items() if v}
for n, v in missing.items():
    print(f"        {n}() never sets: {', '.join(v)}")
sys.exit(1 if missing or len(funcs) < 8 else 0)
CHK
        then ok "every picker entry point clears every mode flag"
        else no "a picker entry point leaves a mode flag set"; fi
    fi

    # Deploy the patched upstream tree with the real exclusions into an empty
    # directory, as a fresh install would, and check that every script a QML
    # file imports arrived. utils/Searcher.qml importing scripts/fzf.js is the
    # case an unanchored "scripts" exclusion broke.
    if ox_have rsync; then
        mapfile -t excl < <(deploy_excludes)
        dep="$(mktemp -d)"
        rsync -a --delete "${excl[@]}" "$tmp/" "$dep/"
        missing=""
        while IFS= read -r qml; do
            while IFS= read -r js; do
                [ -f "$(dirname "$qml")/$js" ] || missing="$missing ${qml#$dep/} -> $js"
            done < <(grep -oE '^import "[^"]+\.js"' "$qml" | sed -E 's/^import "(.*)"$/\1/')
        done < <(find "$dep" -name '*.qml')
        if [ -z "$missing" ] && [ -f "$dep/utils/scripts/fzf.js" ]
        then ok "a fresh deploy keeps every script the QML imports"
        else no "a fresh deploy is missing imported scripts:$missing"; fi
        rm -rf "$dep"
    fi

    git -C "$SRC" worktree remove --force "$tmp" 2>/dev/null
else skipt "no upstream checkout yet (run ./shell/build.sh)"; fi

ox_step "No machine-specific values are committed"
# An empty pattern would match every line, so only search for values that exist.
declare -a MACHINE=()
for v in "$(id -un)" "$(uname -n)"; do [ -n "$v" ] && MACHINE+=(-e "$v"); done
if [ ${#MACHINE[@]} -gt 0 ] &&
   git -C "$OX_ROOT" grep -qIn "${MACHINE[@]}" -- . ':!*.md' ':!LICENSE' 2>/dev/null; then
    no "a username or hostname appears in a tracked file:"
    git -C "$OX_ROOT" grep -In "${MACHINE[@]}" -- . ':!*.md' ':!LICENSE' | sed 's/^/        /'
else ok "no username or hostname is committed"; fi
if git -C "$OX_ROOT" grep -qIn -e '/home/[a-z]' -- . ':!*.md' 2>/dev/null; then
    no "an absolute home path appears in a tracked file"
else ok "no absolute home paths are committed"; fi

ox_step "Documentation stays README-first"
# Spelt indirectly so this file does not match its own search.
d=doc"s"
if [ -n "$(git -C "$OX_ROOT" ls-files "$d" "$d/*")" ]; then
    no "a tracked $d/ directory is back; this project is README-first"
else ok "no tracked $d/ directory"; fi
if git -C "$OX_ROOT" grep -qIn "$d/" -- . ':!LICENSE' 2>/dev/null; then
    no "a tracked file still links into $d/:"
    git -C "$OX_ROOT" grep -In "$d/" -- . ':!LICENSE' | sed 's/^/        /'
else ok "nothing links into a $d/ path"; fi
# Every remaining markdown file must sit beside the component it explains.
bad=0
while IFS= read -r f; do
    [ "$f" = README.md ] && continue
    dir="$(dirname "$f")"
    if [ -z "$(find "$OX_ROOT/$dir" -mindepth 1 -maxdepth 1 ! -name '*.md' -print -quit)" ]; then
        no "$f has no component beside it; fold it into README.md"; bad=1
    fi
done < <(git -C "$OX_ROOT" ls-files '*.md')
[ "$bad" = 0 ] && ok "every component README sits beside the component it explains"

ox_step "No generated state is committed"
bad=0
for pat in 'build/' 'scheme.json' 'sequences.txt' 'apps.sqlite' 'notifs.json' \
           'kdeglobals' '*.gguf' '*.so' '__pycache__' 'color.ini'; do
    if git -C "$OX_ROOT" ls-files --error-unmatch "$pat" >/dev/null 2>&1 ||
       [ -n "$(git -C "$OX_ROOT" ls-files "*$pat*" 2>/dev/null)" ]; then
        no "generated state is tracked: $pat"; bad=1
    fi
done
[ "$bad" = 0 ] && ok "no caches, models, compiled output or Caelestia runtime state tracked"

ox_step "Shell layer is complete"
for f in shell/upstream.pin shell/build.sh \
         shell/plugin/src/aiconfig.hpp shell/plugin/src/airequest.hpp shell/plugin/src/airequest.cpp \
         shell/plugin/src/procfs.hpp shell/plugin/src/procfs.cpp shell/plugin/src/processes.hpp shell/plugin/src/processes.cpp; do
    if [ -s "$OX_ROOT/$f" ]; then ok "$f"; else no "$f is missing or empty"; fi
done
n=$(ls "$OX_ROOT"/shell/patches/*.patch 2>/dev/null | wc -l)
[ "$n" -gt 0 ] && ok "$n shell patch(es) present" || no "no shell patches"
n=$(ls "$OX_ROOT"/shell/plugin/patches/*.patch 2>/dev/null | wc -l)
[ "$n" -gt 0 ] && ok "$n plugin patch(es) present" || no "no plugin registration patch"
# The types the extensions cannot load without.
for t in AiConfig backend backendUrl model systemPrompt ocrLanguages translateLanguage tableMode; do
    grep -q "$t" "$OX_ROOT/shell/plugin/src/aiconfig.hpp" || no "aiconfig.hpp no longer declares $t"
done
grep -q "class AiRequest" "$OX_ROOT/shell/plugin/src/airequest.hpp" &&
    ok "plugin still declares both recovered types" || no "airequest.hpp lost AiRequest"

ox_step "Shell deploy exclusions"
# rsync matches an unanchored exclude at any depth, so "scripts" also removed
# upstream's utils/scripts/. Runs the real patterns over a fixture: top-level
# build entries must go, same-named nested ones must stay.
if ! ox_have rsync; then skipt "no rsync"
else
    mapfile -t excl < <(deploy_excludes)
    if [ ${#excl[@]} -eq 0 ]; then
        no "could not read the deploy exclusions from shell/build.sh"
    else
        fx="$(mktemp -d)"
        for f in scripts/lint.py plugin/CMakeLists.txt nix/package.nix extras/x flake.nix flake.lock \
                 CMakeLists.txt .git/HEAD assets/ai/__pycache__/runtime.pyc \
                 utils/scripts/fzf.js utils/scripts/fuzzysort.js modules/plugin/Page.qml \
                 modules/nix/Page.qml modules/extras/Page.qml modules/scripts/helper.js shell.qml; do
            mkdir -p "$fx/src/$(dirname "$f")"; : > "$fx/src/$f"
        done
        mkdir -p "$fx/dst"
        rsync -a --delete "${excl[@]}" "$fx/src/" "$fx/dst/"
        bad=0
        for f in scripts plugin nix extras flake.nix flake.lock CMakeLists.txt .git assets/ai/__pycache__; do
            [ -e "$fx/dst/$f" ] && { no "the deploy copies $f, which it should leave out"; bad=1; }
        done
        for f in utils/scripts/fzf.js utils/scripts/fuzzysort.js modules/plugin/Page.qml \
                 modules/nix/Page.qml modules/extras/Page.qml modules/scripts/helper.js shell.qml; do
            [ -e "$fx/dst/$f" ] || { no "the deploy drops $f, a nested path it should keep"; bad=1; }
        done
        [ "$bad" = 0 ] && ok "top-level build entries are excluded, nested same-named ones are kept"
        rm -rf "$fx"
    fi
fi

ox_step "Safe defaults"
# Nothing needing root may be installed by a plain ./install.
bad=0
while IFS= read -r line; do
    name=$(printf '%s' "$line" | awk -F: '{gsub(/ /,"",$1);print $1}')
    kind=$(printf '%s' "$line" | awk -F: '{gsub(/ /,"",$2);print $2}')
    dflt=$(printf '%s' "$line" | awk -F: '{gsub(/ /,"",$3);print $3}')
    if [ "$kind" = system ] && [ "$dflt" = on ]; then no "$name needs root but is on by default"; bad=1; fi
    if [ "$kind" = adapter ] && [ "$dflt" = on ] &&
       [ "$(ox_pin "$OX_ROOT/adapters/$name/adapter.conf" privileges)" = root ] &&
       [ "$name" != papirus ]; then
        no "$name requires root but is on by default"; bad=1
    fi
done < <(grep -vE '^\s*(#|$)' "$OX_ROOT/installer/components.conf")
[ "$bad" = 0 ] && ok "no root-requiring component is enabled by default"

# The privacy default that matters: region search must not upload out of the box.
rs="$OX_ROOT/shell/extensions/search/tree/assets/search/region_search.sh"
if grep -qE '^mode="text"' "$rs"; then ok "a dragged rectangle defaults to local OCR, no upload"
else no "the rectangle gesture no longer defaults to the non-uploading mode"; fi
if grep -qE '^confirm="always"' "$rs"; then ok "any upload confirms by default"
else no "region search no longer confirms before uploading"; fi
if grep -qE '"\$mode" == "off"' "$rs"; then ok "region search can be disabled entirely"
else no "region search lost its off switch"; fi
if grep -q 'ask "Send this region to lens.google.com?"' "$rs" && grep -q 'ask "Upload this region to' "$rs"
then ok "every upload prompt names where the image goes"
else no "an upload prompt no longer names where the image goes"; fi

# No privileged side effect may happen without a prompt.
# Prose that tells you not to do it is not doing it, so markdown is excluded.
if grep -rnE --exclude='*.md' '\bchown\b|chmod -R (a\+w|go\+w|777)' \
      "$OX_ROOT/adapters" "$OX_ROOT/orchestration" \
      "$OX_ROOT/installer" "$OX_ROOT/install" 2>/dev/null | grep -qv '^\s*#'; then
    no "a chown or broad chmod appears outside system/"
else ok "no chown or world-writable chmod outside system/"
fi

ox_step "Region search gestures"
# Driven for real, with xdg-open, notify-send and fuzzel stubbed and a private
# XDG_CONFIG_HOME, so nothing is opened, notified or uploaded.
if ! ox_have tesseract || ! ox_have magick || ! ox_have jq; then
    skipt "tesseract, magick or jq is missing"
else
    sdir="$(mktemp -d)"
    mkdir -p "$sdir/bin" "$sdir/conf"
    cat > "$sdir/bin/xdg-open" <<STUB
#!/bin/sh
printf '%s' "\$1" > "$sdir/opened"
STUB
    cat > "$sdir/bin/notify-send" <<STUB
#!/bin/sh
exit 0
STUB
    cat > "$sdir/bin/fuzzel" <<STUB
#!/bin/sh
cat >/dev/null
prev=""
for a in "\$@"; do
    [ "\$prev" = "--prompt" ] && printf '%s' "\$a" > "$sdir/prompt"
    prev="\$a"
done
printf 'Cancel\n'
STUB
    chmod +x "$sdir/bin/xdg-open" "$sdir/bin/notify-send" "$sdir/bin/fuzzel"
    # A font file fontconfig resolves, not ImageMagick's default Helvetica,
    # which only Ghostscript's fonts provide.
    magick -background white -fill black -font "$(fc-match -f '%{file}' sans)" -pointsize 60 \
        label:'REGION SEARCH PROBE' "$sdir/probe.png" 2>/dev/null

    # A dragged rectangle resolves locally to a text search.
    cp "$sdir/probe.png" "$sdir/rect.png"
    PATH="$sdir/bin:$PATH" XDG_CONFIG_HOME="$sdir/conf" \
        bash "$rs" "$sdir/rect.png" rectangle >/dev/null 2>&1 || true
    sleep 1
    case "$(cat "$sdir/opened" 2>/dev/null)" in
        *google.com/search*REGION*) ok "a rectangle searches the recognised text" ;;
        *lens.google.com*) no "a rectangle uploaded the image instead of reading it" ;;
        *) no "a rectangle opened nothing" ;;
    esac
    [ -e "$sdir/rect.png" ] && no "the rectangle capture was not removed" ||
        ok "the rectangle capture is removed"

    # A drawn circle takes the visual path, which has to ask before uploading.
    rm -f "$sdir/opened" "$sdir/prompt"
    cp "$sdir/probe.png" "$sdir/circle.png"
    PATH="$sdir/bin:$PATH" XDG_CONFIG_HOME="$sdir/conf" \
        bash "$rs" "$sdir/circle.png" circle >/dev/null 2>&1 || true
    sleep 1
    case "$(cat "$sdir/prompt" 2>/dev/null)" in
        *lens.google.com*) ok "a circle asks before sending, naming Google Lens" ;;
        "") no "a circle did not ask before sending" ;;
        *) no "the circle prompt no longer names Google Lens" ;;
    esac
    [ -s "$sdir/opened" ] && no "declining the prompt still opened a search" ||
        ok "declining the prompt uploads nothing and opens nothing"
    [ -e "$sdir/circle.png" ] && no "the circle capture was not removed" ||
        ok "the circle capture is removed"

    # Accepted, the browser itself posts the image to Lens: Lens ties its
    # results to the cookie that upload sets, so an upload made by the script
    # opens an empty results page. Nothing here may upload with curl.
    cat > "$sdir/bin/fuzzel" <<STUB
#!/bin/sh
cat >/dev/null
printf 'Send the image\n'
STUB
    cat > "$sdir/bin/curl" <<STUB
#!/bin/sh
printf '%s\n' "\$@" > "$sdir/curl-args"
STUB
    chmod +x "$sdir/bin/fuzzel" "$sdir/bin/curl"
    rm -f "$sdir/opened" "$sdir/curl-args"
    mkdir -p "$sdir/run"
    cp "$sdir/probe.png" "$sdir/sent.png"
    b64="$(base64 -w0 "$sdir/probe.png")"
    PATH="$sdir/bin:$PATH" XDG_CONFIG_HOME="$sdir/conf" XDG_RUNTIME_DIR="$sdir/run" \
        bash "$rs" "$sdir/sent.png" circle >/dev/null 2>&1 || true
    sleep 1
    opened="$(cat "$sdir/opened" 2>/dev/null)"
    page="${opened#file://}"
    if [[ "$opened" == "file://$sdir/run/0xide-search/lens-"*.html ]] && [ -f "$page" ] &&
        grep -q 'action="https://lens.google.com/v3/upload"' "$page" &&
        grep -q 'name="encoded_image"' "$page" && grep -qF "$b64" "$page" &&
        [ ! -e "$sdir/curl-args" ] && ! grep -qiE 'uguu|uploadbyurl' "$page"
    then ok "an accepted circle has the browser post the image to Google Lens alone"
    else no "an accepted circle did not hand the image to the browser for Lens (opened: ${opened:-nothing})"; fi
    [ "$(stat -c %a "$sdir/run/0xide-search" 2>/dev/null)" = 700 ] &&
        ok "the page carrying the image is private to the user" ||
        no "the handoff directory is not private"
    rm -f "$sdir/bin/curl"
    printf '#!/bin/sh\ncat >/dev/null\nprintf "Cancel\\n"\n' > "$sdir/bin/fuzzel"

    # One line in the config still overrides the gesture for both.
    rm -f "$sdir/opened"
    printf 'mode="text"\n' > "$sdir/conf/region-search.conf"
    mkdir -p "$sdir/conf/0xide"
    mv "$sdir/conf/region-search.conf" "$sdir/conf/0xide/region-search.conf"
    cp "$sdir/probe.png" "$sdir/forced.png"
    PATH="$sdir/bin:$PATH" XDG_CONFIG_HOME="$sdir/conf" \
        bash "$rs" "$sdir/forced.png" circle >/dev/null 2>&1 || true
    sleep 1
    case "$(cat "$sdir/opened" 2>/dev/null)" in
        *google.com/search*) ok "mode=text in the config overrides the circle gesture" ;;
        *) no "the config no longer overrides the gesture" ;;
    esac
    rm -rf "$sdir"
fi

ox_step "Text extraction"
OCRQML="$OX_ROOT/shell/extensions/ocr/tree/services/Ocr.qml"
PICKER="$OX_ROOT/shell/patches/0002-areapicker-add-OCR-and-region-circle-search-capture-.patch"

# The two things the extractor cannot work without have to be declared.
for dep in tesseract wl-copy; do
    if grep -qE "^report (required|optional) $dep " "$OX_ROOT/installer/check_deps.sh"
    then ok "$dep is declared as an OCR dependency"
    else no "$dep is not declared in check_deps.sh"; fi
done

# The extractor must not be able to reach the AI at all.
if grep -qE 'AiRuntime|AiRequest|backendUrl|systemPrompt' "$OCRQML"
then no "the OCR service references the AI backend"
else ok "text extraction cannot reach the AI backend"; fi

# The normal path always reaches the clipboard, and always reports what it
# found so the panel can show it.
if grep -q '"wl-copy"' "$OCRQML"
then ok "the OCR service copies to the Wayland clipboard"
else no "the OCR service no longer copies its result"; fi
if grep -q 'copy.running = true' "$OCRQML"
then ok "the capture path copies its result"
else no "the capture path no longer copies its result"; fi

# The contract: the ordinary extractor ends at the clipboard. It must not be
# able to report anything, because reporting is what opens the result panel.
if awk '/function capture\(path: string\): void/{f=1} f&&/^    }/{exit} f&&/recognized|captureForPanel|scan\(/{print}' "$OCRQML" | grep -q .
then no "capture() can reach the panel path"
else ok "capture() ends at the clipboard and reports nothing"; fi
if grep -q 'if (report)' "$OCRQML"
then ok "only an explicit panel capture reports"
else no "reporting is no longer gated on an explicit panel capture"; fi
if awk '/root.loader.askAi/{f=1} f&&/Ocr.capture\(path\)/{found=1} END{exit !found}' "$PICKER"
then ok "the picker sends the ordinary path to the silent extractor"
else no "the picker no longer distinguishes the two OCR calls"; fi

# The two OCR actions, one bound and one deliberately not.
n=$(grep -c 'name: "screenshotOcr"' "$PICKER")
[ "$n" = 1 ] && ok "one keybound text extraction action" ||
    no "found $n text extraction actions, expected 1"
n=$(grep -c 'name: "askAi"' "$PICKER")
[ "$n" = 1 ] && ok "one explicit AI-assisted action, registered" ||
    no "found $n AI-assisted actions, expected 1"

# Web search has one key; the shape is chosen in the selector, not by which
# key you pressed.
n=$(grep -c '^bind("kb' "$OX_ROOT/overrides/caelestia/hypr-user.lua")
[ "$n" = 2 ] && ok "two keybindings in total, extraction and web search" ||
    no "hypr-user.lua binds $n actions, expected 2"
if grep -q 'PickerModes' "$PICKER" &&
   [ -s "$OX_ROOT/shell/extensions/search/tree/modules/areapicker/PickerModes.qml" ]
then ok "the selector offers the search shape as a control"
else no "the search shape can no longer be chosen in the selector"; fi

# Runtime discovery must never write a preference.
AIRUNTIME="$OX_ROOT/shell/extensions/ai/tree/services/AiRuntime.qml"
if grep -q 'GlobalConfig.ai.backend *=' "$AIRUNTIME"
then no "AiRuntime still writes the backend preference"
else ok "runtime discovery does not touch the backend preference"; fi
bad=0
while IFS= read -r f; do
    if grep -n 'onEditingFinished: GlobalConfig' "$f" >/dev/null 2>&1; then
        no "${f#$OX_ROOT/} persists a field the user may not have changed"; bad=1
    fi
done < <(git -C "$OX_ROOT" ls-files 'shell/extensions/*.qml' | sed "s|^|$OX_ROOT/|")
[ "$bad" = 0 ] && ok "no field writes a preference it did not change"

# A selection too small to hold text is rejected before anything is captured.
if awk '/readonly property int minSelection/{print $NF}' "$PICKER" | grep -qE '^[2-9]|^1[0-9]'
then ok "a too-small selection is rejected before capture"
else no "the selector no longer rejects a too-small selection"; fi

# The selection is made against a frozen screen.
if awk '/function openOcr/{f=1} f&&/freeze = true/{found=1;exit} END{exit !found}' "$PICKER"
then ok "the OCR selector freezes the screen"
else no "the OCR selector no longer freezes the screen"; fi

# Every path that ends an extraction has to remove the capture.
if grep -q 'CUtils.deleteFile' "$OCRQML"
then ok "the OCR service deletes the capture it was given"
else no "the OCR service no longer deletes its capture"; fi

# Superseded entry points must be gone, not merely unbound.
bad=0
for dead in ocrClipboard openOcrClipboard openFreezeOcr screenshotFreezeOcr regionOcr kbAskAi kbCircleSearch; do
    if git -C "$OX_ROOT" grep -qIn "$dead" -- . ':!tests/run' 2>/dev/null; then
        no "the superseded OCR entry point $dead is still referenced"; bad=1
    fi
done
[ -e "$OX_ROOT/shell/extensions/ocr/tree/assets/ocr/capture.sh" ] &&
    { no "the grim/slurp capture helper is back"; bad=1; }
for dead in grim slurp; do
    if git -C "$OX_ROOT" grep -qIn "\\b$dead\\b" -- . ':!*.md' ':!tests/run' 2>/dev/null; then
        no "$dead is referenced but nothing uses it any more"; bad=1
    fi
done
[ "$bad" = 0 ] && ok "no superseded OCR capture path remains"

# Exactly one binding, in the override point Caelestia supports.
n=$(grep -c 'kbOcrScreenshot' "$OX_ROOT/overrides/caelestia/hypr-vars.lua")
[ "$n" = 1 ] && ok "hypr-vars.lua defines the extraction key once" ||
    no "hypr-vars.lua mentions kbOcrScreenshot $n times, expected 1"
n=$(grep -c '^bind("kbOcrScreenshot"' "$OX_ROOT/overrides/caelestia/hypr-user.lua")
[ "$n" = 1 ] && ok "hypr-user.lua binds it once" ||
    no "hypr-user.lua binds kbOcrScreenshot $n times, expected 1"

ox_step "Text extraction, end to end"
# The real pipeline on a known image: tesseract, then the clipboard.
if ! ox_have tesseract; then skipt "tesseract not installed"
elif ! ox_have magick; then skipt "no magick to render a test image"
else
    ocrtmp="$(mktemp -d)"
    magick -background white -fill black -font "$(fc-match -f '%{file}' sans)" -pointsize 64 \
        label:'CAELESTIA OCR TEST' "$ocrtmp/sample.png" 2>/dev/null
    langs=$(tesseract --list-langs 2>/dev/null | tail -n +2 | grep -vx osd | paste -sd+)
    got="$(tesseract "$ocrtmp/sample.png" - -l "${langs:-eng}" 2>/dev/null | tr -d '\n' | tr -s ' ')"
    case "$got" in
        *CAELESTIA*OCR*TEST*) ok "tesseract reads the test image: $got" ;;
        *) no "tesseract did not read the test image, got: $got" ;;
    esac
    if [ -n "${WAYLAND_DISPLAY:-}" ] && ox_have wl-copy && ox_have wl-paste; then
        # wl-copy stays behind to serve the clipboard, so it must not inherit
        # this script's output: a pipe reading the suite would never see EOF.
        before="$(wl-paste 2>/dev/null || true)"
        wl-copy -n -- "$got" </dev/null >/dev/null 2>&1
        case "$(wl-paste 2>/dev/null)" in
            *CAELESTIA*) ok "the recognised text reaches the Wayland clipboard" ;;
            *) no "the recognised text did not reach the clipboard" ;;
        esac
        if [ -n "$before" ]; then wl-copy -n -- "$before" </dev/null >/dev/null 2>&1
        else wl-copy --clear </dev/null >/dev/null 2>&1; fi
    else skipt "no Wayland clipboard to check"; fi
    rm -rf "$ocrtmp"
fi

ox_step "Widget style follows the scheme mode"
# dconf writes go through the session bus service, which ignores a private
# XDG_CONFIG_HOME, so dconf is stubbed instead. Without that this test would
# rewrite the real desktop settings.
if ! ox_have dconf; then skipt "no dconf"
elif [ ! -d /usr/share/themes/adw-gtk3 ] || ! ls /usr/lib/qt*/plugins/styles/breeze*.so >/dev/null 2>&1; then
    skipt "adw-gtk3 or the Breeze Qt style is not installed"
else
    td="$(mktemp -d)"
    mkdir -p "$td/conf/qtengine" "$td/conf/gtk-3.0" "$td/state" "$td/bin"
    cat > "$td/bin/dconf" <<STUB
#!/bin/sh
printf '%s\n' "\$*" >> "$td/dconf.log"
STUB
    chmod +x "$td/bin/dconf"
    printf '[General]\nColorScheme=Caelestia\nName=Caelestia\n\n[Colors:Window]\nBackgroundNormal=#ffffff\n' \
        > "$td/conf/qtengine/caelestia.colors"
    printf '{"theme":{"style":"Darkly","iconTheme":"Papirus-Light"}}\n' > "$td/conf/qtengine/config.json"
    printf '[Settings]\ngtk-font-name=Sans 10\ngtk-theme-name=adw-gtk3-dark\n' > "$td/conf/gtk-3.0/settings.ini"

    probe() { # mode -> "<qt style> <gtk theme>"
        printf '{"mode":"%s"}\n' "$1" > "$td/state/scheme.json"
        PATH="$td/bin:$PATH" XDG_CONFIG_HOME="$td/conf" OX_SCHEME="$td/state/scheme.json" \
            "$OX_ROOT/adapters/kde/apply" >/dev/null 2>&1
        printf '%s %s' \
            "$("$PY" -c 'import json,sys;print(json.load(open(sys.argv[1]))["theme"]["style"])' "$td/conf/qtengine/config.json")" \
            "$(grep -oP '(?<=^gtk-theme-name=).*' "$td/conf/gtk-3.0/settings.ini")"
    }

    got="$(probe light)"
    [ "$got" = "Breeze adw-gtk3" ] && ok "a light scheme selects a light style ($got)" ||
        no "a light scheme gave '$got', expected 'Breeze adw-gtk3'"
    got="$(probe dark)"
    [ "$got" = "Darkly adw-gtk3-dark" ] && ok "a dark scheme selects a dark style ($got)" ||
        no "a dark scheme gave '$got', expected 'Darkly adw-gtk3-dark'"
    # Going through dconf is what updates GTK applications that are already open.
    if grep -q 'gtk-theme' "$td/dconf.log" && grep -q 'color-scheme' "$td/dconf.log"
    then ok "the style is also written through dconf, so open apps follow"
    else no "the style is not written through dconf; open apps would not update"; fi
    rm -rf "$td"
fi

ox_step "Cursor adapter"
# A one-shape Sweet stands in for the real one: its body is Sweet's #161925
# filling the whole canvas, so the rendered pixel shows what it became.
# gsettings and hyprctl are stubbed and HOME is private, so nothing here
# touches the real desktop.
if ! ox_have rsvg-convert || ! ox_have xcursorgen; then skipt "no rsvg-convert or xcursorgen"
else
    td="$(mktemp -d)"
    src="$td/data/icons/Sweet-cursors/cursors_scalable"
    mkdir -p "$src/default" "$td/conf/gtk-3.0" "$td/home/.icons/default" "$td/state" "$td/bin"
    printf '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32"><rect width="32" height="32" style="fill:#161925"/></svg>\n' \
        > "$src/default/default.svg"
    printf '[{"filename":"default.svg","hotspot_x":0.125,"hotspot_y":0.125,"nominal_size":24}]\n' > "$src/default/metadata.json"
    ln -s default "$src/arrow"
    ln -s arrow "$src/left_ptr"
    printf '{"mode":"dark","colours":{"primary":"b4c8e9","secondary":"bdc7dc","tertiary":"d9bde2","surface":"123456","onSurface":"e3e2e6","error":"ffb4ab"}}\n' \
        > "$td/state/scheme.json"
    printf '[Settings]\ngtk-font-name=Sans 10\ngtk-cursor-theme-name=breeze_cursors\n' > "$td/conf/gtk-3.0/settings.ini"
    printf '[Icon Theme]\nName=Default\nInherits=Sweet-cursors\n' > "$td/home/.icons/default/index.theme"
    for stub in gsettings hyprctl; do
        printf '#!/bin/sh\nprintf "%%s\\n" "%s $*" >> "%s/calls.log"\n' "$stub" "$td" > "$td/bin/$stub"
        chmod +x "$td/bin/$stub"
    done
    cursor() {
        HOME="$td/home" PATH="$td/bin:$PATH" XDG_DATA_HOME="$td/data" XDG_DATA_DIRS="$td/none" XDG_CONFIG_HOME="$td/conf" \
            OX_SCHEME="$td/state/scheme.json" HYPRLAND_INSTANCE_SIGNATURE=test XCURSOR_SIZE=24 \
            "$OX_ROOT/adapters/cursor/apply"
    }
    theme="$td/data/icons/0xide-sweet"

    cursor >/dev/null 2>&1
    if [ -f "$theme/cursors/default" ] && [ -r "$theme/index.theme" ]
    then ok "Sweet is rebuilt as 0xide-sweet"; else no "no 0xide-sweet theme was built"; fi
    [ "$(readlink "$theme/cursors/left_ptr")" = default ] &&
        ok "an alias of an alias still resolves to the real shape" ||
        no "left_ptr -> arrow -> default was not kept as a working alias"
    # First image of the XCursor file: 36-byte image header, then ARGB pixels.
    px="$("$PY" - "$theme/cursors/default" <<'PY'
import struct, sys
d = open(sys.argv[1], "rb").read()
n = struct.unpack("<I", d[12:16])[0]
pos = min(struct.unpack("<III", d[16 + 12 * i:28 + 12 * i])[2] for i in range(n))
w, h = struct.unpack("<II", d[pos + 16:pos + 24])
print("%06x" % (struct.unpack("<I", d[pos + 36 + 4 * (h // 2 * w + w // 2):][:4])[0] & 0xFFFFFF))
PY
)"
    [ "$px" = 123456 ] && ok "Sweet's body is drawn in the scheme's surface (#$px)" ||
        no "the body pixel is #$px, expected the surface #123456"
    grep -qx 'gtk-cursor-theme-name=0xide-sweet' "$td/conf/gtk-3.0/settings.ini" &&
        grep -qx 'gtk-font-name=Sans 10' "$td/conf/gtk-3.0/settings.ini" &&
        ok "GTK's stale cursor setting is replaced and the rest of settings.ini kept" ||
        no "settings.ini: $(tr '\n' ' ' < "$td/conf/gtk-3.0/settings.ini")"
    grep -qx 'Inherits=0xide-sweet' "$td/home/.icons/default/index.theme" &&
        ok "the default X cursor theme follows, since it pointed at Sweet" ||
        no ".icons/default still inherits $(grep -oP '(?<=Inherits=).*' "$td/home/.icons/default/index.theme")"
    grep -q 'gsettings set org.gnome.desktop.interface cursor-theme 0xide-sweet' "$td/calls.log" &&
        grep -q 'hyprctl setcursor 0xide-sweet 24' "$td/calls.log" &&
        ok "gsettings and Hyprland are pointed at it" || no "calls: $(tr '\n' ';' < "$td/calls.log")"

    : > "$td/calls.log"
    before="$(stat -c %Y "$theme/cursors/default")"
    cursor >/dev/null 2>&1
    if [ "$(stat -c %Y "$theme/cursors/default")" = "$before" ] && ! grep -q hyprctl "$td/calls.log"
    then ok "an unchanged palette is not rebuilt or reloaded"; else no "an unchanged palette rebuilt the theme"; fi

    rm -rf "$td/data/icons/Sweet-cursors" "$theme"
    if cursor >/dev/null 2>&1 && [ ! -e "$theme" ]
    then ok "without Sweet it does nothing and still succeeds"; else no "without Sweet the adapter failed or built something"; fi
    rm -rf "$td"
fi

ox_step "GTK adapter"
# A stand-in adw-gtk3 and a dconf stub that remembers gtk-theme, so the real
# desktop is never touched. Caelestia's templates are the one real dependency.
if ! "$PY" -c 'import caelestia.utils.theme' >/dev/null 2>&1; then skipt "caelestia-cli is not installed"
else
    td="$(mktemp -d)"
    mkdir -p "$td/conf/gtk-3.0" "$td/data" "$td/state" "$td/bin" "$td/sys/themes/adw-gtk3/gtk-3.0"
    : > "$td/sys/themes/adw-gtk3/gtk-3.0/gtk.css"
    printf '[Settings]\ngtk-font-name=Sans 10\ngtk-theme-name=adw-gtk3\n' > "$td/conf/gtk-3.0/settings.ini"
    printf '@define-color headerbar_bg_color #ff0000;\n' > "$td/conf/gtk-3.0/gtk.css"
    cat > "$td/bin/dconf" <<STUB
#!/bin/sh
if [ "\$1" = read ]; then cat "$td/gtk-theme" 2>/dev/null; exit 0; fi
printf '%s\n' "\$*" >> "$td/dconf.log"
[ "\$2" = /org/gnome/desktop/interface/gtk-theme ] && printf '%s\n' "\$3" > "$td/gtk-theme"
exit 0
STUB
    chmod +x "$td/bin/dconf"
    scheme() { # surfaceDim -> scheme.json
        printf '{"mode":"light","colours":{"primary":"4d6073","onPrimary":"ffffff","background":"fdfbfc","onBackground":"1b1c1d","surface":"fdfbfc","surfaceDim":"%s","onSurface":"1b1c1d"}}\n' "$1" \
            > "$td/state/scheme.json"
    }
    gtk() {
        PATH="$td/bin:$PATH" XDG_CONFIG_HOME="$td/conf" XDG_DATA_HOME="$td/data" XDG_DATA_DIRS="$td/sys" \
            OX_SCHEME="$td/state/scheme.json" "$OX_ROOT/adapters/gtk/apply" >/dev/null 2>&1
    }
    theme() { tr -d "'\n" < "$td/gtk-theme" 2>/dev/null; }

    scheme 111111; gtk
    first="$(theme)"
    if [ "$first" = 0xide-a ] && grep -q 'headerbar_bg_color #111111' "$td/data/themes/0xide-a/gtk-3.0/gtk.css" &&
        grep -q 'file://'"$td"'/sys/themes/adw-gtk3/gtk-3.0/gtk.css' "$td/data/themes/0xide-a/gtk-3.0/gtk.css"
    then ok "the palette is written into a theme built on adw-gtk3, and switched to"
    else no "no generated theme with the palette (gtk-theme: ${first:-unset})"; fi
    ! grep -q '@define-color' "$td/conf/gtk-3.0/gtk.css" &&
        ok "the user stylesheet no longer pins colours that open windows would keep" ||
        no "the GTK3 user stylesheet still defines colours"
    grep -qx 'gtk-theme-name=0xide-a' "$td/conf/gtk-3.0/settings.ini" && grep -qx 'gtk-font-name=Sans 10' "$td/conf/gtk-3.0/settings.ini" &&
        ok "settings.ini names the theme and keeps everything else" ||
        no "settings.ini: $(tr '\n' ' ' < "$td/conf/gtk-3.0/settings.ini")"
    grep -q 'headerbar_bg_color #111111' "$td/conf/gtk-4.0/gtk.css" &&
        ok "GTK4 and libadwaita still get the palette in their own stylesheet" ||
        no "the GTK4 stylesheet has no palette"

    : > "$td/dconf.log"; gtk
    [ "$(theme)" = 0xide-a ] && ! grep -q gtk-theme "$td/dconf.log" &&
        ok "an unchanged palette switches nothing" || no "an unchanged palette switched the theme"

    scheme 222222; gtk
    [ "$(theme)" = 0xide-b ] && grep -q 'headerbar_bg_color #222222' "$td/data/themes/0xide-b/gtk-3.0/gtk.css" &&
        ok "a new palette switches to the other theme name, which open windows reload" ||
        no "a new palette did not switch themes (gtk-theme: $(theme))"
    rm -rf "$td"
fi

ox_step "Zed theme overlay"
# Zed's settings are JSON with comments, so the overlay must change the one
# top-level key and leave comments, nested keys of the same name and every
# other setting exactly as they were.
td="$(mktemp -d)"
cat > "$td/settings.json" <<'JSONC'
// Zed settings
{
  // "theme": "commented out",
  "ui_font_size": 16,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  "lsp": { "x": { "theme": 1 } }, /* trailing */
  "path": "a:,{b"
}
JSONC
cp "$td/settings.json" "$td/before.json"
"$PY" "$OX_ROOT/installer/apply_overlay.py" "$OX_ROOT/overrides/zed/overlay.jsonc" "$td/settings.json" --jsonc >/dev/null
expected="$(sed '5,9c\  "theme": "Caelestia",' "$td/before.json")"
[ "$(cat "$td/settings.json")" = "$expected" ] &&
    ok "only the top-level theme is changed, to Caelestia" ||
    no "the overlay changed more than the theme: $(diff "$td/before.json" "$td/settings.json" | tr '\n' ' ')"
"$PY" "$OX_ROOT/installer/apply_overlay.py" "$OX_ROOT/overrides/zed/overlay.jsonc" "$td/settings.json" --jsonc --check >/dev/null &&
    ok "a second run changes nothing" || no "a second run would change the settings again"
rm -rf "$td"

ox_step "Caelestia shell.json overlay"
# The shell's settings UI writes shell.json too, so install merges the overlay
# into it: only the keys the overlay names change, at any depth.
td="$(mktemp -d)"
ovl="$OX_ROOT/overrides/caelestia/shell.json"
merge() { "$PY" "$OX_ROOT/installer/apply_overlay.py" "$ovl" "$td/shell.json" --json "$@"; }
cat > "$td/shell.json" <<'JSON'
{
    "ai": {
        "backend": "managed",
        "tableMode": true,
        "translateLanguage": "hi",
        "future": { "nested": { "setting": [1, 2] } }
    },
    "appearance": { "transparency": { "enabled": false, "base": 0.85 }, "rounding": 2 },
    "somethingNew": { "a": 1 }
}
JSON
chmod 600 "$td/shell.json"
cp "$td/shell.json" "$td/before.json"
out="$(merge --check)"; rc=$?
[ "$rc" = 1 ] && [ "$(cmp "$td/shell.json" "$td/before.json" && echo same)" = same ] &&
    ok "--check reports and writes nothing" || no "--check: rc=$rc"
case "$out" in *"would set ai.tableMode = false"*"would set appearance.transparency.enabled = true"*)
    ok "--check names each key path it would change" ;; *) no "--check output: $out" ;; esac
case "$out" in *translateLanguage*|*backend*|*future*|*somethingNew*|*rounding*|*base*)
    no "--check would touch a key the overlay does not own: $out" ;; *) ok "--check lists only overlay-owned keys" ;; esac
merge >/dev/null
live() { jq -c "$1" "$td/shell.json"; }
[ "$(live .ai.translateLanguage)" = '"hi"' ] && [ "$(live .ai.backend)" = '"managed"' ] &&
    ok "live ai.translateLanguage = hi and ai.backend survive" || no "ai: $(live .ai)"
[ "$(live .ai.tableMode)" = false ] && ok "the overlay-owned ai.tableMode is updated" || no "ai.tableMode: $(live .ai.tableMode)"
[ "$(live .ai.future)" = '{"nested":{"setting":[1,2]}}' ] && [ "$(live .somethingNew)" = '{"a":1}' ] &&
    ok "unknown nested and top-level settings survive" || no "unknown settings: $(live .ai.future) $(live .somethingNew)"
[ "$(live .appearance)" = '{"transparency":{"enabled":true,"base":0.85},"rounding":2}' ] &&
    ok "nested objects merge key by key" || no "appearance: $(live .appearance)"
[ "$(live .launcher.favouriteApps)" = "$(jq -c .launcher.favouriteApps "$ovl")" ] &&
    ok "keys the live file lacked are added" || no "launcher: $(live .launcher)"
[ "$(stat -c %a "$td/shell.json")" = 600 ] && ok "the file keeps its permissions" || no "mode: $(stat -c %a "$td/shell.json")"
cp "$td/shell.json" "$td/once.json"
merge --check >/dev/null && merge >/dev/null && cmp -s "$td/shell.json" "$td/once.json" &&
    ok "a second run changes nothing" || no "the merge is not idempotent"
printf '{ "ai": { "translateLanguage": "hi", }\n' > "$td/shell.json"; cp "$td/shell.json" "$td/before.json"
merge >/dev/null 2>&1; rc=$?
[ "$rc" = 2 ] && cmp -s "$td/shell.json" "$td/before.json" &&
    ok "invalid JSON fails and is left untouched" || no "invalid JSON: rc=$rc $(cat "$td/shell.json")"
echo '[1, 2]' > "$td/shell.json"
merge >/dev/null 2>&1; rc=$?
[ "$rc" = 2 ] && [ "$(cat "$td/shell.json")" = "[1, 2]" ] && ok "a non-object file is left untouched" || no "array target: rc=$rc"
rm -f "$td/shell.json"
merge >/dev/null && [ "$(jq -S . "$td/shell.json")" = "$(jq -S . "$ovl")" ] &&
    ok "a missing file is created from the overlay" || no "missing target not created"
grep -qE 'apply_overlay\.py.*\\$' "$OX_ROOT/install" && grep -q 'shell.json" --json \$CHECK' "$OX_ROOT/install" &&
    ! grep -qE 'for f in [^;]*shell\.json' "$OX_ROOT/install" &&
    ok "install merges shell.json and never copies it whole" || no "install still overwrites shell.json"
out="$(jq -c '.ai' "$ovl")"
[ "$out" = '{"tableMode":false}' ] && ok "the repository's overlay holds no personal AI settings" || no "overlay ai: $out"
rm -rf "$td"

ox_step "Firefox layout"
# Caelestia's dots deploy to ~/.mozilla only; a profile under
# $XDG_CONFIG_HOME/mozilla must get the files too, and the user's own user.js
# must survive.
td="$(mktemp -d)"
mkdir -p "$td/state/caelestia/dots/firefox" "$td/conf/mozilla/firefox/abc.default-release" "$td/home/.mozilla/firefox/old.default"
printf '#urlbar { border-radius: 10px; }\n' > "$td/state/caelestia/dots/firefox/userChrome.css"
printf '// comment\nuser_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);\n' > "$td/state/caelestia/dots/firefox/user.js"
printf 'user_pref("browser.startup.page", 3);\n' > "$td/conf/mozilla/firefox/abc.default-release/user.js"
firefox_layout() {
    HOME="$td/home" XDG_CONFIG_HOME="$td/conf" XDG_STATE_HOME="$td/state" \
        "$OX_ROOT/overrides/firefox/install" >/dev/null 2>&1
}
firefox_layout; firefox_layout
new="$td/conf/mozilla/firefox/abc.default-release"
cmp -s "$new/chrome/userChrome.css" "$td/state/caelestia/dots/firefox/userChrome.css" &&
    cmp -s "$td/home/.mozilla/firefox/old.default/chrome/userChrome.css" "$td/state/caelestia/dots/firefox/userChrome.css" &&
    ok "userChrome.css reaches profiles under both ~/.mozilla and \$XDG_CONFIG_HOME/mozilla" ||
    no "userChrome.css is missing from a profile"
[ "$(grep -c . "$new/user.js")" = 2 ] && grep -qF 'browser.startup.page' "$new/user.js" &&
    ok "user.js keeps the user's own preferences and gains the one line, once" ||
    no "user.js: $(tr '\n' ' ' < "$new/user.js")"
rm -rf "$td"

ox_step "Offline translation languages"
# A local index and model zip stand in for Argos's, so this needs no network
# and none of the translation packages: it covers what is installed, how, and
# which pairs a translation can route through.
td="$(mktemp -d)"
mkdir -p "$td/assets" "$td/pkg"
cp "$OX_ROOT/shell/extensions/ai/tree/assets/ai/translate.py" "$td/assets/"
for pair in en_fr fr_en en_de de_en; do
    d="$td/pkg/translate-$pair-1_0"
    mkdir -p "$d/model" "$d/stanza/en"
    : > "$d/model/model.bin"; : > "$d/sentencepiece.model"; : > "$d/stanza/en/ewt.pt"
    (cd "$td/pkg" && zip -qr "$pair.zip" "translate-$pair-1_0")
done
"$PY" - "$td" <<'PY'
import json, sys
td = sys.argv[1]
names = {"en": "English", "fr": "French", "de": "German"}
index = [{"from_code": a, "to_code": b, "from_name": names[a], "to_name": names[b], "code": f"translate-{a}_{b}",
          "links": [f"file://{td}/pkg/{a}_{b}.zip"]} for a, b in (("en","fr"),("fr","en"),("en","de"),("de","en"))]
json.dump(index, open(f"{td}/index.json", "w"))
json.dump({"index": {"url": f"file://{td}/index.json", "pivot": "en"},
           "runtime": {"python": "3.13", "packages": []}, "limits": {"modelBytes": 10000000}},
          open(f"{td}/assets/translate.json", "w"))
PY
tr_run() { XDG_DATA_HOME="$td/data" "$PY" "$td/assets/translate.py" "$@"; }
if ! ox_have zip; then skipt "no zip to build a test model"
else
    tr_run status | grep -q '"code": "fr"' && ok "status lists the languages the index has both ways" ||
        no "status did not list French"
    tr_run install fr >/dev/null
    [ -f "$td/data/0xide/translate/en_fr/model/model.bin" ] && [ -f "$td/data/0xide/translate/fr_en/sentencepiece.model" ] &&
        [ ! -e "$td/data/0xide/translate/en_fr/stanza" ] &&
        ok "a language installs both directions through English, without stanza" ||
        no "installing French did not leave both model directions"
    tr_run install de >/dev/null
    err="$(tr_run translate fr es "Bonjour" 2>&1 >/dev/null)"
    [[ "$err" == *"Install fr and es"* ]] && ok "a pair that is not installed is refused with what to install" ||
        no "a missing pair gave: $err"
    "$PY" - "$td" <<'PY' && ok "two installed languages route through English" || no "fr to de did not route through English"
import importlib.util, os, sys
td = sys.argv[1]
os.environ["XDG_DATA_HOME"] = f"{td}/data"
spec = importlib.util.spec_from_file_location("t", f"{td}/assets/translate.py")
t = importlib.util.module_from_spec(spec); spec.loader.exec_module(t)
assert t.route("fr", "de") == [("fr", "en"), ("en", "de")], t.route("fr", "de")
assert t.route("en", "fr") == [("en", "fr")]
assert t.SENTENCE.split("One. Two? Three!") == ["One.", "Two?", "Three!"]
PY
    tr_run remove fr >/dev/null
    [ ! -e "$td/data/0xide/translate/en_fr" ] && [ -e "$td/data/0xide/translate/en_de" ] &&
        ok "removing a language leaves the others" || no "removing French touched German"
fi
rm -rf "$td"

ox_step "Voice dictation"
# The listener is replaced by a stand-in beside a copy of the script, so this
# checks the toggle itself: refusing a muted microphone, turning on, and
# turning off again with the notification replaced.
td="$(mktemp -d)"
mkdir -p "$td/bin" "$td/run" "$td/data/0xide/speech" "$td/conf/caelestia" "$td/assets"
: > "$td/data/0xide/speech/ggml-base.bin"
printf '{"ai":{"dictationLanguage":"de"}}\n' > "$td/conf/caelestia/shell.json"
