    mkdir -p "$td/icons/0xide-sweet" && : > "$td/icons/0xide-sweet/index.theme"
    [ "$(pick)" = 0xide-sweet ] && ok "once rebuilt, the scheme-coloured theme" ||
        no "with the rebuilt theme present it picked '$(pick)'"
    rm -rf "$td"
fi

