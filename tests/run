cat > "$td/assets/speech.py" <<STUB
import signal, sys, time
open("$td/listener.args", "w").write(" ".join(sys.argv[1:]))
signal.signal(signal.SIGTERM, lambda *_: (open("$td/stopped", "w").close(), sys.exit(0)))
while True:
    time.sleep(0.1)
STUB
for tool in whisper-server pw-record wtype; do printf '#!/bin/sh\n' > "$td/bin/$tool"; done
printf '#!/bin/sh\nprintf "Mute: %%s\\n" "$(cat "%s/muted")"\n' "$td" > "$td/bin/pactl"
cat > "$td/bin/notify-send" <<STUB
#!/bin/sh
printf '%s\n' "\$*" >> "$td/notify.log"
case " \$* " in *" -p "*) echo 7 ;; esac
exit 0
STUB
chmod +x "$td/bin/"*
dictate() {
    PATH="$td/bin:$PATH" XDG_RUNTIME_DIR="$td/run" XDG_DATA_HOME="$td/data" XDG_CONFIG_HOME="$td/conf" \
        bash "$td/assets/dictate.sh" >/dev/null 2>&1
