ox_step "Keyboard shortcuts: service"
# The real Keybinds service in a private Quickshell, with a stand-in for
# keybinds.py that counts how often it is asked.
if ox_have qs; then
    kx="$(mktemp -d)"
    mkdir -p "$kx/cfg/services" "$kx/xdg"
    cp "$OX_ROOT/shell/extensions/shortcuts/tree/services/Keybinds.qml" "$kx/cfg/services/"
    cat > "$kx/helper" <<HELPER
import os, subprocess, sys, time
open("$kx/runs", "a").write("run\\n")
try:
    mode = open("$kx/mode").read().strip()
except OSError:
    mode = ""
real = ["$PY", "$OX_ROOT/shell/extensions/shortcuts/tree/assets/shortcuts/keybinds.py",
        "--binds", "$OX_ROOT/tests/fixtures/hyprctl-binds.json",
        "--globals", "$OX_ROOT/tests/fixtures/hyprctl-globalshortcuts.json"]
if mode == "error":
    print('{"error": "Hyprland did not answer"}')
elif mode == "garbage":
    print("not json")
elif mode == "crash":
    sys.exit(3)
else:
    if mode == "slow":
        time.sleep(1)
    sys.stdout.write(subprocess.run(real, capture_output=True, text=True,
                                    env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"}).stdout)
HELPER
    chmod +x "$kx/helper"
    cat > "$kx/cfg/shell.qml" <<QML
import QtQuick
import Quickshell
import Quickshell.Io
import qs.services

ShellRoot {
    id: h

    property var r: ({})
    property int n
    property int at

    // Kept current by watching the file, so a read here is never stale.
    function runs(): int {
        return runsFile.text().split("\n").filter(l => l).length;
    }
    function mode(m: string): void {
        modeFile.setText(m);
    }

    FileView { id: runsFile; path: "$kx/runs"; blockLoading: true; printErrors: false; watchChanges: true; onFileChanged: reload() }
    FileView { id: modeFile; path: "$kx/mode"; blockWrites: true }

    Component.onCompleted: {
        Keybinds.helper = "$kx/helper";
        mode("");
    }

    Timer {
        interval: 400
        repeat: true
        running: true
        onTriggered: {
            const n = ++h.n;
            const r = h.r;
            if (n === 2) {
                r.idle = !Keybinds.open && Keybinds.snapshots === 0 && h.runs() === 0;
                Keybinds.show();
                r.opening = Keybinds.open && Keybinds.loading;
            } else if (n === 4) {
                r.loaded = !Keybinds.loading && !Keybinds.error && Keybinds.binds.length > 20 && h.runs() === 1;
                r.headers = Keybinds.rows.filter(x => x.header).map(x => x.header).join(",");
                r.firstIsHeader = !!Keybinds.rows[0].header;
                Keybinds.query = "volume";
                r.searchLocal = Keybinds.matches >= 1 && Keybinds.rows.filter(x => !x.header).every(x => x.search.includes("volume")) && h.runs() === 1;
                Keybinds.query = "super shift t";
                r.searchWords = Keybinds.matches >= 1 && Keybinds.rows.filter(x => !x.header).every(x => x.keys.includes("Super") && x.keys.includes("Shift"));
                Keybinds.query = "zzzz";
                r.noMatch = Keybinds.matches === 0 && Keybinds.rows.length === 0;
                Keybinds.toggle();
                r.toggleCloses = !Keybinds.open && Keybinds.binds.length === 0 && Keybinds.query === "";
                h.at = h.runs();
            } else if (n === 8) {
                r.quietWhenClosed = h.runs() === h.at && Keybinds.snapshots === 1;
                for (let i = 0; i < 5; i++) {
                    Keybinds.toggle();
                    Keybinds.toggle();
                }
                r.closedAfterToggles = !Keybinds.open;
                Keybinds.show();
            } else if (n === 10) {
                r.reopenRefreshes = Keybinds.open && Keybinds.binds.length > 20 && h.runs() >= h.at + 1;
                Keybinds.hide();
                h.at = h.runs();
            } else if (n === 13) {
                r.noPollingAfterCycles = h.runs() === h.at;
                h.mode("error");
                Keybinds.show();
            } else if (n === 15) {
                r.errorShown = Keybinds.error === "Hyprland did not answer" && Keybinds.binds.length === 0 && !Keybinds.loading;
                h.mode("garbage");
                Keybinds.refresh();
            } else if (n === 17) {
                r.garbage = Keybinds.error !== "" && !Keybinds.loading && Keybinds.open;
                h.mode("crash");
                Keybinds.refresh();
            } else if (n === 19) {
                r.crash = Keybinds.error !== "" && !Keybinds.loading;
                Keybinds.hide();
                h.mode("slow");
                Keybinds.show();
                Keybinds.hide();
            } else if (n === 24) {
                r.lateIgnored = !Keybinds.open && Keybinds.binds.length === 0 && Keybinds.error === "";
                Keybinds.refresh();
                r.refreshClosedNoop = !Keybinds.loading;
                console.log("RESULTS " + JSON.stringify(r));
                Qt.quit();
            }
        }
    }
}
QML
    res="$(cd "$kx" && XDG_CONFIG_HOME="$kx/xdg" XDG_STATE_HOME="$kx/xdg" XDG_CACHE_HOME="$kx/xdg" XDG_DATA_HOME="$kx/xdg" \
        XDG_RUNTIME_DIR="$kx/xdg" WAYLAND_DISPLAY='' QT_QPA_PLATFORM=offscreen \
        timeout 40 qs -p "$kx/cfg" 2>&1 | sed -n 's/.*qml.*RESULTS //p')"
    if [ -z "$res" ]; then
        no "the shortcuts service harness did not run"
    else
        "$PY" - "$res" <<'CHK'
import json, sys
r = json.loads(sys.argv[1])
want = {
    "idle": (True, "nothing is read before it is opened"),
    "opening": (True, "opening it starts one snapshot"),
    "loaded": (True, "the snapshot is loaded, from one run of the helper"),
    "firstIsHeader": (True, "the list starts with a group header"),
    "searchLocal": (True, "14. search filters the loaded snapshot without asking Hyprland again"),
    "searchWords": (True, "14. every word of a search has to match"),
    "noMatch": (True, "a search with no match leaves an empty list"),
    "toggleCloses": (True, "20. toggling while open closes it and drops the snapshot"),
    "quietWhenClosed": (True, "18. nothing is read while closed"),
    "closedAfterToggles": (True, "opening and closing repeatedly ends closed"),
    "reopenRefreshes": (True, "reopening reads a fresh snapshot"),
    "noPollingAfterCycles": (True, "18. after many opens and closes, nothing keeps running"),
    "errorShown": (True, "an error from the helper is shown, not a crash"),
    "garbage": (True, "output that is not JSON is an error"),
    "crash": (True, "a helper that dies is an error"),
    "lateIgnored": (True, "an answer that arrives after closing is ignored"),
    "refreshClosedNoop": (True, "refresh does nothing while closed"),
}
for k, (v, what) in want.items():
    print(("ok " if r.get(k) == v else "FAIL ") + what + ("" if r.get(k) == v else f" (got {r.get(k)!r})"))
print("headers " + str(r.get("headers")))
CHK
    fi > "$kx/out"
    while IFS= read -r line; do
        case "$line" in
            "ok "*) ok "${line#ok }" ;;
            "FAIL "*) no "${line#FAIL }" ;;
            *) printf '  %s\n' "$line" ;;
        esac
    done < "$kx/out"
    rm -rf "$kx"
else skipt "no qs for the shortcuts service harness"; fi

ox_step "OCR: engine and language readiness"
# The real Ocr service in a private Quickshell, with a stand-in tesseract that
# can be taken away. A missing engine and missing language data are different
# problems, and both have to be named, in settings and when a capture fails.
if ox_have qs && [ -d "$PLUGIN_QML/Caelestia/Config" ]; then
    ox="$(mktemp -d)"
    mkdir -p "$ox/cfg/services" "$ox/bin" "$ox/xdg/run" "$ox/xdg/caelestia"
    cp "$OX_ROOT/shell/extensions/ocr/tree/services/Ocr.qml" "$ox/cfg/services/"
    printf '{"ai":{"ocrLanguages":""}}\n' > "$ox/xdg/caelestia/shell.json"
    cat > "$ox/tesseract" <<'STUB'
#!/bin/sh
if [ "$1" = --list-langs ]; then printf 'List of available languages (2):\neng\nosd\n'; exit 0; fi
for a; do case "$a" in *deu*) printf "Error opening data file deu.traineddata\nFailed loading language 'deu'\nTesseract couldn't load any languages!\n" >&2; exit 1 ;; esac; done
echo "HELLO"
STUB
    chmod +x "$ox/tesseract"
    printf '#!/bin/sh\nprintf "%%s\\n" "$*" >> "%s/notified"\n' "$ox" > "$ox/bin/notify-send"
    printf '#!/bin/sh\ncat > /dev/null\n' > "$ox/bin/wl-copy"
    chmod +x "$ox/bin/notify-send" "$ox/bin/wl-copy"
    for t in sh cat mv ln; do ln -s "$(type -P "$t")" "$ox/bin/$t"; done
    cat > "$ox/cfg/shell.qml" <<QML
import QtQuick
import Quickshell
import Quickshell.Io
import Caelestia.Config
import qs.services

ShellRoot {
    id: h

    property var r: ({})
    property int phase
    property real since: Date.now()

    function next(): void {
        phase++;
        since = Date.now();
    }
    function run(cmd: var): void {
        sh.done = false;
        sh.command = cmd;
        sh.running = true;
    }

    Component.onCompleted: Ocr.refreshLanguages()
    Process { id: sh; property bool done; onExited: done = true }

    Timer {
        interval: 100
        repeat: true
        running: true
        onTriggered: {
            const r = h.r;
            const waited = Date.now() - h.since;
            if (h.phase === 0 && waited > 800) {
                r.engineMissing = Ocr.engineMissing && Ocr.readiness === "OCR requires Tesseract. Install tesseract first.";
                h.run(["ln", "-s", "$ox/tesseract", "$ox/bin/tesseract"]);
                h.next();
            } else if (h.phase === 1 && sh.done) {
                Ocr.refreshLanguages();
                h.next();
            } else if (h.phase === 2 && waited > 800) {
                r.ready = !Ocr.engineMissing && Ocr.readiness === "" && Ocr.languages.join() === "eng";
                GlobalConfig.ai.ocrLanguages = "eng+deu";
                h.next();
            } else if (h.phase === 3 && waited > 300) {
                r.langMissing = Ocr.missingLanguages.join() === "deu" && Ocr.readiness.startsWith("Tesseract has no data for deu.");
                Ocr.capture("/nonexistent.png");
                h.next();
            } else if (h.phase === 4 && waited > 1500) {
                h.run(["mv", "$ox/bin/tesseract", "$ox/gone"]);
                h.next();
            } else if (h.phase === 5 && sh.done) {
                Ocr.capture("/nonexistent.png");
                h.next();
            } else if (h.phase === 6 && waited > 1500) {
                r.goneAfter = Ocr.engineMissing;
                console.log("RESULT " + JSON.stringify(r));
                Qt.quit();
            } else if (waited > 15000) {
                console.log("RESULT " + JSON.stringify(Object.assign(r, {stuck: h.phase})));
                Qt.quit();
            }
        }
    }
}
QML
    res="$(cd "$ox" && timeout 60 env PATH="$ox/bin" XDG_RUNTIME_DIR="$ox/xdg/run" XDG_CONFIG_HOME="$ox/xdg" XDG_STATE_HOME="$ox/xdg" \
        XDG_DATA_HOME="$ox/xdg" XDG_CACHE_HOME="$ox/xdg" QML_IMPORT_PATH="$PLUGIN_QML" QT_QPA_PLATFORM=offscreen \
        "$(command -v qs)" -p "$ox/cfg/shell.qml" 2>&1 | sed -n 's/.*RESULT //p' | tail -1)"
    for c in "engineMissing:without Tesseract, settings say the engine is missing" \
             "ready:with it and its data, nothing is reported" \
             "langMissing:a configured language without data is named as such" \
             "goneAfter:a capture after Tesseract is removed updates the settings too"; do
        key="${c%%:*}"
        case "$res" in *"\"$key\":true"*) ok "${c#*:}" ;; *) no "${c#*:} ($res)" ;; esac
    done
    grep -q "Tesseract has no data for deu. Install it (e.g. tesseract-data-deu)" "$ox/notified" 2>/dev/null &&
        ok "a capture in a language without data says which, not Tesseract's raw text" ||
        no "a missing language at capture: $(tr '\n' '|' < "$ox/notified" 2>/dev/null)"
    grep -q "OCR requires Tesseract. Install tesseract first." "$ox/notified" 2>/dev/null &&
        ok "a capture without Tesseract says to install it, not command-not-found" ||
        no "a capture without Tesseract: $(tr '\n' '|' < "$ox/notified" 2>/dev/null)"
    rm -rf "$ox"
else
    skipt "the OCR service checks need qs and a built plugin"
fi
rd="$(mktemp -d)"
mkdir -p "$rd/bin"; ln -s "$PY" "$rd/bin/python3"
out="$(PATH="$rd/bin" "$PY" "$OX_ROOT/shell/extensions/ocr/tree/assets/ocr/recognize.py" "$rd/none.png" --language eng)"
[[ "$out" == *'"error": "OCR requires Tesseract. Install tesseract first."'* ]] &&
    ok "the table recogniser names a missing Tesseract" || no "recognize.py without tesseract: $out"
rm -rf "$rd"

ox_step "Region search: OCR languages and uploads"
# region_search.sh against stand-ins for tesseract and curl, so every outcome
# is exact: which languages it reads in, and what an upload failure is called.
rq="$(mktemp -d)"
mkdir -p "$rq/bin" "$rq/conf/caelestia" "$rq/conf/0xide" "$rq/run"
for t in bash sh cat tail head grep sed tr paste jq mktemp rm base64 sleep; do ln -s "$(type -P "$t")" "$rq/bin/$t"; done
cat > "$rq/tesseract" <<STUB
#!/bin/sh
if [ "\$1" = --list-langs ]; then printf 'List of available languages (3):\neng\nfra\nosd\n'; exit 0; fi
printf '%s\n' "\$*" > "$rq/tess-args"
[ -n "\$TESS_FAIL" ] && { printf 'Error in pixRead\nImage file %s cannot be read!\n' "\$1" >&2; exit 1; }
[ -n "\$TESS_EMPTY" ] && exit 0
echo "Bonjour le monde"
STUB
printf '#!/bin/sh\nprintf "%%s\\n" "$*" >> "%s/notified"\n' "$rq" > "$rq/bin/notify-send"
printf '#!/bin/sh\nprintf "%%s" "$1" > "%s/opened"\n' "$rq" > "$rq/bin/xdg-open"
printf '#!/bin/sh\ncat >/dev/null\nprintf "%%s\\n" "${FUZZEL_ANSWER:-Send the image}"\n' > "$rq/bin/fuzzel"
cat > "$rq/curl" <<'STUB'
#!/bin/sh
case "$CURL_MODE" in
    dns) echo "curl: (6) Could not resolve host: uguu.se" >&2; printf '\n000'; exit 6 ;;
    refuse) printf 'Forbidden\n403' ;;
    ok) printf 'https://h.example/a.png\n200' ;;
esac
STUB
chmod +x "$rq/tesseract" "$rq/curl" "$rq/bin/notify-send" "$rq/bin/xdg-open" "$rq/bin/fuzzel"
magick -size 40x20 xc:white "$rq/img.png" 2>/dev/null || printf 'x' > "$rq/img.png"
rs_run() { # [env assignments...] -- gesture
    rm -f "$rq/notified" "$rq/opened" "$rq/tess-args"; cp "$rq/img.png" "$rq/cap.png"
    env PATH="$rq/bin" XDG_CONFIG_HOME="$rq/conf" XDG_RUNTIME_DIR="$rq/run" "$@" bash "$rs" "$rq/cap.png" "${GESTURE:-rectangle}" >/dev/null 2>&1
}
langs() { printf '{"ai":{"ocrLanguages":"%s"}}\n' "$1" > "$rq/conf/caelestia/shell.json"; }
ln -s "$rq/tesseract" "$rq/bin/tesseract"
langs ""; rs_run
grep -q -- '-l eng+fra$' "$rq/tess-args" && grep -q 'Bonjour' "$rq/opened" &&
    ok "with no OCR languages set, a text search reads every installed one" || no "unset languages read: $(cat "$rq/tess-args" 2>/dev/null)"
langs "fra"; rs_run
grep -q -- '-l fra$' "$rq/tess-args" && ok "it reads the languages the OCR settings name, not always English" ||
    no "configured fra read: $(cat "$rq/tess-args" 2>/dev/null)"
langs "eng+fra"; rs_run
grep -q -- '-l eng+fra$' "$rq/tess-args" && ok "several configured languages are read together" || no "eng+fra read: $(cat "$rq/tess-args" 2>/dev/null)"
langs "eng+deu"; rs_run
grep -q 'Tesseract has no data for deu. Install it (e.g. tesseract-data-deu)' "$rq/notified" && [ ! -e "$rq/tess-args" ] && [ ! -e "$rq/opened" ] &&
    ok "a configured language without data is named before anything is read" || no "missing deu: $(cat "$rq/notified" 2>/dev/null)"
langs ""; rs_run TESS_FAIL=1
grep -q 'Tesseract could not read the region: Image file .* cannot be read!' "$rq/notified" && [ ! -e "$rq/opened" ] &&
    ok "an image Tesseract cannot read is reported with its reason" || no "unreadable image: $(cat "$rq/notified" 2>/dev/null)"
rs_run TESS_EMPTY=1
grep -q 'No text was found' "$rq/notified" && [ ! -e "$rq/opened" ] && ok "an empty result says nothing was found" || no "empty result"
rm "$rq/bin/tesseract"; rs_run
grep -q 'OCR requires Tesseract. Install tesseract first.' "$rq/notified" && ok "without Tesseract a text search says to install it" ||
    no "no tesseract: $(cat "$rq/notified" 2>/dev/null)"
printf 'mode=host-upload\n' > "$rq/conf/0xide/region-search.conf"
rs_run
grep -q 'curl is not installed, so the image cannot be uploaded. Nothing was sent.' "$rq/notified" && [ ! -e "$rq/opened" ] &&
    ok "without curl an upload says so, before asking" || no "no curl: $(cat "$rq/notified" 2>/dev/null)"
ln -s "$rq/curl" "$rq/bin/curl"
rs_run CURL_MODE=dns
grep -q 'uguu.se could not be reached (curl: (6) Could not resolve host: uguu.se)' "$rq/notified" && ! grep -q refused "$rq/notified" &&
    ok "a host that cannot be reached is not called a refusal" || no "dns failure: $(cat "$rq/notified" 2>/dev/null)"
rs_run CURL_MODE=refuse
grep -q 'uguu.se refused it (HTTP 403)' "$rq/notified" && ok "an HTTP refusal names the status" || no "refusal: $(cat "$rq/notified" 2>/dev/null)"
rs_run CURL_MODE=ok FUZZEL_ANSWER=Cancel
grep -q 'Search cancelled Nothing was uploaded.' "$rq/notified" && [ ! -e "$rq/opened" ] &&
    ok "declining the upload sends nothing and says so" || no "cancel: $(cat "$rq/notified" 2>/dev/null)"
rs_run CURL_MODE=ok
grep -q 'uploadbyurl?url=https%3A%2F%2Fh.example%2Fa.png' "$rq/opened" && ok "an accepted upload opens Lens on the uploaded image" || no "upload ok"
rm -rf "$rq"

ox_step "Quickshell JSON under the C locale"
# The warning exactly as Quickshell 0.2 printed it on stdout over SSH.
qw="$(printf '\033[33m  WARN\033[0m: Detected locale "C" with character encoding "ANSI_X3.4-1968", which is not UTF-8.\nQt depends on a UTF-8 locale, and has switched to "C.UTF-8" instead.\nIf this causes problems, reconfigure your locale. See the locale(1) manual\nfor more information.')"
[ "$(printf '%s\n[{"pid": 7}]\n' "$qw" | ox_strip_qt_locale_warning | jq -c '.[0].pid')" = 7 ] &&
    ok "the locale warning before JSON is removed" || no "the locale warning is not removed"
[ "$(printf '[{"pid": 7}]\n' | ox_strip_qt_locale_warning | jq -c '.[0].pid')" = 7 ] &&
    ok "JSON without the warning passes unchanged" || no "plain JSON was changed"
printf '%s\nnot json\n' "$qw" | ox_strip_qt_locale_warning | jq . >/dev/null 2>&1 &&
    no "garbage after the warning parsed as JSON" || ok "garbage after the warning still fails to parse"
[ "$(printf '%s\nsomething else\n[]\n' "$(head -1 <<<"$qw")" | ox_strip_qt_locale_warning | head -1)" = "$(head -1 <<<"$qw")" ] &&
    ok "a block that is not exactly Qt's warning is left for the parser to reject" || no "a partial warning was removed"
printf '[1]\n%s\n' "$qw" | ox_strip_qt_locale_warning | grep -q 'Detected locale' &&
    ok "the warning is only removed from the start" || no "a warning after the JSON was removed"

ox_step "Desktop profiles: switching from the shell"
# The real DesktopProfiles service against a stand-in command line. A switch
# started from the launcher or settings must show that it is running, refresh
# the current desktop when it ends, and say why when it did not happen.
if ox_have qs && ox_have setsid; then
    px="$(mktemp -d)"
    mkdir -p "$px/cfg/services" "$px/xdg/run"
    sed "s|@OXIDE_ROOT@|$px|" "$OX_ROOT/shell/extensions/desktop-profile/tree/services/DesktopProfiles.qml" > "$px/cfg/services/DesktopProfiles.qml"
    echo caelestia > "$px/active"
    cat > "$px/0xide" <<STUB
#!/bin/sh
a="\$(cat "$px/active")"
case "\$2" in
    list) for p in caelestia windows-xp broken half; do [ "\$p" = "\$a" ] && m=1 || m=0; printf '%s\t%s\t%s\t%s\n' "\$p" "\$p" "\$m" "desc \$p"; done ;;
    set) sleep 0.6
         case "\$3" in
             broken) echo "fail: broken cannot run here: hyprctl is not installed" >&2; exit 1 ;;
             half) echo "  switch to half failed at ENTER" >&2; echo "  rollback to \$a did not verify" >&2; exit 2 ;;
             *) echo "\$3" > "$px/active" ;;
         esac ;;
esac
STUB
    chmod +x "$px/0xide"
    cat > "$px/cfg/shell.qml" <<QML
import QtQuick
import Quickshell
import qs.services

ShellRoot {
    id: h

    property var r: ({})
    property int phase
    property real since: Date.now()

    function next(): void {
        phase++;
        since = Date.now();
    }

    Component.onCompleted: DesktopProfiles.refresh()

    Timer {
        interval: 100
        repeat: true
        running: true
        onTriggered: {
            const r = h.r;
            const P = DesktopProfiles;
            const waited = Date.now() - h.since;
            if (h.phase === 0 && P.active) {
                r.listed = P.active.id === "caelestia" && P.profiles.length === 4;
                P.activate("windows-xp");
                r.switchingAtOnce = P.switching && P.switchingTo === "windows-xp";
                P.activate("broken");
                r.secondRefused = P.error === "A desktop switch is already running" && P.switchingTo === "windows-xp";
                h.next();
            } else if (h.phase === 1 && !P.switching && waited > 300) {
                r.refreshed = P.active?.id === "windows-xp";
                P.activate("broken");
                h.next();
            } else if (h.phase === 2 && !P.switching && waited > 300) {
                r.refusal = P.error === "broken cannot run here: hyprctl is not installed" && P.active?.id === "windows-xp";
                P.activate("half");
                h.next();
            } else if (h.phase === 3 && !P.switching && waited > 300) {
                r.rollback = P.error.startsWith("switch to half failed at ENTER") && P.error.includes("could not be fully restored") && P.active?.id === "windows-xp";
                P.activate("caelestia");
                h.next();
            } else if (h.phase === 4 && !P.switching && waited > 300) {
                r.back = P.active?.id === "caelestia" && P.error === "";
                console.log("RESULT " + JSON.stringify(r));
                Qt.quit();
            } else if (waited > 15000) {
                console.log("RESULT " + JSON.stringify(Object.assign(r, {stuck: h.phase})));
                Qt.quit();
            }
        }
    }
}
QML
    res="$(cd "$px" && timeout 60 env XDG_RUNTIME_DIR="$px/xdg/run" QT_QPA_PLATFORM=offscreen \
        "$(command -v qs)" -p "$px/cfg/shell.qml" 2>&1 | sed -n 's/.*RESULT //p' | tail -1)"
    for c in "listed:the profile list is read from the command line" \
             "switchingAtOnce:a switch shows as running the moment it is asked for" \
             "secondRefused:a second switch while one runs is refused with a reason" \
             "refreshed:the current desktop is refreshed when a switch ends" \
             "refusal:a refused switch says why and the current desktop stays as it is" \
             "rollback:a switch that failed and could not restore says so" \
             "back:switching back clears the last error"; do
        key="${c%%:*}"
        case "$res" in *"\"$key\":true"*) ok "${c#*:}" ;; *) no "${c#*:} ($res)" ;; esac
    done
    rm -rf "$px"
else
    skipt "qs and setsid are needed for the profile switching checks"
fi
grep -q 'This shell closes' "$OX_ROOT/shell/extensions/desktop-profile/tree/modules/nexus/pages/ThemePage.qml" &&
    no "the switch dialog still says this shell closes" || ok "the switch dialog does not claim the shell closes"

ox_step "Wallpaper delete: what happened to the file"
# The real WallpaperInfo service and real gio, on disposable files only. The
# fixtures live under the home file system, which has a Trash; their Trash is
# a private XDG_DATA_HOME, never the user's.
if ox_have qs && ox_have gio; then
    wx="$(mktemp -d "$HOME/.cache/0xide-wallpaper-test.XXXXXX")"
    mkdir -p "$wx/cfg/services" "$wx/data" "$wx/run" "$wx/ro" "$wx/bin"
    cp "$OX_ROOT/shell/extensions/wallpaper-info/tree/services/WallpaperInfo.qml" "$wx/cfg/services/"
    : > "$wx/ok.png"; : > "$wx/ro/locked.png"; chmod 555 "$wx/ro"
    tmpfile=""
    [ "$(findmnt -T /tmp -no FSTYPE 2>/dev/null)" = tmpfs ] && { tmpfile="$(mktemp /tmp/0xide-wallpaper-test.XXXXXX.png)"; }
    ln -s "$(type -P gio)" "$wx/bin/gio"
    cat > "$wx/cfg/shell.qml" <<QML
import QtQuick
import Quickshell
import Quickshell.Io
import qs.services

ShellRoot {
    id: h

    property var r: ({})
    property int phase
    property real since: Date.now()
    readonly property var cases: [["ok", "$wx/ok.png"], ["missing", "$wx/gone.png"], ["denied", "$wx/ro/locked.png"], ["tmpfs", "$tmpfile"], ["noGio", "$wx/ok2.png"]]

    function next(): void {
        phase++;
        since = Date.now();
    }

    Process { id: hide; property bool done; command: ["$(type -P rm)", "$wx/bin/gio"]; onExited: done = true }

    Timer {
        interval: 100
        repeat: true
        running: true
        onTriggered: {
            const W = WallpaperInfo;
            const waited = Date.now() - h.since;
            if (h.phase >= h.cases.length * 2) {
                console.log("RESULT " + JSON.stringify(h.r));
                Qt.quit();
                return;
            }
            const c = h.cases[Math.floor(h.phase / 2)];
            if (h.phase % 2 === 0) {
                if (!c[1]) { h.phase += 2; return; }
                if (c[0] === "noGio" && !hide.done) { if (!hide.running) hide.running = true; return; }
                W.openPath = c[1];
                W.trash();
                h.next();
            } else if (!W.trashing && waited > 200) {
                h.r[c[0]] = { error: W.trashError, open: W.openPath !== "" };
                h.next();
            } else if (waited > 10000) {
                h.r[c[0]] = { stuck: true };
                h.next();
            }
        }
    }
}
QML
    res="$(cd "$wx" && timeout 60 env PATH="$wx/bin" XDG_DATA_HOME="$wx/data" XDG_RUNTIME_DIR="$wx/run" QT_QPA_PLATFORM=offscreen \
        "$(command -v qs)" -p "$wx/cfg/shell.qml" 2>&1 | sed -n 's/.*RESULT //p' | tail -1)"
    chmod 755 "$wx/ro"
    "$PY" - "$res" "$wx" "$tmpfile" <<'CHK'
import json, os, sys
r, wx, tmp = json.loads(sys.argv[1] or "{}"), sys.argv[2], sys.argv[3]
def check(cond, what, got):
    print(f"  \033[32mok\033[0m    {what}" if cond else f"  \033[31mFAIL\033[0m  {what} (got {got!r})")
    return 0 if cond else 1
bad = 0
ok = r.get("ok", {})
bad += check(ok.get("error") == "" and not ok.get("open") and not os.path.exists(f"{wx}/ok.png")
             and os.listdir(f"{wx}/data/Trash/files") == ["ok.png"],
             "a normal delete moves the file to the Trash and closes the overlay", ok)
for key, words, what in (("missing", "No such file or directory", "a file already gone says so"),
                         ("denied", "Permission denied", "a file it may not move says permission was denied")):
    e = r.get(key, {}).get("error", "")
    bad += check(e.startswith(words) and "gio:" not in e and "file://" not in e and r[key]["open"],
                 f"{what}, without gio's prefix, and the overlay stays", r.get(key))
bad += check(os.path.exists(f"{wx}/ro/locked.png"), "the file it could not move is still there", "missing")
if tmp:
    e = r.get("tmpfs", {}).get("error", "")
    bad += check("not supported" in e and "file://" not in e and os.path.exists(tmp),
                 "a file system without a Trash is reported and the file kept", r.get("tmpfs"))
e = r.get("noGio", {}).get("error", "")
bad += check(e == "gio is not installed, so nothing was moved to the Trash", "without gio it says so instead of Moving… forever", r.get("noGio"))
sys.exit(bad)
CHK
    n=$?; t=$([ -n "$tmpfile" ] && echo 6 || echo 5)
    pass=$((pass + t - n)); fail=$((fail + n))
    [ -n "$tmpfile" ] && rm -f -- "$tmpfile"
    rm -rf "$wx"
else
    skipt "the wallpaper delete checks need qs and gio"
fi
grep -q 'wrapMode: Text.Wrap' "$OX_ROOT/shell/extensions/wallpaper-info/tree/components/WallpaperInfoOverlay.qml" &&
    ok "a delete failure is wrapped in the overlay, not cut to one line" || no "the delete failure is still elided"

ox_step "Papirus: the privileged helper"
# The only thing the sudo rule grants. It is driven here as an ordinary user,
# with its root check and papirus-folders stood in for, so nothing can write.
PH="$OX_ROOT/system/sudoers/0xide-papirus-folders"
head -1 "$PH" | grep -qx '#!/usr/bin/python3' && ok "the helper runs the distribution interpreter" || no "the helper is not #!/usr/bin/python3"
out="$(env -i PATH=/usr/bin "$PH" --help 2>&1)"; [ $? = 0 ] && grep -q '^Usage:' <<<"$out" && ok "--help prints usage" || no "--help failed"
bad=""
for args in "" "blue red" "--theme" "-t" "BLUE" "blue;id" 'blue$(id)' "../blue" "blue -t /tmp" "/tmp/x" "blue--" "-blue" "$(printf 'b%.0s' $(seq 40))"; do
    # shellcheck disable=SC2086
    env -i PATH=/usr/bin SUDO_USER="$(id -un)" SUDO_UID="$(id -u)" "$PH" $args >/dev/null 2>&1
    [ $? = 2 ] || bad="$bad [$args]"
done
[ -z "$bad" ] && ok "anything but one plain colour name is refused, before sudo metadata is read" || no "accepted or mishandled:$bad"
env -i PATH=/usr/bin "$PH" blue >/dev/null 2>&1; [ $? = 1 ] && ok "a valid colour run without root is refused" || no "the helper ran without root"
if "$PY" - "$PH" <<'CHK'
import ast, importlib.machinery, importlib.util, os, pwd, re, sys, tempfile
loader = importlib.machinery.SourceFileLoader("helper", sys.argv[1])
h = importlib.util.module_from_spec(importlib.util.spec_from_loader("helper", loader))
loader.exec_module(h)
bad = []
def check(cond, what):
    if not cond:
        bad.append(what)
me = pwd.getpwuid(os.getuid())
for env, want, what in (({}, None, "no sudo metadata"),
                        ({"SUDO_USER": me.pw_name}, None, "a user without a uid"),
                        ({"SUDO_USER": me.pw_name, "SUDO_UID": "0"}, None, "uid 0 for an ordinary user"),
                        ({"SUDO_USER": "root", "SUDO_UID": "0"}, None, "root itself"),
                        ({"SUDO_USER": me.pw_name, "SUDO_UID": str(me.pw_uid + 1)}, None, "a uid that is not the user's"),
                        ({"SUDO_USER": "no-such-user-0xide", "SUDO_UID": "1000"}, None, "an unknown user"),
                        ({"SUDO_USER": me.pw_name, "SUDO_UID": str(me.pw_uid)}, me.pw_name, "the real caller")):
    os.environ.clear(); os.environ.update(env)
    check(h.caller() == want, f"caller() for {what}")
check(h.colours("   adwaita\n > blue\n   bluegrey\n   palebrown\n") == {"adwaita", "blue", "bluegrey", "palebrown"}, "colours() parsing")
check(h.colours("../x\n> blue;id\n  rm -rf\n") == set(), "colours() accepts junk")
check(h.ENV == {"PATH": "/usr/bin:/bin", "LANG": "C.UTF-8", "HOME": "/root"}, "the environment is not fixed")
src = open(sys.argv[1]).read()
check(set(re.findall(r'os\.environ\.get\("([A-Z_]+)"\)', src)) == {"SUDO_USER", "SUDO_UID"}, "reads environment beyond sudo's")
check("shell=True" not in src and "os.system" not in src, "uses a shell")
# main() as root, against a stand-in papirus-folders that records how it ran.
with tempfile.TemporaryDirectory() as d:
    fake = f"{d}/papirus-folders"
    open(fake, "w").write(f'#!/bin/sh\nprintf "%s|" "$@" >> {d}/args; env >> {d}/env; echo >> {d}/args\n'
                          f'[ "$1" = -l ] && printf "   adwaita\\n > blue\\n   red\\n"\nexit 0\n')
    os.chmod(fake, 0o755)
    h.PAPIRUS_FOLDERS = fake
    h.os.geteuid = lambda: 0
    os.environ.clear(); os.environ.update({"SUDO_USER": me.pw_name, "SUDO_UID": str(me.pw_uid), "XDG_DATA_DIRS": "/tmp/evil", "HOME": "/tmp/evil"})
    check(h.main(["red"]) == 0, "a listed colour is not applied")
    calls = open(f"{d}/args").read().splitlines()
    check(calls == ["-l|--theme|Papirus|", "-C|red|--theme|Papirus|-u|"], f"papirus-folders ran as {calls}")
    envs = open(f"{d}/env").read()
    check("/tmp/evil" not in envs and "HOME=/root" in envs, "the caller's environment reached papirus-folders")
    check(h.main(["green"]) == 2, "an unlisted colour is not refused")
    check(len(open(f"{d}/args").read().splitlines()) == 3, "an unlisted colour still ran -C")
    os.environ["SUDO_UID"] = "0"
    check(h.main(["red"]) == 1, "forged sudo metadata is not refused")
for b in bad:
    print(f"        helper {b}")
sys.exit(1 if bad else 0)
CHK
then ok "the helper derives everything else itself: theme, options, environment and caller"
else no "the helper's validation is wrong"; fi
grep -v '^#' "$OX_ROOT/system/sudoers/0xide.template" | grep -v '^$' | grep -qx '@USER@ ALL=(root) NOPASSWD: /usr/local/libexec/0xide-papirus-folders' &&
    [ "$(grep -vc '^#\|^$' "$OX_ROOT/system/sudoers/0xide.template")" = 1 ] &&
    ok "the sudo rule grants the fixed helper and nothing else" || no "the sudo rule grants more than the helper"
grep -rq 'papirus-folders -C \*' "$OX_ROOT/system" "$OX_ROOT/adapters" && no "the wide papirus-folders rule is still somewhere" ||
    ok "no rule for papirus-folders itself is left"

ox_step "Papirus: install, remove, apply and status"
if ! ox_have visudo; then
    skipt "visudo is missing"
else
    pb="$(mktemp -d)"
    mkdir -p "$pb/bin" "$pb/cap" "$pb/c/0xide" "$pb/s/caelestia"
    cat > "$pb/bin/sudo" <<STUB
#!/bin/bash
printf '%s\n' "\$*" >> "$pb/calls"
if [ "\$1" = install ]; then dest="\${@: -1}"; src="\${@: -2:1}"; cp "\$src" "$pb/cap/\$(basename "\$dest")"; fi
if [ "\$1 \$2" = "-n -l" ]; then [ -e "$pb/rule" ] && echo "    (root) NOPASSWD: \$(cat "$pb/rule")"; exit 0; fi
if [ "\$1" = -n ]; then shift; exec "\$@"; fi
exit 0
STUB
    chmod +x "$pb/bin/sudo"
    pbenv() { env HOME="$pb" XDG_CONFIG_HOME="$pb/c" XDG_STATE_HOME="$pb/s" XDG_DATA_HOME="$pb/d" PATH="$pb/bin:$PATH" "$@"; }
    out="$(pbenv env OX_ASSUME_YES=1 bash "$OX_ROOT/system/sudoers/install" 2>&1)"; rc=$?
    h1="$(grep -n '^install -D -m 0755 -o root -g root .*/system/sudoers/0xide-papirus-folders /usr/local/libexec/0xide-papirus-folders$' "$pb/calls" | cut -d: -f1)"
    r1="$(grep -n '^install -m 0440 -o root -g root .* /etc/sudoers.d/0xide$' "$pb/calls" | cut -d: -f1)"
    [ "$rc" = 0 ] && [ -n "$h1" ] && [ -n "$r1" ] && [ "$h1" -lt "$r1" ] && cmp -s "$pb/cap/0xide-papirus-folders" "$PH" &&
        ok "install puts the helper in place, from tracked source, before the rule that names it" ||
        no "sudoers install: exit $rc, calls: $(tr '\n' ';' < "$pb/calls" 2>/dev/null)"
    [ "$(grep -v '^#' "$pb/cap/0xide" | grep -v '^$')" = "$(id -un) ALL=(root) NOPASSWD: /usr/local/libexec/0xide-papirus-folders" ] &&
        ok "the installed rule names the helper, for the running user only" || no "installed rule: $(grep -v '^#' "$pb/cap/0xide")"
    grep -q '/usr/local/libexec/0xide-papirus-folders  (root:root 0755' <<<"$out" && grep -q 'syntax checked with visudo -c' <<<"$out" &&
        ok "install prints both privileged changes and checks the rule first" || no "install output: $out"
    : > "$pb/calls"
    pbenv bash "$OX_ROOT/system/sudoers/remove" >/dev/null 2>&1
    grep -qx 'rm -f -- /etc/sudoers.d/0xide /etc/sudoers.d/caelestia-mod' "$pb/calls" && grep -qx 'rm -f -- /usr/local/libexec/0xide-papirus-folders' "$pb/calls" &&
        ok "remove takes back the rule and the helper" || no "sudoers remove: $(tr '\n' ';' < "$pb/calls")"

    # apply and status, with a stand-in helper and papirus-folders.
    printf '#!/bin/sh\necho "$@" > "%s/helped"; [ "$1" = bad ] && { echo "bad is not a Papirus folder colour" >&2; exit 2; }; exit 0\n' "$pb" > "$pb/helper"
    printf '#!/bin/sh\nexit 0\n' > "$pb/bin/papirus-folders"
    chmod +x "$pb/helper" "$pb/bin/papirus-folders"
    printf '{"colours": {"primary": "4a90d9"}}\n' > "$pb/s/caelestia/scheme.json"
    echo papirus > "$pb/c/0xide/adapters.enabled"
    pst() { pbenv env OX_PAPIRUS_HELPER="$pb/helper" "$OX_ROOT/adapters/papirus/status"; }
    pap() { pbenv env OX_PAPIRUS_HELPER="$pb/helper" "$OX_ROOT/adapters/papirus/apply"; }
    hook() { pbenv env OX_PAPIRUS_HELPER="$pb/helper" "$OX_ROOT/orchestration/hooks/post-theme" >/dev/null 2>&1; cat "$pb/s/0xide/post-theme.log"; }
    if [ ! -d /usr/share/icons/Papirus ]; then
        out="$(pap)"; rc=$?
        [ "$rc" = 3 ] && grep -q 'the Papirus icon theme is not installed' <<<"$out" &&
            ok "without the Papirus theme, apply says so and does not claim success" || no "no Papirus theme: $rc $out"
        skipt "the Papirus icon theme is not installed here, so the rest of apply is not driven"
    elif ! "$(ox_python)" -c 'import caelestia.utils.theme' 2>/dev/null; then
        skipt "caelestia-cli's Python module is missing, so its colour mapping cannot be captured"
    else
        out="$(pap)"; rc=$?
        [ "$rc" = 3 ] && grep -q 'helper is not installed; install it with ./install --enable sudoers' <<<"$out" && [ ! -e "$pb/helped" ] &&
            ok "without the helper's rule, apply says what to install and changes nothing" || no "no rule: $rc $out"
        grep -qx 'papirus not applied (see above)' <<<"$(hook)" && ok "and the theme log says not applied, not ok" || no "post-theme: $(hook)"
        grep -q 'will NOT track the scheme' <<<"$(pst)" && ok "status says folders will not follow the scheme" || no "status without rule: $(pst)"
        echo "$pb/helper" > "$pb/rule"
        out="$(pap)"; rc=$?
        c="$(cat "$pb/helped" 2>/dev/null)"
        [ "$rc" = 0 ] && [ -n "$c" ] && [[ "$c" =~ ^[a-z]+$ ]] && grep -q "folders recoloured $c" <<<"$out" &&
            ok "with the rule, apply recolours through the helper with Caelestia's own colour ($c)" || no "with rule: $rc $out"
        grep -qx "papirus: ok, folders recoloured $c" <<<"$(pst)" && ok "status reports what the last theme change did" || no "status after apply: $(pst)"
        grep -qx 'papirus ok ([0-9]*s)' <<<"$(hook)" && ok "the theme log says ok only when it applied" || no "post-theme ok: $(hook)"
        printf '#!/bin/sh\necho "bad is not a Papirus folder colour" >&2; exit 2\n' > "$pb/helper"
        out="$(pap)"; rc=$?
        [ "$rc" = 1 ] && grep -q 'last theme change: the helper refused or failed: bad is not a Papirus folder colour' <<<"$(pst)" &&
            grep -q '^papirus FAILED (exit 1)$' <<<"$(hook)" &&
            ok "a refusal by the helper is a failure, in the log and in status" || no "helper refusal: $rc $(pst)"
        echo "/usr/bin/papirus-folders -C *" > "$pb/rule"
        grep -q 'older, wider sudo rule for papirus-folders' <<<"$(pst)" && ok "status warns about the old, wider rule" || no "old rule not reported: $(pst)"
    fi
    : > "$pb/c/0xide/adapters.enabled"
    [ "$(pst)" = "papirus: not enabled" ] && ok "status says not enabled when it is not" || no "status disabled: $(pst)"
    rm -rf "$pb"
fi

ox_step "Cursor: status says what is actually the matter"
cx="$(mktemp -d)"
mkdir -p "$cx/bin" "$cx/c/0xide" "$cx/s/0xide" "$cx/d/icons"
for t in sed grep tr head tail cat dirname mkdir mv; do ln -s "$(type -P "$t")" "$cx/bin/$t"; done
cst() { env -i HOME="$cx" PATH="$cx/bin" XDG_CONFIG_HOME="$cx/c" XDG_STATE_HOME="$cx/s" XDG_DATA_HOME="$cx/d" "$(type -P bash)" "$OX_ROOT/adapters/cursor/status"; }
out="$(cst)"; rc=$?
