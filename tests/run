ox_step "Speech model: why Download is off"
# The real Speech service in a private Quickshell, with a stand-in helper. The
# install dialog's Download was disabled with no reason when space was short,
# while the status was still loading, and when uv was missing.
if ox_have qs; then
    sx="$(mktemp -d)"
    mkdir -p "$sx/cfg/services" "$sx/cfg/assets/dictation" "$sx/bin" "$sx/xdg"
    cp "$OX_ROOT/shell/extensions/ai/tree/services/Speech.qml" "$sx/cfg/services/"
    printf '#!/bin/sh\n# uv run --no-project --python 3.13 SCRIPT ARGS\nshift 4\nexec "%s" "$@"\n' "$PY" > "$sx/bin/uv"
    chmod +x "$sx/bin/uv"
    cat > "$sx/cfg/assets/dictation/speech.py" <<'MOCK'
import json, os, sys, time
d = os.path.dirname(os.path.abspath(__file__))
mode = open(os.path.join(d, "status")).read().strip()
if mode == "slow":
    time.sleep(3)
info = {"installed": False, "model": "ggml-base.bin", "downloadBytes": 147951465,
        "freeBytes": 1e8 if mode == "disk" else 9e11, "destination": "/x/0xide/speech", "missing": []}
emit = lambda **e: print(json.dumps(e), flush=True)
if sys.argv[1] == "install":
    import signal
    signal.signal(signal.SIGTERM, lambda *_: (emit(stage="cancelled"), sys.exit(130)))
    time.sleep(0.4)
    for b in (0, 50000000, 147951465):
        emit(stage="download", bytes=b, total=147951465); time.sleep(0.3 if mode != "dlslow" else 5)
    if mode == "dlfail":
        emit(stage="error", error="The downloaded model does not match its pinned hash"); sys.exit(1)
    emit(stage="verify"); time.sleep(0.2)
    emit(stage="installed", **dict(info, installed=True)); sys.exit(0)
emit(stage="status", **info)
MOCK
    cat > "$sx/cfg/shell.qml" <<QML
import QtQuick
import Quickshell
import Quickshell.Io
import qs.services

ShellRoot {
    id: h

    property var r: ({})
    property int phase
    property real since: Date.now()

    function put(value: string): void {
        files.setText(value);
    }
    function next(): void {
        phase++;
        since = Date.now();
    }

    FileView { id: files; path: "$sx/cfg/assets/dictation/status"; blockWrites: true }
    Process { id: chmod; property bool done; onExited: done = true }

    Timer {
        interval: 100
        repeat: true
        running: true
        onTriggered: {
            const r = h.r;
            const waited = Date.now() - h.since;
            if (h.phase === 0 && !Speech.checking && Speech.info.destination) {
                r.ready = Speech.installBlocker === "";
                h.put("disk");
                Speech.refresh();
                h.next();
            } else if (h.phase === 1 && !Speech.checking && waited > 300) {
                r.blockDisk = Speech.installBlocker === "Needs 142 MiB free, 95 MiB free in /x/0xide/speech";
                h.put("slow");
                Speech.info = ({});
                Speech.refresh();
                h.next();
            } else if (h.phase === 2 && waited > 300) {
                r.blockChecking = Speech.checking && Speech.installBlocker === "Checking this computer...";
                h.next();
            } else if (h.phase === 3 && !Speech.checking) {
                h.put("ok");
                chmod.command = ["$(command -v chmod)", "-x", "$sx/bin/uv"];
                chmod.running = true;
                h.next();
            } else if (h.phase === 4 && chmod.done) {
                Speech.info = ({});
                Speech.refresh();
                Speech.install();
                h.next();
            } else if (h.phase === 5 && waited > 1000) {
                r.noUv = Speech.installBlocker === "Could not check dictation. Install uv first.";
                r.noUvInstall = Speech.error.startsWith("Could not start the speech model installer");
                chmod.done = false;
                chmod.command = ["$(command -v chmod)", "+x", "$sx/bin/uv"];
                chmod.running = true;
                h.next();
            } else if (h.phase === 6 && chmod.done) {
                Speech.refresh();
                h.next();
            } else if (h.phase === 7 && !Speech.checking && waited > 500) {
                r.recovers = Speech.installBlocker === "" && Speech.statusError === "";
                Speech.install();
                r.immediate = Speech.installing && Speech.stage === "starting" && Speech.outcome === "";
                h.next();
            } else if (h.phase === 8 && !Speech.installing && waited > 300) {
                r.installed = Speech.outcome === "installed" && Speech.bytes === 147951465 && Speech.error === "";
                h.put("dlfail");
                Speech.install();
                h.next();
            } else if (h.phase === 9 && !Speech.installing && waited > 300) {
                r.failed = Speech.outcome === "failed" && Speech.error === "The downloaded model does not match its pinned hash";
                h.put("dlslow");
                Speech.install();
                h.next();
            } else if (h.phase === 10 && Speech.stage === "download") {
                Speech.cancel();
                r.cancelling = Speech.installing && Speech.stage === "cancelling";
                h.next();
            } else if (h.phase === 11 && !Speech.installing && waited > 300) {
                r.cancelled = Speech.outcome === "cancelled";
                console.log("RESULT " + JSON.stringify(r));
                Qt.quit();
            } else if (waited > 15000) {
                console.log("RESULT " + JSON.stringify(Object.assign(r, {stuck: h.phase})));
                Qt.quit();
            }
        }
    }
}
QML
    printf ok > "$sx/cfg/assets/dictation/status"
