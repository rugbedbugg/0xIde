printf 'cursor ok (3s)\n' > "$cx/s/0xide/post-theme.log"; mkdir -p "$cx/d/icons/0xide-sweet"; : > "$cx/d/icons/0xide-sweet/index.theme"
out="$(cst)"; rc=$?
[ "$rc" = 0 ] && [ "$out" = "cursor: ok, 0xide-sweet follows the scheme" ] && ok "built and rebuilt is ok" || no "built: $rc $out"
rm -rf "$cx"

ox_step "install --status: installed, enabled, working, and why"
# Against a private home, with sudo, pactl and qs stood in for, so it reads
# nothing of this machine's own state.
sx="$(mktemp -d)"
mkdir -p "$sx/bin" "$sx/h"
printf '#!/bin/sh\nexit 1\n' > "$sx/bin/sudo"
printf '#!/bin/sh\nexit 0\n' > "$sx/bin/systemctl"
printf '#!/bin/sh\necho "No running instances"\n' > "$sx/bin/qs"
cat > "$sx/bin/pactl" <<STUB
#!/bin/sh
case "\$1" in
    list) [ -e "$sx/voice-src" ] && printf '7\t0xide_voice\tPipeWire\n' ;;
    get-default-source) cat "$sx/default" 2>/dev/null ;;
    set-default-source) echo "\$2" > "$sx/default" ;;
esac
STUB
chmod +x "$sx/bin/"*
stx() { env HOME="$sx/h" XDG_CONFIG_HOME="$sx/h/c" XDG_STATE_HOME="$sx/h/s" XDG_DATA_HOME="$sx/h/d" XDG_CACHE_HOME="$sx/h/k" \
    PATH="$sx/bin:$PATH" "$@"; }
line() { grep -E "^  $1: " <<<"$out" | head -1 | sed -E "s/^  $1: +//"; }
out="$(stx "$OX_ROOT/install" --status 2>&1)"; rc=$?
[ "$rc" = 1 ] && [ "$(line overrides)" = "not installed; run ./install --only overrides" ] &&
    ok "a fresh home: the overrides are reported missing, and status exits 1" || no "fresh overrides: $rc $(line overrides)"
[ "$(line voice)" = "not installed (optional: ./install --enable voice)" ] && [ "$(line shell)" = "not installed (optional: ./install --enable shell)" ] &&
    [ "$(line sudoers)" = "not installed (optional: ./install --enable sudoers)" ] && [ "$(line kde)" = "not enabled" ] &&
    ok "optional components that are off say so, without counting as broken" || no "fresh optional: $out"
grep -q '^  foot: *not set up here (no ~/c/foot/foot.ini)' <<<"$(stx env HOME="$sx/h" "$OX_ROOT/install" --status 2>&1 | sed "s|$sx/h|~|g")" &&
    ok "an application that is not set up is not a problem" || no "foot without foot.ini: $(line foot)"
stx "$OX_ROOT/install" --only overrides >/dev/null 2>&1
mkdir -p "$sx/h/c/foot"; printf 'font=x\n' > "$sx/h/c/foot/foot.ini"
mkdir -p "$sx/h/c/zed"; printf '{ "a": "x, "b": 1 }' > "$sx/h/c/zed/settings.json"
out="$(stx "$OX_ROOT/install" --status 2>&1)"
[ "$(line overrides)" = ok ] && ok "installed overrides are ok" || no "overrides after install: $(line overrides)"
[ "$(line foot)" = "not applied to ~/c/foot/foot.ini; run ./install --only foot" ] || [[ "$(line foot)" == "not applied to "*"; run ./install --only foot" ]] &&
    ok "an overlay not yet applied says so" || no "foot not applied: $(line foot)"
[[ "$(line zed)" == *"cannot be read; fix it, then run ./install --only zed" ]] && ok "an unreadable config is reported" || no "zed: $(line zed)"
stx "$OX_ROOT/install" --only foot >/dev/null 2>&1
out="$(stx "$OX_ROOT/install" --status 2>&1)"
[ "$(line foot)" = ok ] && ok "an applied overlay is ok" || no "foot after install: $(line foot)"
mkdir -p "$sx/h/c/0xide" "$sx/h/s/0xide"
printf 'kde\ngtk\nspotify\n' > "$sx/h/c/0xide/adapters.enabled"
printf 'kde ok (1s)\ngtk FAILED (exit 1)\nspotify: Spotify is not running; it is re-themed at the next theme change while it runs\nspotify not applied (see above)\n' > "$sx/h/s/0xide/post-theme.log"
out="$(stx "$OX_ROOT/install" --status 2>&1)"
[ "$(line kde)" = ok ] && ok "an adapter that applied is ok" || no "kde: $(line kde)"
[[ "$(line gtk)" == "the last theme change FAILED (exit 1); see "* ]] && ok "an adapter that failed is reported" || no "gtk: $(line gtk)"
if ox_have spicetify; then
    [ "$(line spotify)" = "enabled; not applied at the last theme change: Spotify is not running; it is re-themed at the next theme change while it runs" ] &&
        ok "an adapter that did not apply says why, without calling it ok" || no "spotify: $(line spotify)"
else
    [ "$(line spotify)" = "enabled, but spicetify is not installed" ] && ok "an enabled adapter without its tool names it" || no "spotify: $(line spotify)"
fi
stx "$OX_ROOT/install" --only voice >/dev/null 2>&1
out="$(stx "$OX_ROOT/install" --status 2>&1)"
[ "$(line voice)" = "installed, but PipeWire has no 0xide_voice source; see journalctl --user -u pipewire" ] &&
    ok "voice installed without its source is a problem, named" || no "voice without source: $(line voice)"
touch "$sx/voice-src"; echo alsa_input.x > "$sx/default"
out="$(stx "$OX_ROOT/install" --status 2>&1)"
[ "$(line voice)" = "installed, but the default microphone is alsa_input.x; run ./install --only voice" ] &&
    ok "voice whose source is not the default says which one is" || no "voice not default: $(line voice)"
echo 0xide_voice > "$sx/default"
out="$(stx "$OX_ROOT/install" --status 2>&1)"
[ "$(line voice)" = "ok, the default microphone is noise-suppressed" ] && ok "working voice is ok" || no "voice ok: $(line voice)"
rm -rf "$sx"

ox_step "Voice: every way it can fail is named"
vx="$(mktemp -d)"
mkdir -p "$vx/bin"
cat > "$vx/bin/pactl" <<STUB
#!/bin/sh
case "\$1" in
    list) [ -e "$vx/src" ] && printf '7\t0xide_voice\tPipeWire\n' ;;
    get-default-source) cat "$vx/default" 2>/dev/null ;;
    set-default-source) [ -e "$vx/nodefault" ] && { echo "Failure: No such entity" >&2; exit 1; }; echo "\$2" > "$vx/default" ;;
esac
STUB
printf '#!/bin/sh\n[ -e "%s/norestart" ] && { echo "Failed to connect to bus" >&2; exit 1; }; exit 0\n' "$vx" > "$vx/bin/systemctl"
chmod +x "$vx/bin/"*
vrun() { rm -rf "$vx/h"; env HOME="$vx/h" XDG_CONFIG_HOME="$vx/h/c" XDG_STATE_HOME="$vx/h/s" XDG_DATA_HOME="$vx/h/d" \
    PATH="$vx/bin:$PATH" "$OX_ROOT/install" --only voice 2>&1; }
touch "$vx/norestart"; out="$(vrun)"; rc=$?
[ "$rc" = 1 ] && grep -q 'PipeWire could not be restarted, so the noise-suppressed microphone is not loaded: Failed to connect to bus' <<<"$out" &&
    ok "a PipeWire restart that fails is reported, not swallowed" || no "restart failure: $rc $out"
rm "$vx/norestart"; out="$(vrun)"; rc=$?
[ "$rc" = 1 ] && grep -q 'did not appear in PipeWire' <<<"$out" && ! grep -q '^.*Done' <<<"$out" &&
    ok "a source that never appears is not Done" || no "no source: $rc"
touch "$vx/src" "$vx/nodefault"; echo alsa_input.mic > "$vx/default"; out="$(vrun)"; rc=$?
[ "$rc" = 1 ] && grep -q 'is there, but could not be made the default: Failure: No such entity' <<<"$out" &&
    [ "$(cat "$vx/default")" = alsa_input.mic ] &&
    ok "failing to switch the default is reported, and the old default is left" || no "default switch failure: $rc $out"
rm "$vx/nodefault"; out="$(vrun)"; rc=$?
[ "$rc" = 0 ] && grep -q 'it was alsa_input.mic; pactl set-default-source alsa_input.mic goes back' <<<"$out" &&
    ok "a working switch says which microphone it replaced and how to go back" || no "voice ok: $rc $out"
rm -rf "$vx"

ox_step "check_deps: one truth for what each feature runs"
# Only the base system's tools on PATH, so every feature tool is absent.
cdb="$(mktemp -d)"
for t in bash sed grep awk tr head tail cat sort xargs dirname basename paste mv mkdir; do ln -s "$(type -P "$t")" "$cdb/$t"; done
cd_out="$(env PATH="$cdb" bash "$OX_ROOT/installer/check_deps.sh" 2>&1)"; rc=$?
rm -rf "$cdb"
declared() { grep -qE "^  (ok|MISSING|absent) +$1 " <<<"$cd_out"; }
bad=""
# Local AI's build tools, as runtime.py's preflight lists them.
for t in $(sed -n "s/.*for tool in (\(.*\)) if not shutil.which.*/\1/p" "$OX_ROOT/shell/extensions/ai/tree/assets/ai/runtime.py" | tr -d "',"); do
    declared "$t" || bad="$bad $t(runtime.py)"
done
# Dictation's tools, as dictate.sh and speech.py check them.
for t in $(sed -n 's/^for tool in \(.*\); do$/\1/p' "$OX_ROOT/shell/extensions/ai/tree/assets/dictation/dictate.sh"); do
    declared "$t" || bad="$bad $t(dictate.sh)"
done
# Every command an adapter requires.
for conf in "$OX_ROOT"/adapters/*/adapter.conf; do
    for t in $(ox_pin "$conf" requires | tr ',' ' '); do declared "$t" || bad="$bad $t($(basename "$(dirname "$conf")"))"; done
done
for t in uv pactl gio fuzzel curl xdg-open; do declared "$t" || bad="$bad $t"; done
[ -z "$bad" ] && ok "every tool a feature checks for is in check_deps" || no "check_deps does not report:$bad"
dups="$(grep -oE '^  (ok|MISSING|absent) +[^ ]+' <<<"$cd_out" | awk '{print $2}' | sort | uniq -d | tr '\n' ' ')"
[ -z "$dups" ] && ok "each tool is reported once" || no "reported twice: $dups"
[ "$rc" = 1 ] && [ "$(grep -c MISSING <<<"$cd_out")" = 2 ] && grep -qE '^  absent +spicetify +adapters: spotify \(optional\)$' <<<"$cd_out" &&
    ok "only the installer's own tools are required; an adapter's are optional" || no "check_deps with nothing installed: $rc $(grep MISSING <<<"$cd_out" | tr '\n' ' ')"
grep -qE 'spotify|firefox|zed' <<<"$(grep -oE '^  (ok|MISSING|absent) +[^ ]+' <<<"$cd_out")" &&
    no "a themed application is listed as a dependency" || ok "applications an adapter themes are not listed as dependencies"

ox_step "Local AI: server actions follow the server"
bad=""
for f in "$OX_ROOT/shell/extensions/ai/tree/modules/nexus/pages/AiPage.qml" "$OX_ROOT/shell/extensions/ai/tree/modules/areapicker/AiSettings.qml"; do
    awk '/Stop server/{print prev2; print prev} {prev2=prev; prev=$0}' "$f" | grep -q 'visible: AiRuntime.serverState === "running" || AiRuntime.serverState === "starting"' ||
        bad="$bad $(basename "$f")"
done
[ -z "$bad" ] && ok "Stop server is offered only while a server is starting or running" || no "Stop server shown without a server in:$bad"
if ox_have qs; then
    nx="$(mktemp -d)"
    mkdir -p "$nx/cfg/services" "$nx/bin" "$nx/run"
    cp "$OX_ROOT/shell/extensions/ai/tree/services/AiRuntime.qml" "$nx/cfg/services/"
    cat > "$nx/cfg/shell.qml" <<'QML'
import QtQuick
import Quickshell
import qs.services

ShellRoot {
    property var r: ({})
    Timer {
        interval: 400
        repeat: true
        running: true
        property int n: 0
        onTriggered: {
            n++;
            if (n === 1) {
                AiRuntime.start();
            } else if (n === 3) {
                r.first = AiRuntime.error.startsWith("Could not start local AI") && AiRuntime.serverState === "";
                AiRuntime.error = "";
                AiRuntime.start();
            } else if (n === 5) {
                r.again = AiRuntime.error.startsWith("Could not start local AI");
                console.log("RESULT " + JSON.stringify(r));
                Qt.quit();
            }
        }
    }
}
QML
    res="$(cd "$nx" && timeout 30 env PATH="$nx/bin" XDG_RUNTIME_DIR="$nx/run" QT_QPA_PLATFORM=offscreen "$(command -v qs)" -p "$nx/cfg/shell.qml" 2>&1 | sed -n 's/.*RESULT //p')"
    [[ "$res" == *'"first":true'* && "$res" == *'"again":true'* ]] &&
        ok "a server that cannot start is reported every time, not only the first" || no "server start failure: $res"
    rm -rf "$nx"
fi

ox_step "Translation: explicit intent and visible preparation"
page="$OX_ROOT/shell/extensions/ai/tree/modules/nexus/pages/AiPage.qml"
"$PY" - "$page" <<'CHK' && ok "adding or removing a language happens on Enter only, never on focus loss or closing" || no "a language row still acts on editingFinished"
import re, sys
src = open(sys.argv[1]).read()
for row in ("addLanguage", "removeLanguage"):
    body = re.search(r"TextFieldRow \{\s*id: %s\b(.*?)\n        \}" % row, src, re.S).group(1)
    assert "onEditingFinished" not in body, row
    assert re.search(r"function onAccepted\(\): void \{[^}]*%s\.field\.text" % row, src, re.S), row
    assert re.search(r"target: %s\.field" % row, src), row
CHK
if ox_have qs; then
    tx="$(mktemp -d)"
    mkdir -p "$tx/cfg/services" "$tx/cfg/assets/ai" "$tx/bin" "$tx/run"
    cp "$OX_ROOT/shell/extensions/ai/tree/services/Translator.qml" "$tx/cfg/services/"
    printf '#!/bin/sh\nshift 4\nexec "%s" "$@"\n' "$PY" > "$tx/bin/uv"; chmod +x "$tx/bin/uv"
    cat > "$tx/cfg/assets/ai/translate.py" <<'MOCK'
import json, sys, time
if sys.argv[1] == "status":
    print(json.dumps({"stage": "status", "installed": ["de", "en"], "available": []})); sys.exit(0)
stage = lambda s: print(json.dumps({"stage": s}), file=sys.stderr, flush=True)
if sys.argv[4] == "fail":
    stage("preparing"); time.sleep(0.6)
    print("error: Failed to download ctranslate2==4.8.2: network unreachable", file=sys.stderr); sys.exit(2)
stage("preparing"); time.sleep(0.6); stage("translating"); time.sleep(0.6)
sys.stdout.write("Hallo"); sys.exit(0)
MOCK
    cat > "$tx/cfg/shell.qml" <<QML
import QtQuick
import Quickshell
import Quickshell.Io
import qs.services

ShellRoot {
    id: h

    property var r: ({})
    property var seen: []
    property int phase
    property real since: Date.now()

    function next(): void {
        phase++;
        since = Date.now();
    }

    Connections {
        function onTranslationStageChanged(): void {
            if (Translator.translationStage)
                h.seen.push(Translator.translationStage);
        }
        function onTranslated(text: string): void {
            h.r.result = text;
        }
        function onFailed(error: string): void {
            h.r.failure = error;
        }
        target: Translator
    }
    Process { id: sh; property bool done; command: ["$(type -P chmod)", "-x", "$tx/bin/uv"]; onExited: done = true }

    Timer {
        interval: 100
        repeat: true
        running: true
        onTriggered: {
            const r = h.r;
            const waited = Date.now() - h.since;
            if (h.phase === 0) {
                Translator.translate("Hello", "en", "de");
                r.immediate = Translator.translating && Translator.translationLabel === "Starting offline translation…";
                h.next();
            } else if (h.phase === 1 && Translator.translationStage === "preparing") {
                r.preparingLabel = Translator.translationLabel.startsWith("Preparing the offline translation runtime");
                h.next();
            } else if (h.phase === 2 && !Translator.translating && waited > 300) {
                r.stages = h.seen.join() === "starting,preparing,translating";
                r.done = r.result === "Hallo" && Translator.translationStage === "";
                Translator.translate("fail", "en", "de");
                h.next();
            } else if (h.phase === 3 && !Translator.translating && waited > 300) {
                r.realError = r.failure === "error: Failed to download ctranslate2==4.8.2: network unreachable";
                r.failure = "";
                sh.running = true;
                h.next();
            } else if (h.phase === 4 && sh.done) {
                Translator.translate("Hello", "en", "de");
                h.next();
            } else if (h.phase === 5 && waited > 800) {
                r.noUv = r.failure === "Could not start offline translation. Install uv first." && Translator.translationStage === "";
                console.log("RESULT " + JSON.stringify(r));
                Qt.quit();
            } else if (waited > 15000) {
                console.log("RESULT " + JSON.stringify(Object.assign(r, {stuck: h.phase})));
                Qt.quit();
            }
        }
    }
}
QML
    res="$(cd "$tx" && timeout 60 env PATH="$tx/bin" XDG_RUNTIME_DIR="$tx/run" QT_QPA_PLATFORM=offscreen \
        "$(command -v qs)" -p "$tx/cfg/shell.qml" 2>&1 | sed -n 's/.*RESULT //p' | tail -1)"
    for c in "immediate:a translation shows that it started at once" \
             "preparingLabel:preparing the runtime says so, as a step, without a percentage" \
             "stages:every step is shown in order" \
             "done:the result arrives and the step clears" \
             "realError:a runtime that could not be prepared shows uv's own error" \
             "noUv:without uv it says so instead of hanging"; do
        key="${c%%:*}"
        case "$res" in *"\"$key\":true"*) ok "${c#*:}" ;; *) no "${c#*:} ($res)" ;; esac
    done
    rm -rf "$tx"
else
    skipt "qs is not installed"
fi

ox_step "Dictation: the listener and the model download fail visibly"
dx="$(mktemp -d)"
mkdir -p "$dx/bin" "$dx/a" "$dx/data/0xide/speech"
cp "$OX_ROOT/shell/extensions/ai/tree/assets/dictation/speech.py" "$dx/a/"
printf '{"model": {"file": "m.bin", "bytes": 3, "repo": "r", "revision": "v", "sha256": "0"}}\n' > "$dx/a/speech.json"
printf 'abc' > "$dx/data/0xide/speech/m.bin"
cat > "$dx/bin/whisper-server" <<STUB
#!$PY
import socket, sys, time
port = int(sys.argv[sys.argv.index("--port") + 1])
s = socket.socket(); s.bind(("127.0.0.1", port)); s.listen()
time.sleep(30)
STUB
printf '#!/bin/sh\necho "pw-record: no target node available" >&2\nexit 1\n' > "$dx/bin/pw-record"
printf '#!/bin/sh\necho "Compositor does not support the virtual keyboard protocol" >&2\nexit 1\n' > "$dx/bin/wtype"
printf '#!/bin/sh\nprintf "%%s\\n" "$*" >> "%s/notified"\n' "$dx" > "$dx/bin/notify-send"
chmod +x "$dx/bin/"*
out="$(cd "$dx" && timeout 30 env PATH="$dx/bin:$PATH" XDG_DATA_HOME="$dx/data" "$PY" "$dx/a/speech.py" listen --language en 2>"$dx/err")"; rc=$?
[ "$rc" = 1 ] && grep -q '"error": "The microphone stream ended (pw-record exited 1)"' <<<"$out" && grep -q 'no target node available' "$dx/err" &&
    ok "a microphone stream that ends is an error, with pw-record's reason in the log" || no "stream end: $rc $out"
pgrep -f "$dx/bin/whisper-server" >/dev/null && no "whisper-server was left running" || ok "and whisper-server is stopped with it"
out="$(cd "$dx/a" && PATH="$dx/bin:$PATH" XDG_DATA_HOME="$dx/data" "$PY" -c 'import speech; t = speech.Typist(); t.type("one"); t.type("two")')"
[ "$(grep -c '"error": "Could not type: Compositor does not support the virtual keyboard protocol"' <<<"$out")" = 2 ] &&
    [ "$(grep -c 'Dictation could not type' "$dx/notified" 2>/dev/null)" = 1 ] &&
    ok "text that cannot be typed is reported, once on screen and every time in the log" || no "typing failure: $out / $(cat "$dx/notified" 2>/dev/null)"
cat > "$dx/slow.py" <<'PY'
import sys, time, urllib.request
sys.path.insert(0, sys.argv[1])
import speech
speech.MANIFEST['bytes'] = 10**9
class Slow:
    headers = {}
    def __enter__(self): return self
    def __exit__(self, *a): return False
    def read(self, n):
        time.sleep(0.1); return b"x" * 1024
urllib.request.urlopen = lambda *a, **k: Slow()
sys.argv = ["speech.py", "install"]
sys.exit(speech.main())
PY
rm -f "$dx/data/0xide/speech/m.bin"
XDG_DATA_HOME="$dx/data" "$PY" "$dx/slow.py" "$dx/a" > "$dx/install.out" 2>&1 &
ip=$!
for _ in $(seq 50); do [ -e "$dx/data/0xide/speech/m.bin.partial" ] && break; sleep 0.1; done
sleep 0.3; kill -TERM "$ip"; wait "$ip"; rc=$?
[ "$rc" = 130 ] && grep -q '"stage": "cancelled"' "$dx/install.out" && [ -z "$(find "$dx/data/0xide/speech" -name 'm.bin*')" ] &&
    ok "a cancelled model download leaves no partial file" || no "download cancel: $rc $(ls "$dx/data/0xide/speech") $(tail -2 "$dx/install.out")"
grep -q '"stage": "download", "bytes": 0' "$dx/install.out" && ok "the download is shown from its first byte" || no "no download event before data"
rm -rf "$dx"

ox_step "Settings: reasons are shown whole"
AIP="$OX_ROOT/shell/extensions/ai/tree/modules/nexus/pages/AiPage.qml"
! grep -q '^        InfoRow {' "$AIP" && [ "$(grep -c '^        StatusRow {' "$AIP")" = 4 ] &&
    grep -q 'wrapMode: Text.Wrap' "$OX_ROOT/shell/extensions/ai/tree/components/StatusRow.qml" &&
    ok "the OCR, local model, translation and speech rows wrap their reasons instead of cutting them" || no "a status row still elides its reason"
grep -q 'text: qsTr("Not switched: %1").arg(DesktopProfiles.error)' "$OX_ROOT/shell/extensions/desktop-profile/tree/modules/nexus/pages/ThemePage.qml" &&
    ok "a profile switch failure is shown in full" || no "the profile switch failure is cut to one line"

ox_step "Patch series order"
dups="$(ls "$OX_ROOT/shell/patches" | cut -c1-4 | sort | uniq -d | tr '\n' ' ')"
[ -z "$dups" ] && ok "every shell patch has its own number, so glob order is the series order" || no "duplicate patch numbers: $dups"

ox_step "Dependencies"
"$OX_ROOT/installer/check_deps.sh" || true

# Nothing may follow this: the script's exit status is this comparison.
printf '\n%s passed, %s failed, %s skipped\n' "$pass" "$fail" "$skip"
[ "$fail" -eq 0 ]
