import QtQuick
import Quickshell
import Quickshell.Io
import qs.services

ShellRoot {
    id: h

    property var r: ({})
    property int phase
    property real since: Date.now()

    function next(): void {
        phase++;
        since = Date.now();
    }

    // The singleton is created, and checks the list, when first used.
    Component.onCompleted: Translator.refresh()

    Process { id: chmod; property bool done; onExited: done = true }

    Timer {
        interval: 100
        repeat: true
        running: true
        onTriggered: {
            const r = h.r;
            const waited = Date.now() - h.since;
            if (h.phase === 0 && waited > 1000) {
                r.noUv = Translator.statusError === "Could not load the language list. Install uv first." && !Translator.available.length;
                chmod.command = ["$(command -v chmod)", "+x", "$lx/bin/uv"];
                chmod.running = true;
                h.next();
            } else if (h.phase === 1 && chmod.done) {
                Translator.refresh();
                h.next();
            } else if (h.phase === 2 && waited > 1000) {
                r.recovers = Translator.statusError === "" && Translator.available.length === 1;
                console.log("RESULT " + JSON.stringify(r));
                Qt.quit();
            } else if (waited > 15000) {
                console.log("RESULT " + JSON.stringify(Object.assign(r, {stuck: h.phase})));
                Qt.quit();
            }
        }
    }
}
