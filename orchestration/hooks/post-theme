#!/usr/bin/env bash
# Caelestia's theme.postHook. Runs after every colour apply, with
# $SCHEME_COLOURS and $SCHEME_MODE set by caelestia-cli.
#
# This file contains no application logic. It decides which adapters are
# enabled and runs them; what each one does to which application is the
# adapter's business.
set -uo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../lib/common.sh"

ENABLED="$OX_CONFIG/adapters.enabled"
[ -r "$ENABLED" ] || exit 0

log="$OX_STATE/post-theme.log"
mkdir -p "$OX_STATE"
# One run's worth, not a growing file: this runs on every wallpaper change.
: > "$log"

failed=0
while IFS= read -r name; do
    case "$name" in ''|'#'*) continue ;; esac
    # An adapter's runtime action, or a system module's sync where the module
    # is privileged enough that its whole directory lives under system/.
    apply="$OX_ROOT/adapters/$name/apply"
    [ -x "$apply" ] || apply="$OX_ROOT/system/$name/sync"
    [ -x "$apply" ] || continue

    # Exit 3 is an adapter saying it cannot apply on this system, with its
    # reason already in the log: not ok, and not a failure of the run either.
    start=$SECONDS
    "$apply" >>"$log" 2>&1
    rc=$?
    case $rc in
        0) printf '%s ok (%ss)\n' "$name" "$((SECONDS - start))" >> "$log" ;;
        3) printf '%s not applied (see above)\n' "$name" >> "$log" ;;
        *) printf '%s FAILED (exit %s)\n' "$name" "$rc" >> "$log"
           failed=$((failed + 1)) ;;
    esac
done < "$ENABLED"

# A failing adapter must never make `caelestia scheme set` look broken, so this
# always succeeds; ./install --status is where failures are surfaced.
[ "$failed" -eq 0 ] || printf '%s adapter(s) failed; see %s\n' "$failed" "$log" >&2
exit 0
