#!/usr/bin/env bash
# 0xIde installer.
#
#   ./install                      install every default component
#   ./install --enable sddm        also install a component that is off by default
#   ./install --disable spotify    skip one that is on by default
#   ./install --only shell         install just these
#   ./install --status             report what is installed and working
#   ./install --list               list components
#   ./install --dry-run            print what would change, change nothing
#
# Nothing requiring root is ever in the default set, and every privileged step
# prints what it will do and asks first.
set -uo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/orchestration/lib/common.sh"

REG="$OX_ROOT/installer/components.conf"
DRY=0; MODE=install
declare -a ENABLE=() DISABLE=() ONLY=()

while [ $# -gt 0 ]; do
    case "$1" in
        --enable)  ENABLE+=("$2"); shift 2 ;;
        --disable) DISABLE+=("$2"); shift 2 ;;
        --only)    ONLY+=("$2"); shift 2 ;;
        --status)  MODE=status; shift ;;
        --list)    MODE=list; shift ;;
        --dry-run) DRY=1; shift ;;
        -h|--help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) ox_die "unknown option $1 (try --help)" ;;
    esac
done

field() { printf '%s' "$1" | awk -F: -v n="$2" '{gsub(/^[ \t]+|[ \t]+$/,"",$n); print $n}'; }

# A typo in --only/--enable/--disable must not look like a successful no-op.
validate_names() {
    local name known
    for name in "$@"; do
        known=0
        while IFS= read -r line; do
            [ "$(field "$line" 1)" = "$name" ] && known=1
        done < <(components)
        [ "$known" = 1 ] || ox_die "unknown component '$name' (try ./install --list)"
    done
}
components() { grep -vE '^\s*(#|$)' "$REG"; }
in_list() { local n="$1"; shift; for x in "$@"; do [ "$x" = "$n" ] && return 0; done; return 1; }

selected() {
    local name="$1" default="$2"
    [ ${#ONLY[@]} -gt 0 ] && { in_list "$name" "${ONLY[@]}"; return; }
    in_list "$name" "${DISABLE[@]+"${DISABLE[@]}"}" && return 1
    in_list "$name" "${ENABLE[@]+"${ENABLE[@]}"}" && return 0
    [ "$default" = on ]
}

validate_names "${ONLY[@]+"${ONLY[@]}"}" "${ENABLE[@]+"${ENABLE[@]}"}" "${DISABLE[@]+"${DISABLE[@]}"}"

# ---------------------------------------------------------------- list/status
if [ "$MODE" = list ]; then
    printf '%-12s %-10s %-8s %s\n' NAME KIND DEFAULT DESCRIPTION
    while IFS= read -r line; do
        printf '%-12s %-10s %-8s %s\n' \
            "$(field "$line" 1)" "$(field "$line" 2)" "$(field "$line" 3)" "$(field "$line" 4)"
    done < <(components)
    exit 0
fi

if [ "$MODE" = status ]; then
    # One line per component: installed or not, enabled or not, working or
    # not, and why. A preference alone is never reported as working.
    problems=0
    say() { printf '  %-10s %s\n' "$1:" "$2"; }
    bad() { say "$1" "$2"; problems=$((problems + 1)); }

    # Exactly what ./install would write, compared with what is there.
    rendered_matches() {
        local dest="$1" src="$2" render="${3:-}"
        [ -e "$dest" ] || return 2
        if [ -n "$render" ]; then cmp -s "$dest" <(ox_render_path @OX_ROOT@ "$OX_ROOT" < "$src")
        else cmp -s "$dest" "$src"; fi
    }
    status_overrides() {
        local f stale="" missing=0 r
        for f in 0xide-binds.lua:caelestia/0xide-binds.lua: hypr-vars.lua:caelestia/hypr-vars.lua: \
                 hypr-user.lua:caelestia/hypr-user.lua:render cli.json:caelestia/cli.json:render \
                 user-config.fish:fish/user-config.fish:; do
            IFS=: read -r name src render <<<"$f"
            rendered_matches "$OX_CAELCONF/$name" "$OX_ROOT/overrides/$src" "$render"; r=$?
            [ "$r" = 2 ] && missing=$((missing + 1))
            [ "$r" != 0 ] && stale="$stale $name"
        done
        "$(ox_python)" "$OX_ROOT/installer/apply_overlay.py" "$OX_ROOT/overrides/caelestia/shell.json" \
            "$OX_CAELCONF/shell.json" --json --check >/dev/null 2>&1 || stale="$stale shell.json"
        if [ "$missing" = 5 ]; then bad overrides "not installed; run ./install --only overrides"
        elif [ -n "$stale" ]; then bad overrides "out of date:$stale; run ./install --only overrides"
        else say overrides "ok"; fi
    }
    # An overlay on another application's own config file.
    status_overlay() {
        local name="$1" overlay="$2" target="$3" style="$4" rc
        if [ ! -e "$target" ]; then say "$name" "not set up here (no ${target/#$HOME/\~}); nothing to apply"; return; fi
        "$(ox_python)" "$OX_ROOT/installer/apply_overlay.py" "$overlay" "$target" "$style" --check >/dev/null 2>&1; rc=$?
        case $rc in
            0) say "$name" "ok" ;;
            1) bad "$name" "not applied to ${target/#$HOME/\~}; run ./install --only $name" ;;
            *) bad "$name" "${target/#$HOME/\~} cannot be read; fix it, then run ./install --only $name" ;;
        esac
    }
    status_firefox() {
        local src="$XDG_STATE_HOME/caelestia/dots/firefox" profile n=0 stale=0
        [ -r "$src/userChrome.css" ] || { say firefox "no Caelestia dots checkout at ${src/#$HOME/\~}; nothing to apply"; return; }
        for profile in "$HOME/.mozilla/firefox"/*.default*/ "$XDG_CONFIG_HOME/mozilla/firefox"/*.default*/; do
            [ -d "$profile" ] || continue
            n=$((n + 1))
            cmp -s "$profile/chrome/userChrome.css" "$src/userChrome.css" || stale=$((stale + 1))
        done
        if [ "$n" = 0 ]; then say firefox "no Firefox profile yet; start Firefox once, then run ./install --only firefox"
        elif [ "$stale" -gt 0 ]; then bad firefox "not applied in $stale of $n profile(s); run ./install --only firefox"
        else say firefox "ok in $n profile(s)"; fi
    }
    status_voice() {
        local conf="$XDG_CONFIG_HOME/pipewire/pipewire.conf.d/60-0xide-voice.conf" def
        [ -e "$conf" ] || { say voice "not installed (optional: ./install --enable voice)"; return; }
        cmp -s "$conf" "$OX_ROOT/overrides/pipewire/60-0xide-voice.conf" || { bad voice "out of date; run ./install --only voice"; return; }
        ox_have pactl || { bad voice "installed, but pactl is not installed, so it cannot be checked"; return; }
        pactl list short sources 2>/dev/null | grep -q '\b0xide_voice\b' ||
            { bad voice "installed, but PipeWire has no 0xide_voice source; see journalctl --user -u pipewire"; return; }
        def="$(pactl get-default-source 2>/dev/null)"
        [ "$def" = 0xide_voice ] && say voice "ok, the default microphone is noise-suppressed" ||
            bad voice "installed, but the default microphone is ${def:-unknown}; run ./install --only voice"
    }
    # An adapter's own status where it has one; otherwise whether it is
    # enabled, can run, and what the last theme change did with it.
    status_adapter() {
        local name="$1" st="$OX_ROOT/adapters/$1/status" missing last why line out rc
        if [ -x "$st" ]; then
            out="$("$st" 2>&1)" && rc=0 || rc=$?
            # Its own words, set out like every other line; non-zero is a problem.
            while IFS= read -r line; do
                case "$line" in
                    "$name: "*) printf '  %-10s %s\n' "$name:" "${line#"$name: "}" ;;
                    *) printf '  %-10s %s\n' "" "${line#"${line%%[![:space:]]*}"}" ;;
                esac
            done <<<"$out"
            [ "$rc" = 0 ] || problems=$((problems + 1))
            return
        fi
        missing="$(ox_adapter_missing "$name")"
        if ! ox_adapter_enabled "$name"; then say "$name" "not enabled${missing:+ (it needs $missing)}"; return; fi
        [ -z "$missing" ] || { bad "$name" "enabled, but $missing is not installed"; return; }
        last="$(ox_theme_result "$name")"
        case "$last" in
            ok) say "$name" "ok" ;;
            "not applied")
                why="$(grep -B1 -x "$name not applied (see above)" "$OX_STATE/post-theme.log" | head -1)"
                say "$name" "enabled; not applied at the last theme change: ${why#"$name: "}" ;;
            FAILED*) bad "$name" "the last theme change $last; see $OX_STATE/post-theme.log" ;;
            *) say "$name" "enabled; it runs on the next theme change" ;;
        esac
    }
    status_sudoers() {
        local helper=/usr/local/libexec/0xide-papirus-folders
        if [ -x "$helper" ] && ox_has_sudo_rule "$helper"; then say sudoers "ok, the papirus helper and its rule are installed"
        elif ox_wide_papirus_rules | grep -qx /etc/sudoers.d/0xide; then bad sudoers "the older, wider 0xIde rule for papirus-folders is installed; ./install --enable sudoers replaces it"
        elif [ -e "$helper" ]; then bad sudoers "the papirus helper is installed but its rule is not; run ./install --enable sudoers"
        else say sudoers "not installed (optional: ./install --enable sudoers)"; fi
    }
    status_sddm() {
        local dir=/usr/share/sddm/themes/0xide helper=/usr/local/libexec/0xide-sddm-sync last
        [ -d "$dir" ] || { say sddm "not installed (optional: ./install --enable sddm)"; return; }
        grep -qx 'Current=0xide' /etc/sddm.conf.d/zz-0xide.conf 2>/dev/null ||
            { bad sddm "the theme is installed, but SDDM is not set to use it; run ./install --enable sddm"; return; }
        { [ -x "$helper" ] && ox_has_sudo_rule "$helper"; } ||
            { bad sddm "installed, but its sync helper or rule is missing, so it will not follow the desktop; run ./install --enable sddm"; return; }
        last="$(ox_theme_result sddm)"
        case "$last" in
            FAILED*) bad sddm "installed; the last theme change $last; see $OX_STATE/post-theme.log" ;;
            *) say sddm "ok, the login screen follows the desktop" ;;
        esac
    }
    status_shell() {
        local running
        if [ ! -e "$OX_SHELLDIR/shell.qml" ]; then say shell "not installed (optional: ./install --enable shell)"; return; fi
        grep -q "QML_IMPORT_PATH=$OX_QMLDIR\$" "$OX_SHELLDIR/shell.qml" ||
            { bad shell "installed, but its plugin import path is not this repository's; run ./install --only shell"; return; }
        if ox_have qs; then
            running="$(qs list --all -j 2>/dev/null | ox_strip_qt_locale_warning |
                jq --arg p "$OX_SHELLDIR/shell.qml" '[.[]? | select(.config_path == $p)] | length' 2>/dev/null)"
            case "${running:-0}" in
                0) say shell "installed, plugin -> $OX_QMLDIR; not running" ;;
                1) say shell "ok, installed and running" ;;
                *) bad shell "installed, but $running copies are running; ./installer/shell-handoff restart" ;;
            esac
        else say shell "installed, plugin -> $OX_QMLDIR"; fi
    }

    ox_step "Components"
    while IFS= read -r line; do
        name="$(field "$line" 1)"; kind="$(field "$line" 2)"
        case "$kind:$name" in
            overrides:overrides) status_overrides ;;
            overrides:foot)      status_overlay foot "$OX_ROOT/overrides/foot/overlay.conf" "$XDG_CONFIG_HOME/foot/foot.ini" --ini ;;
            overrides:starship)  status_overlay starship "$OX_ROOT/overrides/starship/overlay.toml" "$XDG_CONFIG_HOME/starship.toml" --toml ;;
            overrides:zed)       status_overlay zed "$OX_ROOT/overrides/zed/overlay.jsonc" "$XDG_CONFIG_HOME/zed/settings.json" --jsonc ;;
            overrides:firefox)   status_firefox ;;
            overrides:voice)     status_voice ;;
            shell:*)             status_shell ;;
            adapter:*)           status_adapter "$name" ;;
            system:sudoers)      status_sudoers ;;
            system:sddm)         status_sddm ;;
        esac
    done < <(components)

    ox_step "Theme hook"
    hook="$(jq -r '.theme.postHook // empty' "$OX_CAELCONF/cli.json" 2>/dev/null)"
    if [ "$hook" = "$OX_ROOT/orchestration/hooks/post-theme" ]; then
        echo "  postHook -> this repository"
    elif [ -n "$hook" ]; then
        echo "  postHook -> $hook  (not this repository)"; problems=$((problems + 1))
    else
        echo "  postHook not set; adapters will not run on a theme change"; problems=$((problems + 1))
    fi

    if [ "$problems" -gt 0 ]; then
        ox_step "$problems component(s) need attention (above)"
        exit 1
    fi
    ox_step "Everything installed is working"
    exit 0
fi

# -------------------------------------------------------------------- install
# In a dry run the overlay applier reports what it would change instead of
# writing, and everything else is skipped with a note.
CHECK=""; [ "$DRY" = 1 ] && CHECK="--check"

run() {
    if [ "$DRY" = 1 ]; then ox_log "would run: ${*#$OX_ROOT/}"; return 1; fi
    "$@"
}

# Components that did not take effect. The rest still install, as before, but
# the run ends by naming these and exits 1 rather than printing Done.
declare -a FAILED=()
failed() { FAILED+=("$1"); }

# apply_overlay.py exits 0 when the target is current or was updated, 1 when a
# dry run would change it, and 2 (or a crash) when it could not update it.
overlay() {
    local name="$1"; shift
    "$(ox_python)" "$OX_ROOT/installer/apply_overlay.py" "$@" $CHECK
    case $? in
        0) ;;
        1) [ "$DRY" = 1 ] || failed "$name" ;;
        *) failed "$name" ;;
    esac
}

# An adapter names the commands it needs in its adapter.conf. Missing ones mean
# the target application is not installed, which is a reason to skip it, not to
# fail: a user who has no Spotify should still be able to run ./install.
adapter_missing() { ox_adapter_missing "$1"; }

enable_adapter() {
    [ "$DRY" = 1 ] && { ox_log "would enable adapter $1"; return 0; }
    mkdir -p "$OX_CONFIG"
    touch "$OX_CONFIG/adapters.enabled"
    grep -qx "$1" "$OX_CONFIG/adapters.enabled" || printf '%s\n' "$1" >> "$OX_CONFIG/adapters.enabled"
}

install_overrides() {
    # hypr-vars.lua requires 0xide-binds.lua, and Hyprland reloads as soon as
    # hypr-vars.lua changes, so the module is in place first.
    if run ox_install_file "$OX_CAELCONF/0xide-binds.lua" 644 < "$OX_ROOT/overrides/caelestia/0xide-binds.lua"; then
        ox_log "0xide-binds.lua"
    fi
    run ox_own "$OX_CAELCONF/0xide-binds.lua"
    if run ox_install_file "$OX_CAELCONF/hypr-vars.lua" 644 < "$OX_ROOT/overrides/caelestia/hypr-vars.lua"; then
        ox_log "hypr-vars.lua"
    fi
    run ox_own "$OX_CAELCONF/hypr-vars.lua"
    # shell.json is also written by the shell's settings UI, so only the keys
    # the overlay names are set; everything else in it is the user's.
    "$(ox_python)" "$OX_ROOT/installer/apply_overlay.py" \
        "$OX_ROOT/overrides/caelestia/shell.json" "$OX_CAELCONF/shell.json" --json $CHECK
    case $? in
        0|1) ;;
        *) ox_warn "shell.json was left as it is; fix it and run ./install --only overrides again"
           failed overrides ;;
    esac
    # cli.json and hypr-user.lua carry this checkout's path, so they are
    # rendered, not copied.
    ox_path_substitutable "$OX_ROOT" ||
        ox_die "the checkout path must not contain a quote, backslash or newline: $OX_ROOT"
    for f in cli.json hypr-user.lua; do
        if [ "$DRY" = 1 ]; then ox_log "would render $f with this checkout's path"; continue; fi
        ox_render_path @OX_ROOT@ "$OX_ROOT" < "$OX_ROOT/overrides/caelestia/$f" |
            ox_install_file "$OX_CAELCONF/$f" 644 && ox_log "$f"
        ox_own "$OX_CAELCONF/$f"
    done
    if run ox_install_file "$OX_CAELCONF/user-config.fish" 644 < "$OX_ROOT/overrides/fish/user-config.fish"; then
        ox_log "user-config.fish"
    fi
    run ox_own "$OX_CAELCONF/user-config.fish"
}

# A noise-suppressed microphone. PipeWire reads its drop-ins only when it
# starts, so it is restarted when the file changes, and the new source is made
# the default so every application records through it.
install_voice() {
    local dest="$XDG_CONFIG_HOME/pipewire/pipewire.conf.d/60-0xide-voice.conf" err previous
    if run ox_install_file "$dest" 644 < "$OX_ROOT/overrides/pipewire/60-0xide-voice.conf"; then
        ox_log "60-0xide-voice.conf"
        # PipeWire reads drop-ins only when it starts.
        if ! err="$(systemctl --user restart pipewire pipewire-pulse wireplumber 2>&1)"; then
            ox_warn "PipeWire could not be restarted, so the noise-suppressed microphone is not loaded: ${err:-systemctl failed}"
            failed voice
            return 0
        fi
    fi
    run ox_own "$dest"
    [ "$DRY" = 1 ] && return 0
    if ! ox_have pactl; then
        ox_warn "pactl is not installed, so the noise-suppressed microphone cannot be found or made the default; install it (libpulse) and run ./install --only voice again"
        failed voice
        return 0
    fi
    local tries=0
    until pactl list short sources 2>/dev/null | grep -q '\b0xide_voice\b' || [ "$tries" -ge 40 ]; do
        sleep 0.25; tries=$((tries + 1))
    done
    if ! pactl list short sources 2>/dev/null | grep -q '\b0xide_voice\b'; then
        ox_warn "the noise-suppressed microphone did not appear in PipeWire; see journalctl --user -u pipewire"
        failed voice
        return 0
    fi
    # Said, so it can be chosen again: this changes which microphone every
    # application records from.
    previous="$(pactl get-default-source 2>/dev/null)"
    [ "$previous" = 0xide_voice ] && { ox_log "default microphone: noise suppressed (already)"; return 0; }
    if err="$(pactl set-default-source 0xide_voice 2>&1)"; then
        ox_log "default microphone: noise suppressed (it was ${previous:-unknown}; pactl set-default-source ${previous:-<name>} goes back)"
    else
        ox_warn "the noise-suppressed microphone is there, but could not be made the default: ${err:-pactl failed}"
        failed voice
    fi
}
main() {
    # The list is read on its own descriptor: a component that asks before
    # installing (sudoers, sddm) reads its answer from stdin, which must stay
    # the terminal, not the next line of this list.
    while IFS= read -r -u 3 line; do
        name="$(field "$line" 1)"; kind="$(field "$line" 2)"; default="$(field "$line" 3)"
        selected "$name" "$default" || continue

        case "$kind" in
            overrides) ox_step "$name  [user configuration]" ;;
            shell)     ox_step "$name  [builds from source, installs to \$XDG_CONFIG_HOME and \$XDG_DATA_HOME]" ;;
            adapter)   ox_step "$name  [theme adapter$( [ "$(ox_pin "$OX_ROOT/adapters/$name/adapter.conf" privileges)" = root ] && printf ', needs a sudoers rule to take effect')]" ;;
            system)    ox_step "$name  [SYSTEM, needs root, will ask first]" ;;
        esac

        case "$kind:$name" in
            overrides:overrides) install_overrides ;;
            overrides:foot)
                overlay foot "$OX_ROOT/overrides/foot/overlay.conf" "$XDG_CONFIG_HOME/foot/foot.ini" --ini ;;
            overrides:starship)
                overlay starship "$OX_ROOT/overrides/starship/overlay.toml" "$XDG_CONFIG_HOME/starship.toml" --toml ;;
            overrides:zed)
                overlay zed "$OX_ROOT/overrides/zed/overlay.jsonc" "$XDG_CONFIG_HOME/zed/settings.json" --jsonc ;;
            overrides:voice) install_voice ;;
            overrides:firefox)
                run "$OX_ROOT/overrides/firefox/install" || { [ "$DRY" = 1 ] || failed firefox; } ;;
            shell:*)
                # Unlike an adapter, a shell that did not build is not a skip:
                # stop here, with its error the last thing on screen, so it is
                # neither buried under later components nor followed by "Done".
                if [ "$DRY" = 1 ]; then
                    run "$OX_ROOT/shell/build.sh"
                    ox_log "would hand the running Caelestia shell over to the new one"
                    continue
                fi
                # Which shell is running is read before the deploy: once the
                # user's copy exists, the name caelestia means that copy, not
                # the system one that may still be running.
                before="$("$OX_ROOT/installer/shell-handoff" capture)" ||
                    ox_die "could not tell which Caelestia shell is running, so nothing was built; see qs list --all"
                "$OX_ROOT/shell/build.sh" ||
                    ox_die "the shell was not installed (shell/build.sh exited $?); nothing after it ran. Fix the error above, then run ./install --only shell"
                # The launcher lists desktop entries, so the shortcuts overlay
                # can be found there without knowing its key.
                if ox_install_file "$XDG_DATA_HOME/applications/0xide-shortcuts.desktop" 644 \
                    < "$OX_ROOT/shell/extensions/shortcuts/0xide-shortcuts.desktop"; then
                    ox_log "launcher entry: Keyboard Shortcuts"
                fi
                ox_own "$XDG_DATA_HOME/applications/0xide-shortcuts.desktop"
                "$OX_ROOT/installer/shell-handoff" handoff "$before" || {
                    rc=$?
                    printf '  error: the shell is installed, but the running shell was not handed over to it (see above); nothing after it ran\n' >&2
                    exit "$rc"
                } ;;
            adapter:*)
                missing="$(adapter_missing "$name")"
                if [ -n "$missing" ]; then
                    ox_log "skipped: needs $missing"
                    continue
                fi
                # An adapter whose setup failed is not enabled.
                if [ -x "$OX_ROOT/adapters/$name/install" ] && ! run "$OX_ROOT/adapters/$name/install" &&
                    [ "$DRY" != 1 ]; then
                    failed "$name"
                    continue
                fi
                [ -x "$OX_ROOT/adapters/$name/apply" ] && enable_adapter "$name"
                : ;;
            system:*)
                # A dry run prints the component's exact privileged changes and
                # checks its rule, then stops before any of them.
                if [ "$DRY" = 1 ]; then OX_DRY_RUN=1 "$OX_ROOT/system/$name/install" || failed "$name"
                else "$OX_ROOT/system/$name/install" || failed "$name"; fi ;;
        esac
    done 3< <(components)

    ox_step "Optional dependencies"
    "$OX_ROOT/installer/check_deps.sh" | grep -E '^\s+(MISSING|absent)' || ox_log "all present"

    if [ ${#FAILED[@]} -gt 0 ]; then
        ox_step "Not done"
        ox_log "these did not take effect: ${FAILED[*]} (see the messages under each above)"
        ox_log "fix them, then run ./install --only <name> for each"
        exit 1
    fi
    ox_step "Done"
    ox_log "check it with: ./install --status"
}

main
